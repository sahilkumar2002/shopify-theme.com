{% comment %}
  Renders a luxury floating sticky add-to-cart bar on mobile devices (Jaipur Rugs style)
{% endcomment %}

<style>
  .luxury-sticky-mobile-cart {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 99;
    background: rgba(255, 255, 255, 0.98);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-top: 1px solid var(--luxury-border, #E8E2D8);
    box-shadow: 0 -4px 18px rgba(0, 0, 0, 0.08);
    padding: 0.75rem 1rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    transform: translateY(110%);
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .luxury-sticky-mobile-cart.is-active {
    transform: translateY(0);
  }

  @media screen and (min-width: 750px) {
    .luxury-sticky-mobile-cart {
      display: none !important;
    }
  }

  .luxury-sticky-mobile-cart__info {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    overflow: hidden;
  }

  .luxury-sticky-mobile-cart__thumb {
    width: 44px;
    height: 44px;
    border-radius: var(--luxury-radius-xs, 1px);
    overflow: hidden;
    background: #F4EFEA;
    flex-shrink: 0;
  }

  .luxury-sticky-mobile-cart__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .luxury-sticky-mobile-cart__details {
    overflow: hidden;
  }

  .luxury-sticky-mobile-cart__title {
    font-family: var(--luxury-font-heading);
    font-size: 0.95rem;
    font-weight: 500;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    margin: 0;
    color: var(--luxury-text);
  }

  .luxury-sticky-mobile-cart__price {
    font-family: var(--luxury-font-body);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--luxury-text);
  }

  .luxury-sticky-mobile-cart__btn {
    flex-shrink: 0;
    background-color: var(--luxury-text, #1E1E1E);
    color: #FFFFFF !important;
    border: none;
    padding: 0.75rem 1.4rem;
    font-family: var(--luxury-font-body);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    border-radius: var(--luxury-radius-xs);
    cursor: pointer;
  }
</style>

<div class="luxury-sticky-mobile-cart" id="LuxuryStickyMobileCart">
  <div class="luxury-sticky-mobile-cart__info">
    {%- if product.featured_media != blank -%}
      <div class="luxury-sticky-mobile-cart__thumb">
        {{ product.featured_media | image_url: width: 120 | image_tag: alt: product.title }}
      </div>
    {%- endif -%}
    <div class="luxury-sticky-mobile-cart__details">
      <div class="luxury-sticky-mobile-cart__title">{{ product.title | escape }}</div>
      <div class="luxury-sticky-mobile-cart__price" id="StickyCartPrice">{{ product.selected_or_first_available_variant.price | money }}</div>
    </div>
  </div>

  <button
    type="button"
    class="luxury-sticky-mobile-cart__btn"
    id="StickyMobileAddToCartBtn"
    {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %}
  >
    {%- if product.selected_or_first_available_variant.available -%}
      Add to Cart
    {%- else -%}
      Sold Out
    {%- endif -%}
  </button>
</div>

<script>
  (function () {
    var stickyBar = document.getElementById('LuxuryStickyMobileCart');
    if (!stickyBar) return;

    var mainBuyBtn = document.querySelector('.product-form__submit, product-form button[type="submit"]');

    function checkScroll() {
      if (!mainBuyBtn) {
        if (window.scrollY > 400) stickyBar.classList.add('is-active');
        else stickyBar.classList.remove('is-active');
        return;
      }
      var rect = mainBuyBtn.getBoundingClientRect();
      if (rect.bottom < 0) {
        stickyBar.classList.add('is-active');
      } else {
        stickyBar.classList.remove('is-active');
      }
    }

    window.addEventListener('scroll', checkScroll, { passive: true });

    var stickyBtn = document.getElementById('StickyMobileAddToCartBtn');
    if (stickyBtn && mainBuyBtn) {
      stickyBtn.addEventListener('click', function () {
        mainBuyBtn.click();
      });
    }
  })();
</script>
