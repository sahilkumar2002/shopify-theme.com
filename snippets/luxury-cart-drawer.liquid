{% comment %}
  Renders luxury editorial slide-in cart drawer from the right.
  Connected with Ajax Cart API in assets/cart-drawer.js.
{% endcomment %}

<div
  class="luxury-cart-drawer"
  id="LuxuryCartDrawer"
  role="dialog"
  aria-modal="true"
  aria-label="Sanctuary Cart"
  data-shipping-threshold="{{ settings.free_shipping_threshold | default: 500 }}"
>
  <div class="luxury-cart-drawer__header">
    <div style="display: flex; align-items: baseline; gap: 0.6rem;">
      <h2 class="luxury-cart-drawer__title">Your Sanctuary Bag</h2>
      <span class="luxury-header__badge luxury-cart-count-badge" style="position: static; font-size: 0.72rem;">{{ cart.item_count }}</span>
    </div>
    <button type="button" class="luxury-cart-drawer__close" id="LuxuryCartCloseBtn" aria-label="Close cart">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
    </button>
  </div>

  <!-- Dynamic Free Shipping Threshold Meter -->
  <div class="luxury-shipping-bar" id="LuxuryShippingBar">
    <div class="luxury-shipping-bar__message">
      {%- assign threshold_cents = settings.free_shipping_threshold | default: 500 | times: 100 -%}
      {%- if cart.total_price >= threshold_cents -%}
        🎉 <strong>Complimentary White-Glove Delivery Unlocked!</strong>
      {%- else -%}
        {%- assign remaining_cents = threshold_cents | minus: cart.total_price -%}
        Add <strong>{{ remaining_cents | money }}</strong> more to unlock complimentary global delivery
      {%- endif -%}
    </div>
    <div class="luxury-shipping-bar__progress-track">
      {%- assign pct = cart.total_price | times: 100.0 | divided_by: threshold_cents | at_most: 100 -%}
      <div class="luxury-shipping-bar__progress-fill" style="width: {{ pct }}%;"></div>
    </div>
  </div>

  <!-- Cart Line Items -->
  <div class="luxury-cart-drawer__items" id="LuxuryCartItems">
    {%- if cart.item_count == 0 -%}
      <div class="luxury-drawer-empty">
        <svg class="luxury-drawer-empty__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path><line x1="3" y1="6" x2="21" y2="6"></line><path d="M16 10a4 4 0 0 1-8 0"></path></svg>
        <h3 class="luxury-drawer-empty__title">Your Sanctuary Is Empty</h3>
        <p class="luxury-drawer-empty__text">Discover museum-quality rugs tied knot by knot by master Indian weavers.</p>
        <a href="/collections/all" class="luxury-account-dropdown__btn" style="padding: 0.9rem 2rem; margin-top: 1rem;" onclick="window.closeLuxuryCart();">Explore Collections</a>
      </div>
    {%- else -%}
      {%- for item in cart.items -%}
        <div class="luxury-cart-item" data-line="{{ forloop.index }}">
          <div class="luxury-cart-item__media">
            {%- if item.image -%}
              {{ item.image | image_url: width: 240 | image_tag: loading: 'lazy', alt: item.title }}
            {%- endif -%}
          </div>
          <div class="luxury-cart-item__details">
            <a href="{{ item.url }}" class="luxury-cart-item__title">{{ item.product.title }}</a>
            {%- unless item.product.has_only_default_variant -%}
              <span class="luxury-cart-item__variant">{{ item.variant.title }}</span>
            {%- endunless -%}
            <span class="luxury-cart-item__price">{{ item.final_line_price | money }}</span>
            <div class="luxury-cart-item__qty">
              <button type="button" class="luxury-cart-item__qty-btn" onclick="window.changeCartQty({{ forloop.index }}, {{ item.quantity | minus: 1 }})">&minus;</button>
              <input type="text" class="luxury-cart-item__qty-input" value="{{ item.quantity }}" readonly aria-label="Quantity">
              <button type="button" class="luxury-cart-item__qty-btn" onclick="window.changeCartQty({{ forloop.index }}, {{ item.quantity | plus: 1 }})">&plus;</button>
            </div>
          </div>
          <button type="button" class="luxury-cart-item__remove" aria-label="Remove {{ item.title }}" onclick="window.changeCartQty({{ forloop.index }}, 0)">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
          </button>
        </div>
      {%- endfor -%}
    {%- endif -%}
  </div>

  <!-- Cart Footer -->
  <div class="luxury-cart-drawer__footer" id="LuxuryCartFooter" {% if cart.item_count == 0 %}style="display: none;"{% endif %}>
    <div class="luxury-cart-drawer__subtotal-row">
      <span class="luxury-cart-drawer__subtotal-label">Subtotal</span>
      <span class="luxury-cart-drawer__subtotal-amount" id="LuxuryCartSubtotal">{{ cart.total_price | money }}</span>
    </div>
    <div class="luxury-cart-drawer__taxes-notice">
      Taxes and customs duties calculated at checkout.
    </div>
    <form action="{{ routes.cart_url }}" method="post" id="LuxuryCartDrawerForm">
      <button type="submit" name="checkout" class="luxury-cart-drawer__checkout-btn button-shine">
        Proceed to Checkout &rarr;
      </button>
      <a href="{{ routes.cart_url }}" class="luxury-cart-drawer__view-cart">
        View Full Bag
      </a>
    </form>
  </div>
</div>
