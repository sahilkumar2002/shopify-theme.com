<section class="luxury-about-values luxury-section-padding">
  <div class="luxury-container">
    <div class="luxury-about-values__header" data-aos="fade-up">
      <span class="editorial-eyebrow">{{ section.settings.eyebrow | default: 'Guiding Principles' }}</span>
      <h2 class="editorial-heading" style="font-size: clamp(2.2rem, 4vw, 3.5rem);">
        {{ section.settings.heading | default: 'Pillars of Our Sanctuary' }}
      </h2>
      <p class="editorial-subtext" style="margin: 0 auto;">
        {{ section.settings.subtext | default: 'We operate at the rare intersection of uncompromising ancestral artistry, conscious ecology, and direct artisan equity.' }}
      </p>
    </div>

    <div class="luxury-about-values__grid">
      {%- for block in section.blocks -%}
        <div class="luxury-about-values__card" data-aos="fade-up" data-aos-delay="{{ forloop.index0 | times: 120 }}" {{ block.shopify_attributes }}>
          <div class="luxury-about-values__icon-wrap">
            {%- case block.settings.icon -%}
              {%- when 'handmade' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 2a10 10 0 1 0 10 10A10 10 0 0 0 12 2zm1 14.5a1.5 1.5 0 1 1-3 0V11a1.5 1.5 0 0 1 3 0zm-1.5-8a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3z"/></svg>
              {%- when 'sustainable' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
              {%- when 'fairtrade' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
              {%- else -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
            {%- endcase -%}
          </div>
          <h3 class="luxury-about-values__card-title">{{ block.settings.title }}</h3>
          <p class="luxury-about-values__card-text">{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

<style>
  .luxury-about-values {
    background-color: #FFFFFF;
    border-top: 1px solid var(--luxury-border-light, #EFEAE3);
    border-bottom: 1px solid var(--luxury-border-light, #EFEAE3);
  }
  .luxury-about-values__header {
    text-align: center;
    max-width: 760px;
    margin: 0 auto 4rem;
  }
  .luxury-about-values__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
  }
  .luxury-about-values__card {
    background: var(--luxury-bg, #FBF9F5);
    padding: 3rem 2rem;
    border-radius: var(--luxury-radius-sm, 2px);
    border: 1px solid var(--luxury-border-light, #EFEAE3);
    text-align: center;
    transition: transform 0.4s ease, box-shadow 0.4s ease;
  }
  .luxury-about-values__card:hover {
    transform: translateY(-6px);
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.06);
  }
  .luxury-about-values__icon-wrap {
    width: 60px;
    height: 60px;
    margin: 0 auto 1.6rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: #FFFFFF;
    color: var(--luxury-accent, #9E583A);
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.05);
  }
  .luxury-about-values__icon-wrap svg {
    width: 28px;
    height: 28px;
  }
  .luxury-about-values__card-title {
    font-family: var(--luxury-font-heading, 'Cormorant Garamond', Georgia, serif);
    font-size: 1.55rem;
    color: var(--luxury-text, #1E1E1E);
    margin: 0 0 0.85rem;
    font-weight: 500;
  }
  .luxury-about-values__card-text {
    font-family: var(--luxury-font-body, 'Jost', sans-serif);
    font-size: 0.92rem;
    color: var(--luxury-text-muted, #6E6862);
    line-height: 1.7;
    margin: 0;
  }
  @media (max-width: 1024px) {
    .luxury-about-values__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 600px) {
    .luxury-about-values__grid {
      grid-template-columns: 1fr;
    }
  }
</style>

{% schema %}
{
  "name": "About — Core Values",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Guiding Principles"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Pillars of Our Sanctuary"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "We operate at the rare intersection of uncompromising ancestral artistry, conscious ecology, and direct artisan equity."
    }
  ],
  "blocks": [
    {
      "type": "value",
      "name": "Value Card",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "handmade", "label": "Handmade Heirloom" },
            { "value": "sustainable", "label": "Ecology & Sustainability" },
            { "value": "fairtrade", "label": "Artisan Dignity & Fair Trade" },
            { "value": "custom", "label": "Bespoke Made-to-Order" }
          ],
          "default": "handmade"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Card Title",
          "default": "100% Handcrafted"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "default": "Every single knot is hand-tied on traditional timber looms without industrial automation."
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      {
        "type": "value",
        "settings": {
          "icon": "handmade",
          "title": "100% Hand-Tied",
          "text": "Every knot is tied by artisan hands on traditional timber looms, taking up to 9 months per piece."
        }
      },
      {
        "type": "value",
        "settings": {
          "icon": "sustainable",
          "title": "Pure Organic Fibers",
          "text": "Spun using unadulterated highland New Zealand wool, organic mulberry silk, and cruelty-free botanic dyes."
        }
      },
      {
        "type": "value",
        "settings": {
          "icon": "fairtrade",
          "title": "Artisan Equity",
          "text": "Direct doorstep compensation, healthcare, and education for weavers and their children across 600 villages."
        }
      },
      {
        "type": "value",
        "settings": {
          "icon": "custom",
          "title": "Bespoke Architectural",
          "text": "Any dimension, hue, or motif tailored to your exact architectural floor plan with zero minimums."
        }
      }
    ]
  }
}
{% endschema %}
