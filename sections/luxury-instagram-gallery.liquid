{%- style -%}
  #LuxuryInstagram-{{ section.id }} {
    padding-top: {{ section.settings.padding_top | default: 80 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 80 }}px;
    background-color: {{ section.settings.background_color | default: '#FBF9F5' }};
    overflow: hidden;
  }

  .luxury-instagram__header {
    text-align: center;
    max-width: 680px;
    margin: 0 auto clamp(2.5rem, 5vw, 4rem);
  }

  .luxury-instagram__eyebrow {
    font-family: var(--luxury-font-body, 'Jost', sans-serif);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--luxury-accent, #9E583A);
    margin-bottom: 0.8rem;
    display: block;
  }

  .luxury-instagram__heading {
    font-family: var(--luxury-font-heading, 'Cormorant Garamond', serif);
    font-size: clamp(2rem, 3.8vw, 3.2rem);
    font-weight: 400;
    letter-spacing: -0.01em;
    color: var(--luxury-text, #1E1E1E);
    margin: 0 0 0.8rem;
  }

  .luxury-instagram__handle {
    font-family: var(--luxury-font-body, 'Jost', sans-serif);
    font-size: 0.95rem;
    letter-spacing: 0.08em;
    color: var(--luxury-text-muted, #6E6862);
    display: inline-block;
    text-decoration: none;
    transition: color 0.3s ease;
  }

  .luxury-instagram__handle:hover {
    color: var(--luxury-accent, #9E583A);
  }

  /* 6 Column Desktop / 3 Column Mobile Grid */
  .luxury-instagram__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.75rem;
  }

  @media screen and (min-width: 750px) {
    .luxury-instagram__grid {
      grid-template-columns: repeat(6, 1fr);
      gap: 1.2rem;
    }
  }

  .luxury-instagram-item {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background-color: #EFE9E0;
    border-radius: var(--luxury-radius-sm, 2px);
    display: block;
    text-decoration: none;
    color: #FFFFFF;
  }

  .luxury-instagram-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.85s cubic-bezier(0.25, 1, 0.35, 1);
  }

  .luxury-instagram-item:hover img {
    transform: scale(1.1);
  }

  .luxury-instagram-item__overlay {
    position: absolute;
    inset: 0;
    background: rgba(28, 27, 26, 0.65);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    opacity: 0;
    transition: opacity 0.35s var(--luxury-ease);
    padding: 1rem;
    text-align: center;
  }

  .luxury-instagram-item:hover .luxury-instagram-item__overlay {
    opacity: 1;
  }

  .luxury-instagram-item__icon {
    width: 26px;
    height: 26px;
    fill: currentColor;
    transform: scale(0.8);
    transition: transform 0.35s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }

  .luxury-instagram-item:hover .luxury-instagram-item__icon {
    transform: scale(1);
  }

  .luxury-instagram-item__tag {
    font-family: var(--luxury-font-body);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #FFFFFF;
  }
{%- endstyle -%}

<div class="luxury-instagram-section" id="LuxuryInstagram-{{ section.id }}">
  <div class="luxury-container">
    {%- if section.settings.heading != blank or section.settings.handle != blank -%}
      <div class="luxury-instagram__header" data-aos="fade-up">
        {%- if section.settings.eyebrow != blank -%}
          <span class="luxury-instagram__eyebrow">{{ section.settings.eyebrow | escape }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="luxury-instagram__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.handle != blank -%}
          <a href="{{ section.settings.instagram_url | default: 'https://instagram.com' }}" target="_blank" rel="noopener noreferrer" class="luxury-instagram__handle underline-slide">
            {{ section.settings.handle | escape }}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="luxury-instagram__grid">
      {%- for block in section.blocks -%}
        {%- assign stagger_delay = forloop.index0 | times: 100 -%}
        <a
          href="{{ block.settings.link | default: section.settings.instagram_url | default: '#' }}"
          class="luxury-instagram-item hover-zoom-container"
          data-aos="zoom-in"
          data-aos-delay="{{ stagger_delay }}"
          {{ block.shopify_attributes }}
        >
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 600 | image_tag:
              loading: 'lazy',
              widths: '300, 450, 600',
              alt: block.settings.caption | default: 'Artisanal Rug Lifestyle'
            }}
          {%- else -%}
            {%- assign placeholder_index = forloop.index | modulo: 6 | plus: 1 -%}
            {{ 'lifestyle-' | append: placeholder_index | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}

          <div class="luxury-instagram-item__overlay">
            <svg class="luxury-instagram-item__icon" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
            <span class="luxury-instagram-item__tag">Shop The Look</span>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Instagram Gallery (Jaipur)",
  "tag": "section",
  "class": "section-luxury-instagram",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "Living With Art"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Styled by You"
    },
    {
      "type": "text",
      "id": "handle",
      "label": "Instagram Handle",
      "default": "@indianrugstore / #HandcraftedSanctuary"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram Profile Link"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section Background",
      "default": "#FBF9F5"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 40,
      "max": 140,
      "step": 10,
      "unit": "px",
      "label": "Padding Top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 40,
      "max": 140,
      "step": 10,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "gallery_image",
      "name": "Lifestyle Square Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Square Image (1:1 aspect ratio)"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Hover Caption",
          "default": "Living room inspiration"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Product or Post Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Instagram Gallery (Jaipur)",
      "blocks": [
        { "type": "gallery_image" },
        { "type": "gallery_image" },
        { "type": "gallery_image" },
        { "type": "gallery_image" },
        { "type": "gallery_image" },
        { "type": "gallery_image" }
      ]
    }
  ]
}
{% endschema %}