{%- style -%}
  #LuxuryCategories-{{ section.id }} {
    padding-top: {{ section.settings.padding_top | default: 80 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 80 }}px;
    background-color: {{ section.settings.background_color | default: '#FBF9F5' }};
  }

  .luxury-categories__header {
    text-align: center;
    max-width: 720px;
    margin: 0 auto clamp(2.5rem, 5vw, 4.5rem);
  }

  .luxury-categories__eyebrow {
    font-family: var(--luxury-font-body, 'Jost', sans-serif);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--luxury-accent, #9E583A);
    margin-bottom: 0.8rem;
    display: block;
  }

  .luxury-categories__heading {
    font-family: var(--luxury-font-heading, 'Cormorant Garamond', serif);
    font-size: clamp(2.2rem, 4vw, 3.6rem);
    font-weight: 400;
    letter-spacing: -0.01em;
    color: var(--luxury-text, #1E1E1E);
    margin: 0 0 1rem;
    line-height: 1.15;
  }

  .luxury-categories__subtext {
    font-family: var(--luxury-font-body, 'Jost', sans-serif);
    font-size: 1rem;
    color: var(--luxury-text-muted, #6E6862);
    line-height: 1.6;
    margin: 0 auto;
  }

  .luxury-categories__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }

  @media screen and (min-width: 990px) {
    .luxury-categories__grid {
      grid-template-columns: repeat({{ section.settings.columns_desktop | default: 4 }}, 1fr);
      gap: 2rem;
    }
  }

  .luxury-category-card {
    position: relative;
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    group: card;
  }

  .luxury-category-card__media {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background-color: #EBE5DE;
    border-radius: var(--luxury-radius-sm, 2px);
  }

  .luxury-category-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.85s cubic-bezier(0.25, 1, 0.35, 1);
  }

  .luxury-category-card:hover .luxury-category-card__media img {
    transform: scale(1.08);
  }

  .luxury-category-card__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(0, 0, 0, 0) 50%,
      rgba(0, 0, 0, 0.45) 100%
    );
    opacity: 0.8;
    transition: opacity 0.4s ease;
  }

  .luxury-category-card:hover .luxury-category-card__overlay {
    opacity: 1;
  }

  .luxury-category-card__content {
    margin-top: 1.2rem;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
  }

  .luxury-category-card__title {
    font-family: var(--luxury-font-heading, 'Cormorant Garamond', serif);
    font-size: clamp(1.2rem, 1.8vw, 1.55rem);
    font-weight: 500;
    color: var(--luxury-text, #1E1E1E);
    margin: 0;
    line-height: 1.2;
    transition: color 0.3s ease;
  }

  .luxury-category-card:hover .luxury-category-card__title {
    color: var(--luxury-accent, #9E583A);
  }

  .luxury-category-card__subtitle {
    font-family: var(--luxury-font-body, 'Jost', sans-serif);
    font-size: 0.78rem;
    color: var(--luxury-text-muted, #6E6862);
    letter-spacing: 0.05em;
    margin-top: 0.25rem;
  }

  .luxury-category-card__explore {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--luxury-font-body);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--luxury-accent, #9E583A);
    opacity: 0;
    transform: translateX(-8px);
    transition: all 0.35s var(--luxury-ease);
  }

  .luxury-category-card:hover .luxury-category-card__explore {
    opacity: 1;
    transform: translateX(0);
  }

  @media screen and (max-width: 749px) {
    .luxury-category-card__explore {
      opacity: 1;
      transform: none;
      font-size: 0.7rem;
    }
  }
{%- endstyle -%}

<div class="luxury-categories-section" id="LuxuryCategories-{{ section.id }}">
  <div class="luxury-container">
    {%- if section.settings.heading != blank or section.settings.eyebrow != blank -%}
      <div class="luxury-categories__header" data-aos="fade-up">
        {%- if section.settings.eyebrow != blank -%}
          <span class="luxury-categories__eyebrow">{{ section.settings.eyebrow | escape }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="luxury-categories__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.subtext != blank -%}
          <p class="luxury-categories__subtext">{{ section.settings.subtext }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="luxury-categories__grid">
      {%- for block in section.blocks -%}
        {%- assign stagger_delay = forloop.index0 | times: 100 -%}
        <a
          href="{{ block.settings.link | default: '#' }}"
          class="luxury-category-card"
          data-aos="fade-up"
          data-aos-delay="{{ stagger_delay }}"
          {{ block.shopify_attributes }}
        >
          <div class="luxury-category-card__media hover-zoom-container">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 800 | image_tag:
                loading: 'lazy',
                widths: '350, 500, 750, 900',
                alt: block.settings.title | escape
              }}
            {%- else -%}
              {%- assign placeholder_index = forloop.index | modulo: 6 | plus: 1 -%}
              {{ 'collection-' | append: placeholder_index | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
            <div class="luxury-category-card__overlay"></div>
          </div>

          <div class="luxury-category-card__content">
            <div>
              <h3 class="luxury-category-card__title">{{ block.settings.title | escape }}</h3>
              {%- if block.settings.subtitle != blank -%}
                <div class="luxury-category-card__subtitle">{{ block.settings.subtitle | escape }}</div>
              {%- endif -%}
            </div>
            <div class="luxury-category-card__explore">
              <span>Explore</span>
              <span aria-hidden="true">&rarr;</span>
            </div>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Shop by Category (Jaipur)",
  "tag": "section",
  "class": "section-luxury-categories",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "Curated Collections"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by Category"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Handcrafted for every living space with centuries of heritage weaving technique."
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 3,
      "max": 5,
      "step": 1,
      "label": "Desktop Columns",
      "default": 4
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section Background",
      "default": "#FBF9F5"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 40,
      "max": 140,
      "step": 10,
      "unit": "px",
      "label": "Padding Top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 40,
      "max": 140,
      "step": 10,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "category_card",
      "name": "Category Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Category Image (4:5 ratio recommended)"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Category Title",
          "default": "Hand-Knotted Rugs"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle / Details",
          "default": "1,200+ Designs"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Category URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop by Category (Jaipur)",
      "blocks": [
        {
          "type": "category_card",
          "settings": {
            "title": "Hand-Knotted",
            "subtitle": "Timeless heirloom pieces"
          }
        },
        {
          "type": "category_card",
          "settings": {
            "title": "Hand-Tufted",
            "subtitle": "Plush comfort & textures"
          }
        },
        {
          "type": "category_card",
          "settings": {
            "title": "Flatweaves & Dhurries",
            "subtitle": "Reversible versatile wool"
          }
        },
        {
          "type": "category_card",
          "settings": {
            "title": "Silk & Botanical",
            "subtitle": "Lustrous artisanal sheen"
          }
        }
      ]
    }
  ]
}
{% endschema %}