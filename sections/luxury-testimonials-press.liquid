{%- style -%}
  #LuxuryTestimonialsPress-{{ section.id }} {
    padding-top: {{ section.settings.padding_top | default: 90 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 90 }}px;
    background-color: {{ section.settings.background_color | default: '#FFFFFF' }};
    overflow: hidden;
  }

  .luxury-testimonials__header {
    text-align: center;
    max-width: 700px;
    margin: 0 auto clamp(2.5rem, 5vw, 4rem);
  }

  .luxury-testimonials__eyebrow {
    font-family: var(--luxury-font-body, 'Jost', sans-serif);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--luxury-accent, #9E583A);
    margin-bottom: 0.8rem;
    display: block;
  }

  .luxury-testimonials__heading {
    font-family: var(--luxury-font-heading, 'Cormorant Garamond', serif);
    font-size: clamp(2.2rem, 4vw, 3.6rem);
    font-weight: 400;
    letter-spacing: -0.01em;
    color: var(--luxury-text, #1E1E1E);
    margin: 0 0 1rem;
  }

  /* Testimonial Rotator */
  .luxury-testimonials__slider-wrapper {
    position: relative;
    max-width: 920px;
    margin: 0 auto clamp(3.5rem, 7vw, 6rem);
    min-height: 320px;
  }

  .luxury-testimonial-card {
    position: absolute;
    inset: 0;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.7s cubic-bezier(0.25, 1, 0.5, 1), transform 0.7s cubic-bezier(0.25, 1, 0.5, 1);
    transform: translateY(15px);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    pointer-events: none;
  }

  .luxury-testimonial-card.is-active {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
    pointer-events: auto;
    position: relative;
  }

  .luxury-testimonial-card__quote-icon {
    width: 38px;
    height: 38px;
    color: var(--luxury-accent, #9E583A);
    margin-bottom: 1.2rem;
    opacity: 0.8;
  }

  .luxury-testimonial-card__stars {
    display: flex;
    gap: 0.3rem;
    color: var(--luxury-gold, #C2A26F);
    margin-bottom: 1.5rem;
  }

  .luxury-testimonial-card__stars svg {
    width: 16px;
    height: 16px;
    fill: currentColor;
  }

  .luxury-testimonial-card__text {
    font-family: var(--luxury-font-heading, 'Cormorant Garamond', serif);
    font-size: clamp(1.4rem, 2.5vw, 2.1rem);
    font-style: italic;
    font-weight: 400;
    line-height: 1.45;
    color: var(--luxury-text, #1E1E1E);
    margin: 0 0 2rem;
  }

  .luxury-testimonial-card__client {
    display: flex;
    align-items: center;
    gap: 1.2rem;
  }

  .luxury-testimonial-card__thumbnail {
    width: 54px;
    height: 54px;
    border-radius: 50%;
    overflow: hidden;
    background: #F4EFEA;
    border: 2px solid #FFFFFF;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
    flex-shrink: 0;
  }

  .luxury-testimonial-card__thumbnail img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .luxury-testimonial-card__info {
    text-align: left;
  }

  .luxury-testimonial-card__author {
    font-family: var(--luxury-font-body, 'Jost', sans-serif);
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--luxury-text, #1E1E1E);
    margin: 0;
  }

  .luxury-testimonial-card__rug-title {
    font-family: var(--luxury-font-body);
    font-size: 0.78rem;
    color: var(--luxury-text-muted, #6E6862);
    letter-spacing: 0.04em;
  }

  .luxury-testimonial-card__rug-title a {
    color: var(--luxury-accent, #9E583A);
    text-decoration: none;
  }

  /* Dots */
  .luxury-testimonials__dots {
    display: flex;
    justify-content: center;
    gap: 0.7rem;
    margin-top: 2rem;
  }

  .luxury-testimonials__dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--luxury-border, #E8E2D8);
    border: none;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .luxury-testimonials__dot.is-active {
    background: var(--luxury-accent, #9E583A);
    transform: scale(1.3);
  }

  /* Press Logo Marquee */
  .luxury-press-section {
    padding-top: 3.5rem;
    border-top: 1px solid var(--luxury-border-light, #F0ECE4);
    text-align: center;
  }

  .luxury-press-section__title {
    font-family: var(--luxury-font-body);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--luxury-text-muted, #6E6862);
    margin-bottom: 2.5rem;
  }

  .luxury-press-marquee-item {
    display: flex;
    align-items: center;
    justify-content: center;
    filter: grayscale(100%);
    opacity: 0.5;
    transition: filter 0.4s ease, opacity 0.4s ease, transform 0.4s ease;
    padding: 0 1.5rem;
  }

  .luxury-press-marquee-item:hover {
    filter: grayscale(0%);
    opacity: 1;
    transform: scale(1.08);
  }

  .luxury-press-marquee-item img {
    max-height: 38px;
    width: auto;
    object-fit: contain;
  }

  .luxury-press-marquee-item span {
    font-family: var(--luxury-font-heading);
    font-size: 1.5rem;
    letter-spacing: 0.05em;
    color: var(--luxury-text);
  }
{%- endstyle -%}

<div class="luxury-testimonials-press-section" id="LuxuryTestimonialsPress-{{ section.id }}">
  <div class="luxury-container">
    {%- if section.settings.heading != blank or section.settings.eyebrow != blank -%}
      <div class="luxury-testimonials__header" data-aos="fade-up">
        {%- if section.settings.eyebrow != blank -%}
          <span class="luxury-testimonials__eyebrow">{{ section.settings.eyebrow | escape }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="luxury-testimonials__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
      </div>
    {%- endif -%}

    <!-- Testimonials Slider -->
    <div class="luxury-testimonials__slider-wrapper" id="TestimonialSlider-{{ section.id }}" data-aos="fade-up">
      {%- assign testimonial_count = 0 -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'testimonial' -%}
          {%- assign testimonial_count = testimonial_count | plus: 1 -%}
          <div
            class="luxury-testimonial-card{% if testimonial_count == 1 %} is-active{% endif %}"
            data-index="{{ testimonial_count | minus: 1 }}"
            {{ block.shopify_attributes }}
          >
            <div class="luxury-testimonial-card__quote-icon">
              <svg viewBox="0 0 24 24" fill="currentColor">
                <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/>
              </svg>
            </div>

            <div class="luxury-testimonial-card__stars">
              {%- for star in (1..5) -%}
                <svg viewBox="0 0 24 24">
                  <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/>
                </svg>
              {%- endfor -%}
            </div>

            <blockquote class="luxury-testimonial-card__text">
              &ldquo;{{ block.settings.quote | escape }}&rdquo;
            </blockquote>

            <div class="luxury-testimonial-card__client">
              {%- if block.settings.rug_thumbnail != blank -%}
                <div class="luxury-testimonial-card__thumbnail">
                  {{ block.settings.rug_thumbnail | image_url: width: 150 | image_tag: alt: block.settings.author_name }}
                </div>
              {%- endif -%}
              <div class="luxury-testimonial-card__info">
                <div class="luxury-testimonial-card__author">{{ block.settings.author_name | escape }}</div>
                {%- if block.settings.product_title != blank -%}
                  <div class="luxury-testimonial-card__rug-title">
                    Purchased <a href="{{ block.settings.product_link | default: '#' }}">{{ block.settings.product_title | escape }}</a>
                  </div>
                {%- endif -%}
              </div>
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}

      {%- if testimonial_count > 1 -%}
        <div class="luxury-testimonials__dots">
          {%- for i in (1..testimonial_count) -%}
            <button
              class="luxury-testimonials__dot{% if forloop.first %} is-active{% endif %}"
              type="button"
              aria-label="Testimonial {{ forloop.index }}"
              data-dot-index="{{ forloop.index0 }}"
            ></button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <!-- As Seen In Press Marquee -->
    {%- if section.settings.show_press -%}
      <div class="luxury-press-section" data-aos="fade-up">
        <h3 class="luxury-press-section__title">{{ section.settings.press_title | default: 'As Seen In' }}</h3>

        <div class="luxury-marquee">
          <div class="luxury-marquee__track" style="--marquee-duration: 28s;">
            {%- for block in section.blocks -%}
              {%- if block.type == 'press_logo' -%}
                <div class="luxury-press-marquee-item" {{ block.shopify_attributes }}>
                  {%- if block.settings.logo != blank -%}
                    {{ block.settings.logo | image_url: width: 280 | image_tag: alt: block.settings.publication_name }}
                  {%- else -%}
                    <span>{{ block.settings.publication_name | escape }}</span>
                  {%- endif -%}
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>
          <!-- Duplicate track for seamless infinite marquee loop -->
          <div class="luxury-marquee__track" aria-hidden="true" style="--marquee-duration: 28s;">
            {%- for block in section.blocks -%}
              {%- if block.type == 'press_logo' -%}
                <div class="luxury-press-marquee-item">
                  {%- if block.settings.logo != blank -%}
                    {{ block.settings.logo | image_url: width: 280 | image_tag: alt: block.settings.publication_name }}
                  {%- else -%}
                    <span>{{ block.settings.publication_name | escape }}</span>
                  {%- endif -%}
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>
      </div>
    {%- endif -%}
  </div>
</div>

<script>
  (function () {
    var wrapper = document.getElementById('TestimonialSlider-{{ section.id }}');
    if (!wrapper) return;

    var cards = wrapper.querySelectorAll('.luxury-testimonial-card');
    var dots = wrapper.querySelectorAll('.luxury-testimonials__dot');
    if (cards.length <= 1) return;

    var currentIndex = 0;
    var timer = null;

    function goToTestimonial(idx) {
      cards[currentIndex].classList.remove('is-active');
      if (dots[currentIndex]) dots[currentIndex].classList.remove('is-active');

      currentIndex = idx;

      cards[currentIndex].classList.add('is-active');
      if (dots[currentIndex]) dots[currentIndex].classList.add('is-active');
    }

    function nextTestimonial() {
      var next = (currentIndex + 1) % cards.length;
      goToTestimonial(next);
    }

    function startTimer() {
      if (timer) clearInterval(timer);
      timer = setInterval(nextTestimonial, 5500);
    }

    dots.forEach(function (dot) {
      dot.addEventListener('click', function () {
        var idx = parseInt(this.getAttribute('data-dot-index'), 10);
        goToTestimonial(idx);
        startTimer();
      });
    });

    wrapper.addEventListener('mouseenter', function () {
      if (timer) clearInterval(timer);
    });

    wrapper.addEventListener('mouseleave', function () {
      startTimer();
    });

    startTimer();
  })();
</script>

{% schema %}
{
  "name": "Testimonials & Press",
  "tag": "section",
  "class": "section-luxury-testimonials-press",
  "settings": [
    {
      "type": "text",
