<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css">
<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>

{%- style -%}
  #LuxuryFeaturedProducts-{{ section.id }} {
    padding-top: {{ section.settings.padding_top | default: 80 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 80 }}px;
    background-color: {{ section.settings.background_color | default: '#FFFFFF' }};
    position: relative;
    overflow: hidden;
  }

  .luxury-products__header {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    margin-bottom: clamp(2rem, 5vw, 3.8rem);
  }

  .luxury-products__eyebrow {
    font-family: var(--luxury-font-body, 'Jost', sans-serif);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--luxury-accent, #9E583A);
    margin-bottom: 0.8rem;
    display: block;
  }

  .luxury-products__heading {
    font-family: var(--luxury-font-heading, 'Cormorant Garamond', serif);
    font-size: clamp(2.2rem, 4vw, 3.6rem);
    font-weight: 400;
    color: var(--luxury-text, #1E1E1E);
    margin: 0 0 1rem;
    letter-spacing: -0.01em;
  }

  .luxury-products__subtext {
    font-family: var(--luxury-font-body, 'Jost', sans-serif);
    font-size: 1rem;
    color: var(--luxury-text-muted, #6E6862);
    max-width: 600px;
    line-height: 1.6;
    margin: 0 0 1rem;
  }

  /* Swiper Container & Navigation */
  .luxury-products-swiper-container {
    position: relative;
    padding: 0.5rem 0.5rem 2.5rem;
  }

  .luxury-products__nav-arrow {
    position: absolute;
    top: 40%;
    transform: translateY(-50%);
    width: 48px;
    height: 48px;
    background: #FFFFFF;
    border: 1px solid var(--luxury-border, #E8E2D8);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--luxury-text, #1E1E1E);
    cursor: pointer;
    z-index: 10;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.08);
    transition: all 0.3s var(--luxury-ease);
  }

  .luxury-products__nav-arrow:hover {
    background: var(--luxury-text, #1E1E1E);
    color: #FFFFFF;
    border-color: var(--luxury-text, #1E1E1E);
    transform: translateY(-50%) scale(1.06);
  }

  .luxury-products__nav-arrow--prev {
    left: 0;
  }

  .luxury-products__nav-arrow--next {
    right: 0;
  }

  .luxury-products__nav-arrow.swiper-button-disabled {
    opacity: 0.25;
    cursor: not-allowed;
    pointer-events: none;
  }

  /* Editorial Product Card */
  .luxury-product-card {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    background: #FFFFFF;
    transition: transform 0.4s var(--luxury-ease);
  }

  .luxury-product-card__media-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 5;
    background: #F4EFEA;
    overflow: hidden;
    border-radius: var(--luxury-radius-sm, 2px);
  }

  .luxury-product-card__image-primary,
  .luxury-product-card__image-secondary {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 0.65s cubic-bezier(0.25, 1, 0.5, 1), transform 0.85s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .luxury-product-card__image-secondary {
    opacity: 0;
    z-index: 2;
  }

  .luxury-product-card:hover .luxury-product-card__image-primary {
    transform: scale(1.08);
  }

  .luxury-product-card:hover .luxury-product-card__image-secondary {
    opacity: 1;
    transform: scale(1.08);
  }

  /* Wishlist Button */
  .luxury-product-card__wishlist-btn {
    position: absolute;
    top: 14px;
    right: 14px;
    z-index: 5;
    width: 36px;
    height: 36px;
    background: rgba(255, 255, 255, 0.88);
    backdrop-filter: blur(4px);
    border-radius: 50%;
    border: none;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--luxury-text, #1E1E1E);
    cursor: pointer;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    transition: transform 0.25s ease, background 0.25s ease;
  }

  .luxury-product-card__wishlist-btn:hover {
    background: #FFFFFF;
    transform: scale(1.12);
  }

  .luxury-product-card__wishlist-btn svg {
    width: 18px;
    height: 18px;
    transition: transform 0.3s ease;
  }

  /* Badges */
  .luxury-product-card__badge {
    position: absolute;
    top: 14px;
    left: 14px;
    z-index: 5;
    font-family: var(--luxury-font-body);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 0.35rem 0.75rem;
    border-radius: var(--luxury-radius-xs, 1px);
    background: var(--luxury-accent, #9E583A);
    color: #FFFFFF;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.1);
  }

  .luxury-product-card__badge--bestseller {
    background: #1C1B1A;
    color: #FFFFFF;
  }

  /* Quick-Add Button Slide-up */
  .luxury-product-card__quick-add {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 5;
    transform: translateY(101%);
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .luxury-product-card:hover .luxury-product-card__quick-add {
    transform: translateY(0);
  }

  .luxury-product-card__quick-add-btn {
    width: 100%;
    background: rgba(30, 30, 30, 0.95);
    backdrop-filter: blur(6px);
    color: #FFFFFF;
    border: none;
    padding: 0.85rem 1rem;
    font-family: var(--luxury-font-body);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background 0.3s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
  }

  .luxury-product-card__quick-add-btn:hover {
    background: var(--luxury-accent, #9E583A);
  }

  @media screen and (max-width: 749px) {
    .luxury-product-card__quick-add {
      position: static;
      transform: none !important;
      margin-top: 0.6rem;
    }
    .luxury-product-card__quick-add-btn {
      background: var(--luxury-text, #1E1E1E);
      border-radius: var(--luxury-radius-xs);
      padding: 0.65rem 0.5rem;
      font-size: 0.7rem;
    }
  }

  /* Card Meta Information */
  .luxury-product-card__info {
    padding: 1.1rem 0.2rem 0.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .luxury-product-card__title {
    font-family: var(--luxury-font-heading, 'Cormorant Garamond', serif);
    font-size: clamp(1.05rem, 1.4vw, 1.35rem);
    font-weight: 500;
    line-height: 1.25;
    margin: 0;
    color: var(--luxury-text, #1E1E1E);
  }

  .luxury-product-card__title a {
    color: inherit;
    text-decoration: none;
    transition: color 0.25s ease;
  }

  .luxury-product-card__title a:hover {
    color: var(--luxury-accent, #9E583A);
  }

  .luxury-product-card__price-wrap {
    font-family: var(--luxury-font-body, 'Jost', sans-serif);
    font-size: 0.95rem;
    font-weight: 500;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--luxury-text, #1E1E1E);
  }

  .luxury-product-card__price-compare {
    text-decoration: line-through;
    color: var(--luxury-text-light, #948E87);
    font-size: 0.85rem;
  }

  .luxury-product-card__material {
    font-family: var(--luxury-font-body);
    font-size: 0.75rem;
    color: var(--luxury-text-muted, #6E6862);
    letter-spacing: 0.04em;
    text-transform: capitalize;
  }
{%- endstyle -%}

<div class="luxury-featured-products-section" id="LuxuryFeaturedProducts-{{ section.id }}">
  <div class="luxury-container">
    {%- if section.settings.heading != blank or section.settings.eyebrow != blank -%}
      <div class="luxury-products__header" data-aos="fade-up">
        {%- if section.settings.eyebrow != blank -%}
          <span class="luxury-products__eyebrow">{{ section.settings.eyebrow | escape }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="luxury-products__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.subtext != blank -%}
          <p class="luxury-products__subtext">{{ section.settings.subtext }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="luxury-products-swiper-container">
      <div class="swiper swiper-{{ section.id }}">
        <div class="swiper-wrapper">
          {%- assign collection = collections[section.settings.collection] -%}
          {%- if collection != blank and collection.products_count > 0 -%}
            {%- for product in collection.products limit: section.settings.products_to_show -%}
              <div class="swiper-slide" data-aos="zoom-in" data-aos-delay="{{ forloop.index0 | times: 100 }}">
                <div class="luxury-product-card">
                  <div class="luxury-product-card__media-wrapper hover-zoom-container">
                    {%- if product.featured_media != blank -%}
                      {{ product.featured_media | image_url: width: 800 | image_tag:
                        loading: 'lazy',
                        widths: '350, 500, 750, 900',
                        width: 800,
                        height: 1000,
                        class: 'luxury-product-card__image-primary',
                        alt: product.title | escape
                      }}
                      {%- if product.media[1] != blank -%}
                        {{ product.media[1] | image_url: width: 800 | image_tag:
                          loading: 'lazy',
                          widths: '350, 500, 750, 900',
                          width: 800,
                          height: 1000,
                          class: 'luxury-product-card__image-secondary',
                          alt: product.title | escape
                        }}
                      {%- endif -%}
                    {%- else -%}
                      {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                    {%- endif -%}

                    {%- if product.compare_at_price > product.price -%}
                      <span class="luxury-product-card__badge">Sale</span>
                    {%- elsif product.tags contains 'bestseller' or forloop.index <= 2 -%}
                      <span class="luxury-product-card__badge luxury-product-card__badge--bestseller">Bestseller</span>
                    {%- endif -%}

                    <button
                      type="button"
                      class="luxury-product-card__wishlist-btn wishlist-btn"
                      aria-label="Add to wishlist"
                      onclick="this.classList.toggle('active');"
                    >
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                        <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                      </svg>
                    </button>

                    <div class="luxury-product-card__quick-add">
                      {%- form 'product', product -%}
                        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                        <button
                          type="submit"
                          class="luxury-product-card__quick-add-btn"
                          {% unless product.available %}disabled{% endunless %}
                        >
                          {%- if product.available -%}
                            + Quick Add
                          {%- else -%}
                            Sold Out
                          {%- endif -%}
                        </button>
                      {%- endform -%}
                    </div>
                  </div>

                  <div class="luxury-product-card__info">
                    {%- if product.metafields.custom.material != blank -%}
                      <span class="luxury-product-card__material">{{ product.metafields.custom.material }}</span>
                    {%- elsif product.type != blank -%}
                      <span class="luxury-product-card__material">{{ product.type }}</span>
                    {%- endif -%}

                    <h3 class="luxury-product-card__title">
                      <a href="{{ product.url }}">{{ product.title | escape }}</a>
                    </h3>

                    <div class="luxury-product-card__price-wrap">
                      <span class="luxury-product-card__price-current">{{ product.price | money }}</span>
                      {%- if product.compare_at_price > product.price -%}
                        <span class="luxury-product-card__price-compare">{{ product.compare_at_price | money }}</span>
                      {%- endif -%}
                    </div>
                  </div>
                </div>
              </div>
            {%- endfor -%}
          {%- else -%}
            {%- for i in (1..6) -%}
              <div class="swiper-slide">
                <div class="luxury-product-card">
                  <div class="luxury-product-card__media-wrapper">
                    {%- assign placeholder_index = i | modulo: 6 | plus: 1 -%}
                    {{ 'product-' | append: placeholder_index | placeholder_svg_tag: 'placeholder-svg' }}
                  </div>
                  <div class="luxury-product-card__info">
                    <span class="luxury-product-card__material">Pure Hand-Spun Wool</span>
                    <h3 class="luxury-product-card__title">Heritage Artisanal Rug #{{ i }}</h3>
                    <div class="luxury-product-card__price-wrap">
                      <span>$890.00</span>
                      <span class="luxury-product-card__price-compare">$1,150.00</span>
                    </div>
                  </div>
                </div>
              </div>
            {%- endfor -%}
          {%- endif -%}
        </div>
      </div>

      <button class="luxury-products__nav-arrow luxury-products__nav-arrow--prev" id="SwiperPrev-{{ section.id }}" aria-label="Previous">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>
      <button class="luxury-products__nav-arrow luxury-products__nav-arrow--next" id="SwiperNext-{{ section.id }}" aria-label="Next">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>
    </div>

    {%- if section.settings.show_view_all and collection != blank -%}
      <div style="text-align: center; margin-top: 3rem;" data-aos="fade-up">
        <a href="{{ collection.url }}" class="luxury-btn--outline button-shine">
          {{ section.settings.view_all_label | default: 'View All Rugs' }}
        </a>
      </div>
    {%- endif -%}
  </div>
</div>

<script>
  (function () {
    function initProductSwiper() {
      if (typeof Swiper === 'undefined') {
        setTimeout(initProductSwiper, 100);
        return;
      }

      new Swiper('.swiper-{{ section.id }}', {
        slidesPerView: 2,
        spaceBetween: 16,
        grabCursor: true,
        navigation: {
          nextEl: '#SwiperNext-{{ section.id }}',
          prevEl: '#SwiperPrev-{{ section.id }}',
        },
        breakpoints: {
          640: {
            slidesPerView: 2.5,
            spaceBetween: 20
          },
          990: {
            slidesPerView: 3,
            spaceBetween: 28
          },
          1200: {
            slidesPerView: 4,
            spaceBetween: 32
          }
        }
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initProductSwiper);
    } else {
      initProductSwiper();
    }
  })();
</script>

{% schema %}
{
  "name": "Featured Products (Jaipur)",
  "tag": "section",
  "class": "section-luxury-featured-products",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "Curated Masterpieces"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Signature Bestsellers"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subheading",
      "default": "Each creation is painstakingly woven by hand over months, celebrating authentic Indian heritage."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Select Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 4,
      "max": 16,
      "step": 2,
      "label": "Products to Show",
      "default": 8
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section Background",
      "default": "#FFFFFF"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show 'View All' Button",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "'View All' Button Label",
      "default": "Explore Entire Collection"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 40,
      "max": 140,
      "step": 10,
      "unit": "px",
      "label": "Padding Top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 40,
      "max": 140,
      "step": 10,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "Featured Products (Jaipur)",
      "settings": {
        "eyebrow": "Curated Masterpieces",
        "heading": "Signature Bestsellers"
      }
    }
  ]
}
{% endschema %}