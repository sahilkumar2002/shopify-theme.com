{%- style -%}
  #LuxuryCraftsmanship-{{ section.id }} {
    position: relative;
    padding-top: {{ section.settings.padding_top | default: 110 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 110 }}px;
    background-color: #1C1B1A;
    color: #FFFFFF;
    overflow: hidden;
  }

  .luxury-craftsmanship__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 1;
    opacity: {{ section.settings.bg_image_opacity | divided_by: 100.0 | default: 0.35 }};
    filter: brightness(0.85);
  }

  .luxury-craftsmanship__overlay {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at center, rgba(28, 27, 26, 0.4) 0%, rgba(20, 19, 18, 0.92) 100%);
    z-index: 2;
  }

  .luxury-craftsmanship__container {
    position: relative;
    z-index: 3;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 clamp(1.5rem, 5vw, 4rem);
    text-align: center;
  }

  .luxury-craftsmanship__eyebrow {
    font-family: var(--luxury-font-body, 'Jost', sans-serif);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: var(--luxury-gold, #C2A26F);
    margin-bottom: 2rem;
    display: inline-block;
  }

  /* Quote Box */
  .luxury-craftsmanship__quote-box {
    max-width: 900px;
    margin: 0 auto clamp(3.5rem, 6vw, 5.5rem);
  }

  .luxury-craftsmanship__quote-mark {
    font-family: var(--luxury-font-heading, 'Cormorant Garamond', serif);
    font-size: clamp(3rem, 6vw, 4.5rem);
    line-height: 0.5;
    color: var(--luxury-gold, #C2A26F);
    margin-bottom: 1.5rem;
    opacity: 0.8;
  }

  .luxury-craftsmanship__quote-text {
    font-family: var(--luxury-font-heading, 'Cormorant Garamond', serif);
    font-size: clamp(1.8rem, 3.8vw, 3rem);
    font-style: italic;
    font-weight: 300;
    line-height: 1.35;
    color: #FAF7F2;
    margin: 0 0 1.8rem;
  }

  .luxury-craftsmanship__artisan-author {
    font-family: var(--luxury-font-body, 'Jost', sans-serif);
    font-size: 0.88rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--luxury-gold, #C2A26F);
  }

  .luxury-craftsmanship__artisan-author span {
    color: rgba(255, 255, 255, 0.6);
    font-weight: 400;
    margin-left: 0.4rem;
    text-transform: none;
    letter-spacing: 0.05em;
  }

  /* Counters Grid */
  .luxury-craftsmanship__counters {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 2.5rem 2rem;
    padding: clamp(2rem, 4vw, 3.5rem) 0;
    margin-bottom: clamp(3rem, 5vw, 4.5rem);
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
  }

  .luxury-counter-item {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .luxury-counter-number {
    font-family: var(--luxury-font-heading, 'Cormorant Garamond', serif);
    font-size: clamp(2.8rem, 5.5vw, 4.5rem);
    font-weight: 400;
    color: #FFFFFF;
    line-height: 1;
    margin-bottom: 0.6rem;
    letter-spacing: -0.02em;
  }

  .luxury-counter-label {
    font-family: var(--luxury-font-body, 'Jost', sans-serif);
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.7);
  }

  /* 3-Step Process */
  .luxury-craft-process {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: 2rem;
    margin-bottom: clamp(3rem, 5vw, 4.5rem);
    text-align: left;
  }

  @media screen and (min-width: 750px) {
    .luxury-craft-process {
      grid-template-columns: repeat(3, 1fr);
      gap: 2.5rem;
    }
  }

  .luxury-process-step {
    background: rgba(255, 255, 255, 0.04);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.08);
    padding: 2.2rem;
    border-radius: var(--luxury-radius-sm, 2px);
    transition: transform 0.4s var(--luxury-ease), border-color 0.4s ease;
  }

  .luxury-process-step:hover {
    transform: translateY(-4px);
    border-color: rgba(194, 162, 111, 0.4);
  }

  .luxury-process-step__number {
    font-family: var(--luxury-font-heading);
    font-size: 1.8rem;
    color: var(--luxury-gold, #C2A26F);
    margin-bottom: 0.8rem;
  }

  .luxury-process-step__title {
    font-family: var(--luxury-font-heading);
    font-size: 1.4rem;
    font-weight: 500;
    margin: 0 0 0.6rem;
    color: #FFFFFF;
  }

  .luxury-process-step__desc {
    font-family: var(--luxury-font-body);
    font-size: 0.88rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.65);
    margin: 0;
  }

  .luxury-craftsmanship__cta-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: var(--luxury-gold, #C2A26F);
    color: #1C1B1A !important;
    border: 1px solid var(--luxury-gold, #C2A26F);
    padding: 1.05rem 2.6rem;
    font-family: var(--luxury-font-body);
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    transition: all 0.4s var(--luxury-ease);
  }

  .luxury-craftsmanship__cta-btn:hover {
    background-color: #FFFFFF;
    border-color: #FFFFFF;
    color: #1C1B1A !important;
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.35);
  }
{%- endstyle -%}

<div class="luxury-craftsmanship-section" id="LuxuryCraftsmanship-{{ section.id }}">
  {%- if section.settings.bg_image != blank -%}
    {{ section.settings.bg_image | image_url: width: 2400 | image_tag:
      loading: 'lazy',
      widths: '800, 1400, 2000, 2400',
      class: 'luxury-craftsmanship__bg',
      alt: 'Artisan hand weaving rug'
    }}
  {%- endif -%}

  <div class="luxury-craftsmanship__overlay"></div>

  <div class="luxury-craftsmanship__container">
    {%- if section.settings.eyebrow != blank -%}
      <span class="luxury-craftsmanship__eyebrow" data-aos="fade-up">
        {{ section.settings.eyebrow | escape }}
      </span>
    {%- endif -%}

    <!-- Artisan Quote -->
    {%- if section.settings.quote_text != blank -%}
      <div class="luxury-craftsmanship__quote-box" data-aos="fade-up" data-aos-delay="100">
        <div class="luxury-craftsmanship__quote-mark">&ldquo;</div>
        <blockquote class="luxury-craftsmanship__quote-text">
          {{ section.settings.quote_text }}
        </blockquote>
        <div class="luxury-craftsmanship__artisan-author">
          {{ section.settings.artisan_name | default: 'Shanti Devi' }}
          <span>&mdash; {{ section.settings.artisan_village | default: 'Aspura Village, Rajasthan' }}</span>
        </div>
      </div>
    {%- endif -%}

    <!-- Animated Counters -->
    {%- if section.blocks.size > 0 -%}
      <div class="luxury-craftsmanship__counters" data-aos="fade-up" data-aos-delay="200">
        {%- for block in section.blocks -%}
          {%- if block.type == 'counter' -%}
            <div class="luxury-counter-item" {{ block.shopify_attributes }}>
              <div
                class="luxury-counter-number counter-number"
                data-counter-target="{{ block.settings.number | default: 40000 }}"
                data-counter-suffix="{{ block.settings.suffix | default: '+' }}"
                data-counter-duration="2400"
              >
                0{{ block.settings.suffix | default: '+' }}
              </div>
              <div class="luxury-counter-label">{{ block.settings.label | escape }}</div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    <!-- 3-Step Process -->
    {%- if section.settings.show_process -%}
      <div class="luxury-craft-process" data-aos="fade-up" data-aos-delay="300">
        <div class="luxury-process-step">
          <div class="luxury-process-step__number">01</div>
          <h4 class="luxury-process-step__title">{{ section.settings.step1_title | default: 'Design & Dyeing' }}</h4>
          <p class="luxury-process-step__desc">{{ section.settings.step1_desc | default: 'Hand-carded highland wool dyed in small vats with organic madder root and indigo.' }}</p>
        </div>
        <div class="luxury-process-step">
          <div class="luxury-process-step__number">02</div>
          <h4 class="luxury-process-step__title">{{ section.settings.step2_title | default: 'Loom Weaving' }}</h4>
          <p class="luxury-process-step__desc">{{ section.settings.step2_desc | default: 'Knotted knot-by-knot on upright wooden pit looms across rural artisan village homes.' }}</p>
        </div>
        <div class="luxury-process-step">
          <div class="luxury-process-step__number">03</div>
          <h4 class="luxury-process-step__title">{{ section.settings.step3_title | default: 'Finishing & Washing' }}</h4>
          <p class="luxury-process-step__desc">{{ section.settings.step3_desc | default: 'Sun-washed in natural springs and hand-sheared with heritage shears for velvety patina.' }}</p>
        </div>
      </div>
    {%- endif -%}

    {%- if section.settings.cta_label != blank -%}
      <div data-aos="fade-up" data-aos-delay="400">
        <a href="{{ section.settings.cta_link | default: '#' }}" class="luxury-craftsmanship__cta-btn button-shine">
          {{ section.settings.cta_label | escape }}
        </a>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Artisan & Craftsmanship",
  "tag": "section",
  "class": "section-luxury-craftsmanship",
  "settings": [
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Atmospheric Background Image"
    },
    {
      "type": "range",
      "id": "bg_image_opacity",
      "min": 10,
      "max": 70,
      "step": 5,
      "unit": "%",
      "label": "Background Image Opacity",
      "default": 35
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "Artisan Dignity & Handcraft"
    },
    {
      "type": "textarea",
      "id": "quote_text",
      "label": "Artisan Quote",
      "default": "My loom is where my songs and prayers come to life. With every single knot, I weave my family's blessings into your home."
    },
    {
      "type": "text",
      "id": "artisan_name",
      "label": "Artisan Name",
      "default": "Kamla Devi"
    },
    {
      "type": "text",
      "id": "artisan_village",
      "label": "Artisan Village / Region",
      "default": "Aspura Hamlet, Rajasthan"
    },
    {
      "type": "header",
      "content": "3-Step Weaving Process"
    },
    {
      "type": "checkbox",
      "id": "show_process",
      "label": "Show 3-Step Process",
      "default": true
    },
    {
      "type": "text",
      "id": "step1_title",
      "label": "Step 1 Title",
      "default": "Carding & Botanical Dyes"
    },
    {
      "type": "textarea",
      "id": "step1_desc",
      "label": "Step 1 Description",
      "default": "Hand-carded highland wool dyed in small copper vats with pure madder root and wild indigo."
    },
    {
      "type": "text",
      "id": "step2_title",
      "label": "Step 2 Title",
      "default": "Loom Knotting"
    },
    {
      "type": "textarea",
      "id": "step2_desc",
      "label": "Step 2 Description",
      "default": "Individually tied knot-by-knot on traditional pit looms across multigenerational family courtyards."
    },
    {
      "type": "text",
      "id": "step3_title",
      "label": "Step 3 Title",
      "default": "Sun Washing & Shearing"
    },
    {
      "type": "textarea",
      "id": "step3_desc",
      "label": "Step 3 Description",
      "default": "Gentle spring-water baths and artisanal shearing to coax out a sumptuous, heirloom tactile luster."
    },
    {
      "type": "header",
      "content": "Call to Action"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA Button Label",
      "default": "Meet Our Artisans"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA Button Link"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 60,
      "max": 180,
      "step": 10,
      "unit": "px",
      "label": "Padding Top",
      "default": 110
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 60,
      "max": 180,
      "step": 10,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 110
    }
  ],
  "blocks": [
    {
      "type": "counter",
      "name": "Statistic Counter",
      "settings": [
        {
          "type": "number",
          "id": "number",
          "label": "Target Number",
          "default": 40000
        },
        {
          "type": "text",
          "id": "suffix",
          "label": "Number Suffix",
          "default": "+"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Counter Label",
          "default": "Rural Artisans"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Artisan & Craftsmanship",
      "blocks": [
        {
          "type": "counter",
          "settings": { "number": 40000, "suffix": "+", "label": "Rural Artisans" }
        },
        {
          "type": "counter",
          "settings": { "number": 600, "suffix": "+", "label": "Weaving Villages" }
        },
        {
          "type": "counter",
          "settings": { "number": 85, "suffix": "+", "label": "Countries Cherished" }
        }
      ]
    }
  ]
}
{% endschema %}