{{ 'component-slideshow.aio.min.css' | asset_url | stylesheet_tag }}
{{ 'component-slider.aio.min.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign social_icons = true
  if settings.social_facebook_link == blank and settings.social_instagram_link == blank and settings.social_youtube_link == blank and settings.social_tiktok_link == blank and settings.social_twitter_link == blank and settings.social_pinterest_link == blank and settings.social_snapchat_link == blank and settings.social_tumblr_link == blank and settings.social_vimeo_link == blank
    assign social_icons = false
  endif
  if section.settings.enable_country_selector or section.settings.enable_language_selector
    assign language_country_selector = true
  endif
  if section.blocks.size > 0
    assign announcement_bar = true
  endif
-%}

{% if social_icons and section.settings.show_social %}
  {{ 'component-list-social.aio.min.css' | asset_url | stylesheet_tag }}
{% endif %}

<style>
  .luxury-announcement-bar {
    background-color: {{ section.settings.bar_bg_color | default: '#1C1B1A' }};
    color: {{ section.settings.bar_text_color | default: '#FBF9F5' }};
    font-family: var(--luxury-font-body, 'Jost', sans-serif);
    min-height: 40px;
    display: flex;
    align-items: center;
    position: relative;
    z-index: 101;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .luxury-announcement-bar .page-width {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: 0 1.5rem;
    position: relative;
  }

  .luxury-announcement-bar__rotator {
    flex: 1;
    text-align: center;
    position: relative;
    overflow: hidden;
    height: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .luxury-announcement-bar__item {
    position: absolute;
    top: 50%;
    left: 0;
    right: 0;
    transform: translateY(-50%);
    opacity: 0;
    visibility: hidden;
    display: none !important;
    transition: opacity 0.6s cubic-bezier(0.25, 1, 0.5, 1), transform 0.6s cubic-bezier(0.25, 1, 0.5, 1);
    pointer-events: none;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: {{ section.settings.bar_text_color | default: '#FBF9F5' }};
    text-decoration: none;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    white-space: nowrap;
  }

  .luxury-announcement-bar__item.is-active {
    opacity: 1;
    visibility: visible;
    display: inline-flex !important;
    pointer-events: auto;
    transform: translateY(-50%);
  }

  .luxury-announcement-bar__item a {
    color: inherit;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    transition: opacity 0.25s ease;
  }

  .luxury-announcement-bar__item a:hover {
    opacity: 0.85;
  }

  .luxury-announcement-bar__arrow {
    display: inline-block;
    transition: transform 0.3s ease;
  }

  .luxury-announcement-bar__item:hover .luxury-announcement-bar__arrow {
    transform: translateX(4px);
  }

  .luxury-announcement-bar .list-social {
    gap: 0.8rem;
    display: flex;
    align-items: center;
    margin: 0;
  }

  .luxury-announcement-bar .list-social__link {
    color: {{ section.settings.bar_text_color | default: '#FBF9F5' }};
    opacity: 0.8;
    transition: opacity 0.3s ease, transform 0.3s ease;
    padding: 0.2rem;
  }

  .luxury-announcement-bar .list-social__link:hover {
    opacity: 1;
    transform: scale(1.1);
  }

  .luxury-announcement-bar .localization-wrapper {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .luxury-announcement-bar .localization-selector {
    color: {{ section.settings.bar_text_color | default: '#FBF9F5' }};
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    background: transparent;
    border: none;
    cursor: pointer;
    text-transform: uppercase;
  }

  @media screen and (max-width: 749px) {
    .luxury-announcement-bar .small-hide {
      display: none !important;
    }
    .luxury-announcement-bar__item {
      font-size: 0.68rem;
      letter-spacing: 0.1em;
    }
  }
</style>

<div
  class="luxury-announcement-bar color-{{ section.settings.color_scheme }} gradient"
  id="AnnouncementBar-{{ section.id }}"
  role="region"
  aria-label="{{ 'sections.header.announcement' | t }}"
  data-interval="{{ section.settings.change_slides_speed | default: 4 | times: 1000 }}"
  {{ block.shopify_attributes }}
>
  <div class="page-width">
    {%- if section.settings.show_social and social_icons -%}
      <div class="small-hide">
        {%- render 'social-icons' -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div
        class="luxury-announcement-bar__rotator"
        id="AnnouncementRotator-{{ section.id }}"
        aria-live="polite"
      >
        {%- for block in section.blocks -%}
          <div
            class="luxury-announcement-bar__item{% if forloop.first %} is-active{% endif %}"
            data-index="{{ forloop.index0 }}"
            {{ block.shopify_attributes }}
          >
            {%- if block.settings.link != blank -%}
              <a href="{{ block.settings.link }}">
                <span>{{ block.settings.text | escape }}</span>
                <span class="luxury-announcement-bar__arrow" aria-hidden="true">&rarr;</span>
              </a>
            {%- else -%}
              <span>{{ block.settings.text | escape }}</span>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if language_country_selector -%}
      <div class="localization-wrapper small-hide">
        {%- if section.settings.enable_country_selector and localization.available_countries.size > 1 -%}
          <localization-form>
            {%- form 'localization', id: 'AnnouncementCountryForm', class: 'localization-form' -%}
              <div>
                <h2 class="visually-hidden" id="AnnouncementCountryLabel">{{ 'localization.country_label' | t }}</h2>
                {%- render 'country-localization', localPosition: 'AnnouncementCountry' -%}
              </div>
            {%- endform -%}
          </localization-form>
        {%- endif -%}

        {%- if section.settings.enable_language_selector and localization.available_languages.size > 1 -%}
          <localization-form>
            {%- form 'localization', id: 'AnnouncementLanguageForm', class: 'localization-form' -%}
              <div>
                <h2 class="visually-hidden" id="AnnouncementLanguageLabel">{{ 'localization.language_label' | t }}</h2>
                {%- render 'language-localization', localPosition: 'AnnouncementLanguage' -%}
              </div>
            {%- endform -%}
          </localization-form>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>

<script>
  (function () {
    var rotator = document.getElementById('AnnouncementRotator-{{ section.id }}');
    if (!rotator) return;

    var items = rotator.querySelectorAll('.luxury-announcement-bar__item');
    if (items.length <= 1) return;

    var intervalTime = parseInt(document.getElementById('AnnouncementBar-{{ section.id }}').getAttribute('data-interval'), 10) || 4000;
    var currentIndex = 0;
    var timer = null;
    var isPaused = false;

    function showNext() {
      if (isPaused) return;
      items[currentIndex].classList.remove('is-active');
      currentIndex = (currentIndex + 1) % items.length;
      items[currentIndex].classList.add('is-active');
    }

    function startTimer() {
      if (timer) clearInterval(timer);
      timer = setInterval(showNext, intervalTime);
    }

    rotator.addEventListener('mouseenter', function () {
      isPaused = true;
    });

    rotator.addEventListener('mouseleave', function () {
      isPaused = false;
    });

    startTimer();

    // Support Theme Editor live block switching
    document.addEventListener('shopify:block:select', function (e) {
      if (!e.target.classList.contains('luxury-announcement-bar__item')) return;
      isPaused = true;
      items.forEach(function (item) { item.classList.remove('is-active'); });
      e.target.classList.add('is-active');
    });

    document.addEventListener('shopify:block:deselect', function () {
      isPaused = false;
    });
  })();
</script>

{% schema %}
{
  "name": "Announcement bar (Luxury)",
  "max_blocks": 12,
  "class": "announcement-bar-section",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "color",
      "id": "bar_bg_color",
      "label": "Background Color",
      "default": "#1C1B1A"
    },
    {
      "type": "color",
      "id": "bar_text_color",
      "label": "Text Color",
      "default": "#FBF9F5"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-4"
    },
    {
      "type": "checkbox",
      "id": "show_line_separator",
      "default": true,
      "label": "t:sections.header.settings.show_line_separator.label"
    },
    {
      "type": "header",
      "content": "Rotation & Speed"
    },
    {
      "type": "checkbox",
      "id": "auto_rotate",
      "label": "Auto-rotate announcements",
      "default": true
    },
    {
      "type": "range",
      "id": "change_slides_speed",
      "min": 2,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "Slide Duration (Seconds)",
      "default": 4
    },
    {
      "type": "header",
      "content": "Social Media Icons"
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "default": false,
      "label": "Show social media icons"
    },
    {
      "type": "header",
      "content": "Language and Currency"
    },
    {
      "type": "checkbox",
      "id": "enable_country_selector",
      "default": false,
      "label": "Enable country/currency selector"
    },
    {
      "type": "checkbox",
      "id": "enable_language_selector",
      "default": false,
      "label": "Enable language selector"
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Announcement",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "default": "COMPLIMENTARY WORLDWIDE DELIVERY ON ORDERS OVER $500",
          "label": "Announcement text"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Optional link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Announcement bar (Luxury)",
      "blocks": [
        {
          "type": "announcement",
          "settings": {
            "text": "COMPLIMENTARY WORLDWIDE DELIVERY ON ORDERS OVER $500"
          }
        },
        {
          "type": "announcement",
          "settings": {
            "text": "HANDCRAFTED LUXURY: EXPLORE OUR NEW ARTISANAL ARRIVALS"
          }
        }
      ]
    }
  ]
}
{% endschema %}