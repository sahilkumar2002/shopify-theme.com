{{ 'component-slideshow.aio.min.css' | asset_url | stylesheet_tag }}
{{ 'component-slider.aio.min.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #LuxuryHero-{{ section.id }} {
    position: relative;
    width: 100%;
    min-height: {{ section.settings.hero_height_mobile | default: '85vh' }};
    overflow: hidden;
    background-color: #1C1B1A;
    color: #FFFFFF;
    display: flex;
    align-items: center;
  }

  @media screen and (min-width: 750px) {
    #LuxuryHero-{{ section.id }} {
      min-height: {{ section.settings.hero_height_desktop | default: '95vh' }};
    }
  }

  .luxury-hero__slide {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    visibility: hidden;
    transition: opacity {{ section.settings.transition_speed | default: 1000 }}ms cubic-bezier(0.25, 1, 0.5, 1);
    z-index: 1;
  }

  .luxury-hero__slide.is-active {
    opacity: 1;
    visibility: visible;
    z-index: 2;
  }

  .luxury-hero__media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .luxury-hero__media img,
  .luxury-hero__media video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: {{ section.settings.image_position | default: 'center center' }};
  }

  .luxury-hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(0, 0, 0, {{ section.settings.overlay_top_opacity | divided_by: 100.0 }}) 0%,
      rgba(0, 0, 0, {{ section.settings.overlay_bottom_opacity | divided_by: 100.0 }}) 100%
    );
    z-index: 2;
    pointer-events: none;
  }

  .luxury-hero__container {
    position: relative;
    z-index: 3;
    width: 100%;
    max-width: 1440px;
    margin: 0 auto;
    padding: clamp(2rem, 5vw, 4rem) clamp(1.5rem, 5vw, 4rem);
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: inherit;
    text-align: {{ section.settings.content_alignment | default: 'center' }};
  }

  .luxury-hero__content-box {
    max-width: 860px;
    {% if section.settings.content_alignment == 'center' %}
      margin: 0 auto;
    {% elsif section.settings.content_alignment == 'right' %}
      margin-left: auto;
    {% endif %}
  }

  .luxury-hero__eyebrow {
    font-family: var(--luxury-font-body, 'Jost', sans-serif);
    font-size: clamp(0.75rem, 1.2vw, 0.88rem);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: {{ section.settings.accent_color | default: '#EADBCC' }};
    margin-bottom: 1.2rem;
    display: inline-block;
  }

  .luxury-hero__heading {
    font-family: var(--luxury-font-heading, 'Cormorant Garamond', serif);
    font-size: clamp(2.6rem, 6.5vw, 5.5rem);
    font-weight: 400;
    line-height: 1.08;
    letter-spacing: -0.01em;
    color: #FFFFFF;
    margin: 0 0 1.5rem;
  }

  .luxury-hero__heading em {
    font-style: italic;
    font-weight: 300;
  }

  .luxury-hero__subtext {
    font-family: var(--luxury-font-body, 'Jost', sans-serif);
    font-size: clamp(0.95rem, 1.6vw, 1.15rem);
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.88);
    margin: 0 0 2.5rem;
    max-width: 640px;
    {% if section.settings.content_alignment == 'center' %}
      margin-left: auto;
      margin-right: auto;
    {% endif %}
  }

  .luxury-hero__button-group {
    display: flex;
    flex-wrap: wrap;
    gap: 1.2rem;
    {% if section.settings.content_alignment == 'center' %}
      justify-content: center;
    {% elsif section.settings.content_alignment == 'right' %}
      justify-content: flex-end;
    {% endif %}
  }

  .luxury-hero__btn-primary {
    background-color: #FFFFFF;
    color: #1C1B1A !important;
    border: 1px solid #FFFFFF;
    padding: 1.05rem 2.5rem;
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    transition: all 0.4s var(--luxury-ease);
  }

  .luxury-hero__btn-primary:hover {
    background-color: var(--luxury-accent, #9E583A);
    border-color: var(--luxury-accent, #9E583A);
    color: #FFFFFF !important;
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.3);
  }

  .luxury-hero__btn-secondary {
    background-color: transparent;
    color: #FFFFFF !important;
    border: 1px solid rgba(255, 255, 255, 0.7);
    padding: 1.05rem 2.5rem;
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    transition: all 0.4s var(--luxury-ease);
  }

  .luxury-hero__btn-secondary:hover {
    background-color: #FFFFFF;
    color: #1C1B1A !important;
    border-color: #FFFFFF;
    transform: translateY(-2px);
  }

  /* Scroll Down Indicator */
  .luxury-hero__scroll-down {
    position: absolute;
    bottom: 2.2rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 5;
    color: rgba(255, 255, 255, 0.8);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    font-family: var(--luxury-font-body);
    font-size: 0.68rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    cursor: pointer;
    transition: color 0.3s ease;
  }

  .luxury-hero__scroll-down:hover {
    color: #FFFFFF;
  }

  .luxury-hero__scroll-indicator-arrow {
    width: 22px;
    height: 22px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Dots navigation for multi-slide */
  .luxury-hero__dots {
    position: absolute;
    bottom: 2.5rem;
    right: clamp(1.5rem, 5vw, 4rem);
    z-index: 5;
    display: flex;
    gap: 0.8rem;
  }

  .luxury-hero__dot {
    width: 32px;
    height: 2px;
    background: rgba(255, 255, 255, 0.35);
    border: none;
    padding: 0;
    cursor: pointer;
    transition: all 0.4s ease;
    position: relative;
    overflow: hidden;
  }

  .luxury-hero__dot.is-active {
    background: #FFFFFF;
    width: 48px;
  }
{%- endstyle -%}

<div
  class="luxury-hero-section"
  id="LuxuryHero-{{ section.id }}"
  data-slideshow="{{ section.settings.enable_slideshow }}"
  data-autoplay-speed="{{ section.settings.autoplay_speed | default: 6 | times: 1000 }}"
>
  {%- if section.blocks.size > 0 -%}
    {%- for block in section.blocks -%}
      <div
        class="luxury-hero__slide{% if forloop.first %} is-active{% endif %}"
        id="Slide-{{ section.id }}-{{ forloop.index }}"
        data-index="{{ forloop.index0 }}"
        {{ block.shopify_attributes }}
      >
        <div class="luxury-hero__media{% if section.settings.enable_ken_burns %} ken-burns{% endif %}">
          {%- if block.settings.video != blank -%}
            {{ block.settings.video | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true }}
          {%- elsif block.settings.image != blank -%}
            <picture>
              {%- if block.settings.image_mobile != blank -%}
                <source media="(max-width: 749px)" srcset="{{ block.settings.image_mobile | image_url: width: 800 }}">
              {%- endif -%}
              {{ block.settings.image | image_url: width: 2400 | image_tag:
                loading: 'eager',
                fetchpriority: 'high',
                widths: '750, 1100, 1500, 1920, 2400',
                alt: block.settings.heading | escape
              }}
            </picture>
          {%- else -%}
            {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </div>

        <div class="luxury-hero__overlay"></div>

        <div class="luxury-hero__container">
          <div class="luxury-hero__content-box">
            {%- if block.settings.eyebrow != blank -%}
              <span
                class="luxury-hero__eyebrow"
                data-aos="fade-up"
                data-aos-delay="100"
              >
                {{ block.settings.eyebrow | escape }}
              </span>
            {%- endif -%}

            {%- if block.settings.heading != blank -%}
              <h1
                class="luxury-hero__heading"
                data-aos="fade-up"
                data-aos-delay="200"
              >
                {{ block.settings.heading }}
              </h1>
            {%- endif -%}

            {%- if block.settings.subtext != blank -%}
              <p
                class="luxury-hero__subtext"
                data-aos="fade-up"
                data-aos-delay="300"
              >
                {{ block.settings.subtext }}
              </p>
            {%- endif -%}

            {%- if block.settings.button_label_1 != blank or block.settings.button_label_2 != blank -%}
              <div
                class="luxury-hero__button-group"
                data-aos="fade-up"
                data-aos-delay="400"
              >
                {%- if block.settings.button_label_1 != blank -%}
                  <a
                    href="{{ block.settings.button_link_1 }}"
                    class="luxury-hero__btn-primary button-shine"
                  >
                    {{ block.settings.button_label_1 | escape }}
                  </a>
                {%- endif -%}

                {%- if block.settings.button_label_2 != blank -%}
                  <a
                    href="{{ block.settings.button_link_2 }}"
                    class="luxury-hero__btn-secondary button-shine"
                  >
                    {{ block.settings.button_label_2 | escape }}
                  </a>
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>
        </div>
      </div>
    {%- endfor -%}

    {%- if section.settings.enable_slideshow and section.blocks.size > 1 -%}
      <div class="luxury-hero__dots" role="tablist">
        {%- for block in section.blocks -%}
          <button
            class="luxury-hero__dot{% if forloop.first %} is-active{% endif %}"
            type="button"
            role="tab"
            aria-label="Slide {{ forloop.index }}"
            data-slide-index="{{ forloop.index0 }}"
          ></button>
        {%- endfor -%}
      </div>
    {%- endif -%}
  {%- endif -%}

  {%- if section.settings.show_scroll_indicator -%}
    <a
      href="#MainContent"
      class="luxury-hero__scroll-down"
      onclick="event.preventDefault(); window.scrollBy({top: window.innerHeight * 0.85, behavior: 'smooth'});"
      aria-label="Scroll to discover"
    >
      <span>Scroll</span>
      <div class="luxury-hero__scroll-indicator-arrow scroll-down-indicator">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="12" y1="5" x2="12" y2="19"></line>
          <polyline points="19 12 12 19 5 12"></polyline>
        </svg>
      </div>
    </a>
  {%- endif -%}
</div>

<script>
  (function () {
    var hero = document.getElementById('LuxuryHero-{{ section.id }}');
    if (!hero) return;

    var slides = hero.querySelectorAll('.luxury-hero__slide');
    if (slides.length <= 1) return;

    var dots = hero.querySelectorAll('.luxury-hero__dot');
    var isSlideshow = hero.getAttribute('data-slideshow') === 'true';
    if (!isSlideshow) return;

    var autoplaySpeed = parseInt(hero.getAttribute('data-autoplay-speed'), 10) || 6000;
    var currentIndex = 0;
    var timer = null;

    function goToSlide(index) {
      slides[currentIndex].classList.remove('is-active');
      if (dots[currentIndex]) dots[currentIndex].classList.remove('is-active');

      currentIndex = index;

      slides[currentIndex].classList.add('is-active');
      if (dots[currentIndex]) dots[currentIndex].classList.add('is-active');

      // Refresh AOS for newly activated slide
      if (typeof AOS !== 'undefined') {
        AOS.refreshHard();
      }
    }

    function nextSlide() {
      var next = (currentIndex + 1) % slides.length;
      goToSlide(next);
    }

    function startAutoPlay() {
      if (timer) clearInterval(timer);
      timer = setInterval(nextSlide, autoplaySpeed);
    }

    dots.forEach(function (dot) {
      dot.addEventListener('click', function () {
        var idx = parseInt(this.getAttribute('data-slide-index'), 10);
        goToSlide(idx);
        startAutoPlay();
      });
    });

    startAutoPlay();

    // Touch swipe support for mobile
    var touchStartX = 0;
    var touchEndX = 0;

    hero.addEventListener('touchstart', function (e) {
      touchStartX = e.changedTouches[0].screenX;
    }, { passive: true });

    hero.addEventListener('touchend', function (e) {
      touchEndX = e.changedTouches[0].screenX;
      if (touchStartX - touchEndX > 50) {
        // swipe left -> next
        nextSlide();
        startAutoPlay();
      } else if (touchEndX - touchStartX > 50) {
        // swipe right -> prev
        var prev = (currentIndex - 1 + slides.length) % slides.length;
        goToSlide(prev);
        startAutoPlay();
      }
    }, { passive: true });
  })();
</script>

{% schema %}
{
  "name": "Luxury Hero (Jaipur)",
  "tag": "section",
  "class": "section-luxury-hero",
  "settings": [
    {
      "type": "select",
      "id": "hero_height_desktop",
      "label": "Desktop Height",
      "options": [
        { "value": "85vh", "label": "85% Viewport (85vh)" },
        { "value": "92vh", "label": "92% Viewport (92vh)" },
        { "value": "100vh", "label": "Full Screen (100vh)" }
      ],
      "default": "92vh"
    },
    {
      "type": "select",
      "id": "hero_height_mobile",
      "label": "Mobile Height",
      "options": [
        { "value": "75vh", "label": "75% Viewport" },
        { "value": "85vh", "label": "85% Viewport" },
        { "value": "95vh", "label": "95% Viewport" }
      ],
      "default": "85vh"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Text Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "checkbox",
      "id": "enable_ken_burns",
      "label": "Enable Ken Burns Slow Zoom",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_scroll_indicator",
      "label": "Show Animated Scroll-down Indicator",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_slideshow",
      "label": "Enable Slideshow (if multiple slides)",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "min": 4,
      "max": 12,
      "step": 1,
      "unit": "s",
      "label": "Slideshow Change Speed",
      "default": 6
    },
    {
      "type": "range",
      "id": "overlay_top_opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "Dark Overlay Top Opacity",
      "default": 35
    },
    {
      "type": "range",
      "id": "overlay_bottom_opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "label": "Dark Overlay Bottom Opacity",
      "default": 60
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Eyebrow Accent Color",
      "default": "#EADBCC"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Hero Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Desktop Image (Min 2000px wide)"
        },
        {
          "type": "image_picker",
          "id": "image_mobile",
          "label": "Mobile Image (Optional)"
        },
        {
          "type": "video",
          "id": "video",
          "label": "Muted Looping Background Video (Overrides image)"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow Text",
          "default": "The Art of Handcrafted Living"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Woven Stories, <em>Timeless Heritage</em>"
        },
        {
          "type": "textarea",
          "id": "subtext",
          "label": "Subheading",
          "default": "Discover museum-quality rugs woven by master Indian artisans with hand-spun organic wool and botanical dyes."
        },
        {
          "type": "text",
          "id": "button_label_1",
          "label": "Primary Button Label",
          "default": "Explore Collection"
        },
        {
          "type": "url",
          "id": "button_link_1",
          "label": "Primary Button Link"
        },
        {
          "type": "text",
          "id": "button_label_2",
          "label": "Secondary Button Label",
          "default": "Our Artisan Legacy"
        },
        {
          "type": "url",
          "id": "button_link_2",
          "label": "Secondary Button Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Luxury Hero (Jaipur)",
      "blocks": [
        {
          "type": "slide",
          "settings": {
            "eyebrow": "The Art of Handcrafted Living",
            "heading": "Woven Stories, <em>Timeless Heritage</em>",
            "subtext": "Discover museum-quality rugs woven by master Indian artisans with hand-spun organic wool and botanical dyes.",
            "button_label_1": "Explore Collection",
            "button_label_2": "Our Artisan Legacy"
          }
        }
      ]
    }
  ]
}
{% endschema %}