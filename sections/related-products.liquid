{% endcomment %}



{{ 'component-card.css' | asset_url | stylesheet_tag }}

<div class="page-width related-products-section">

  <h2 class="title">
    Related Products
  </h2>

  <product-recommendations
    class="related-products"
    data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit=8"
  >

    {% if recommendations.performed and recommendations.products_count > 0 %}

      <div class="related-products-wrapper">

        <!-- PREV BUTTON -->
        <button
          class="related-btn prev-btn"
          type="button"
        >
          &#10094;
        </button>

        <!-- SLIDER -->
        <div class="related-products-slider">

          {% for recommendation in recommendations.products %}

            <div class="related-slide">

              {% render 'card-product',
                card_product: recommendation,
                media_aspect_ratio: 'adapt',
                show_secondary_image: true,
                show_vendor: false,
                show_rating: false
              %}

            </div>

          {% endfor %}

        </div>

        <!-- NEXT BUTTON -->
        <button
          class="related-btn next-btn"
          type="button"
        >
          &#10095;
        </button>

      </div>

    {% endif %}

  </product-recommendations>

</div>

<style>

/* =========================
RELATED PRODUCTS SECTION
========================= */

.related-products-section{
  margin-top:0px;
}

.related-products-wrapper{
  position:relative;
}

/* =========================
SLIDER (UPDATED LIKE RV STYLE)
========================= */

.related-products-slider{

  display:flex;
  gap:16px; /* match recently viewed */

  overflow-x:auto;
  scroll-behavior:smooth;

  padding:5px 0;

  scrollbar-width:none;
  align-items:stretch;
}

.related-products-slider::-webkit-scrollbar{
  display:none;
}

/* =========================
EACH PRODUCT CARD (UPDATED RESPONSIVE)
========================= */

.related-slide{
  flex:0 0 calc((100% - 48px) / 4); /* 4 cards desktop */
  display:flex;
  flex-direction:column;
}

/* =========================
IMAGE EXACTLY LIKE RECENTLY VIEWED
========================= */

.related-slide .card__media,
.related-slide .media {
  width: 100%;
  overflow: hidden;
  background: transparent;
}

.related-slide .media img,
.related-slide .card__media img,
.related-slide .media--transparent img {

  width: 100% !important;
  height: auto !important;

  max-height: 370px !important;

  object-fit: cover !important;
  object-position: center;

  display: block;
  border-radius: 0px;

  transition: none;
}

/* REMOVE DAWN IMAGE RATIO SPACING */
.related-slide .media::before {
  padding-bottom: 0 !important;
  content: none !important;
}

/* FORCE IMAGE CONTAINER HEIGHT */
.related-slide .card-wrapper,
.related-slide .card,
.related-slide .card__inner {
  height: 100%;
}

/* REMOVE EXTRA IMAGE EFFECTS */
.related-slide .card--media .card__inner .card__content {
  display: none;
}

/* REMOVE IMAGE HOVER ZOOM */
.related-slide .media img:hover {
  height:100% !important;
}

/* =========================
CARD CONTENT
========================= */

/* REMOVE EXTRA GAP UNDER IMAGE */

.related-slide .card__content{
  padding-top:0 !important;
}

.related-slide .card-information{
  margin-top:0 !important;
  padding-top:0 !important;
}

.related-slide .card__heading{
  margin-top:0px !important;
  margin-bottom:8px !important;
  padding-top:0 !important;
}

.related-slide .price{
  margin-top:0 !important;
}

/* REMOVE EMPTY SPACE CREATED BY DAWN */
.related-slide .card__information{
  padding-top:10px !important;
}

/* TITLE */
.related-slide .card__heading{

  font-size:16px;
  margin:10px 0 5px;
  flex-grow:0.5;
  text-align:center;
  overflow:hidden;
}

/* PRICE */
.related-slide .price{
  margin:0 0 10px;
  font-weight:bold;
  text-align:center;
}

/* =========================
BUTTONS (SAME STYLE AS RV)
========================= */

.related-btn{

  position:absolute;
  top:40%;
  transform:translateY(-50%);

  width:40px;
  height:40px;

  border:none;
  cursor:pointer;
  z-index:10;

  background:#fff;
  box-shadow:0 2px 10px rgba(0,0,0,.15);

  display:flex;
  align-items:center;
  justify-content:center;
  font-size:18px;
}

.prev-btn{
  left:0;
}

.next-btn{
  right:0;
}

/* =========================
TABLET (3 PRODUCTS)
========================= */

@media screen and (max-width:1024px){

  .related-slide{
    flex:0 0 calc((100% - 32px) / 3);
  }
}

/* =========================
MOBILE (1 PRODUCT)
========================= */

@media screen and (max-width:768px){

  .related-slide{
    flex:0 0 100%;
  }

  .related-slide .media img,
.related-slide .card__media img{
  max-height:none !important;
  object-fit:cover !important;
}
}

</style>

<script>

document.addEventListener(
  "DOMContentLoaded",
  () => {

    class ProductRecommendations
      extends HTMLElement {

      connectedCallback() {

        fetch(this.dataset.url)
          .then(response =>
            response.text()
          )
          .then(text => {

            const html =
              document.createElement(
                "div"
              );

            html.innerHTML =
              text;

            const recommendations =
              html.querySelector(
                "product-recommendations"
              );

            if (
              recommendations &&
              recommendations.innerHTML
                .trim()
                .length
            ) {

              this.innerHTML =
                recommendations.innerHTML;

              initRelatedSlider();

            }

          });

      }

    }

    customElements.define(
      "product-recommendations",
      ProductRecommendations
    );

    // ----------------------------
    // SLIDER
    // ----------------------------

    function initRelatedSlider() {

      const slider =
        document.querySelector(
          ".related-products-slider"
        );

      const nextBtn =
        document.querySelector(
          ".next-btn"
        );

      const prevBtn =
        document.querySelector(
          ".prev-btn"
        );

      if (
        !slider ||
        !nextBtn ||
        !prevBtn
      ) return;

      nextBtn.addEventListener(
        "click",
        () => {

          slider.scrollBy({
            left:300,
            behavior:"smooth"
          });

        }
      );

      prevBtn.addEventListener(
        "click",
        () => {

          slider.scrollBy({
            left:-300,
            behavior:"smooth"
          });

        }
      );

    }

    initRelatedSlider();

  }
);

</script>

