{% comment %}
  Blog Grid with Sidebar – v2.2
  • Ellipsis after “Read more”
  • Sidebar width 1‑40 %
  • Larger title / excerpt
{% endcomment %}

{%- assign s = section.settings -%}

<section
  class="blog-grid-layout{% unless s.show_sidebar %} no-sidebar{% endunless %}"
  style="
    --sidebar-width: {{ s.sidebar_width }}%;
    --grid-gap: {{ s.gap_size }}px;
    padding: {{ s.padding_vertical }}px {{ s.padding_horizontal }}px;
  "
>
  {%- assign blog        = blogs[s.blog] -%}
  {%- assign posts_limit = s.posts_limit | default: 9 -%}
  {%- assign columns     = s.columns_desktop | default: 3 -%}
  {%- assign sort_order  = s.sort_order  | default: 'desc' -%}

  {% if blog == nil %}
    <p class="blog-grid-error">Please select a valid blog in this section’s settings.</p>
  {% else %}

  <!-- === Posts Grid === -->
  <div class="posts-area">
    <div class="posts-grid"
         data-sort="{{ sort_order }}"
         style="grid-template-columns:repeat({{ columns }},1fr);">
      {% for article in blog.articles limit: posts_limit %}
        {%- assign raw_excerpt = article.excerpt | default: article.content | strip_html -%}
        <article
          class="post-card"
          data-published="{{ article.published_at | date: '%s' }}"
          data-tags="{{ article.tags | join: ',' | escape }}"
          data-author="{{ article.author | escape }}"
          data-month="{{ article.published_at | date: '%Y-%m' }}"
          data-title="{{ article.title | escape }}"
          data-excerpt="{{ raw_excerpt | truncate: 200 | strip_newlines | escape }}"
        >
          {% if article.image %}
            <a href="{{ article.url }}" class="post-card__image-wrapper">
              <img class="post-card__image"
                   src="{{ article.image | img_url: '720x' }}"
                  alt="{{ article.title | escape }}"
title="{{ article.title | escape }}"

                   loading="lazy">
            </a>
          {% endif %}

          <div class="post-card__content">
            <h3 class="post-card__title">
              <a href="{{ article.url }}">{{ article.title }}</a>
            </h3>

            <time class="post-card__date" datetime="{{ article.published_at }}">
              {{ article.published_at | date: '%B&nbsp;%d&nbsp;%Y' }}
            </time>

            {%- capture trimmed %}{{ raw_excerpt | truncatewords: 20, "" }}{% endcapture -%}
            <p class="post-card__excerpt">
              {{ trimmed | strip }}
              <a href="{{ article.url }}" class="post-card__read-more-inline">
                {{ s.read_more_label }} …
              </a>
            </p>
          </div>
        </article>
      {% endfor %}
    </div><!-- /.posts-grid -->
  </div><!-- /.posts-area -->

  <!-- === Sidebar === -->
  {% if s.show_sidebar %}
    <aside class="sidebar">
      <h4 class="sidebar__heading">Filters</h4>

      {% if s.enable_search %}
        <div class="filter-group">
          <input type="text" id="post-search"
                 placeholder="Search posts…" aria-label="Search posts">
        </div>
      {% endif %}

      {% if s.enable_author_filter %}
        <div class="filter-group">
          <label for="author-select">Author:</label>
          <select id="author-select">
            <option value="all">All</option>
            {%- assign authors = '' -%}
            {% for article in blog.articles %}
              {% unless authors contains article.author %}
                <option value="{{ article.author | escape }}">{{ article.author }}</option>
                {%- assign authors = authors | append: article.author | append: ',' -%}
              {% endunless %}
            {% endfor %}
          </select>
        </div>
      {% endif %}

      {% if blog.all_tags.size > 0 %}
        <div class="filter-group">
          <label>Tags:</label>
          <ul class="tags" id="tag-filter">
            <li><button data-tag="all" class="active">All</button></li>
            {% for tag in blog.all_tags %}
              <li><button data-tag="{{ tag | escape }}">{{ tag }}</button></li>
            {% endfor %}
          </ul>
        </div>
      {% endif %}

      {% if s.enable_month_filter %}
        <div class="filter-group">
          <label for="month-select">Month:</label>
          <select id="month-select">
            <option value="all">All</option><!-- JS fills options -->
          </select>
        </div>
      {% endif %}

      <div class="filter-group">
        <label for="sort-select">Sort by date:</label>
        <select id="sort-select">
          <option value="desc" {% if sort_order == 'desc' %}selected{% endif %}>Newest first</option>
          <option value="asc"  {% if sort_order == 'asc'  %}selected{% endif %}>Oldest first</option>
        </select>
      </div>
    </aside>
  {% endif %}
  {% endif %}
</section>

<style>
/* ---------- Layout & Responsiveness ---------- */
.blog-grid-layout{
  --gap: var(--grid-gap,2rem);
  display:grid;
  gap:var(--gap);
  grid-template-columns:minmax(0,1fr) var(--sidebar-width,25%);
}
.blog-grid-layout.no-sidebar{grid-template-columns:1fr;}
@media(max-width:768px){
  .blog-grid-layout{grid-template-columns:1fr;}
  .sidebar{order:-1;margin-bottom:var(--gap);}
}

/* ---------- Grid ---------- */
.posts-grid{display:grid;gap:var(--gap);}
@media(max-width:768px){.posts-grid{grid-template-columns:1fr;}}

/* ---------- Card ---------- */
.post-card{
  display:flex;flex-direction:column;
  border:1px solid #e4e4e4;border-radius:.625rem;
  background:#fff;overflow:hidden;
  transition:transform .2s cubic-bezier(.22,.61,.36,1),box-shadow .2s;
}
.post-card:hover{transform:translateY(-4px);box-shadow:0 6px 16px rgba(0,0,0,.08);}
.post-card__image-wrapper{position:relative;width:100%;padding-top:56.25%}
.post-card__image{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
.post-card__content{padding:1.2rem;display:flex;flex-direction:column;flex:1}
.post-card__title{margin:0 0 .6rem;font-size:clamp(1.2rem,2.8vw,1.5rem);font-weight:700;line-height:1.3}
.post-card__title a{color:inherit;text-decoration:none}
.post-card__title a:hover{text-decoration:underline}
.post-card__date{font-size:.85rem;color:#777;margin-bottom:.8rem;letter-spacing:.02em}
.post-card__excerpt{font-size:1rem;line-height:1.6}
.post-card__read-more-inline{font-weight:600;text-decoration:none;color:var(--color-link,#0055cc)}
.post-card__read-more-inline:hover{text-decoration:underline}

/* ---------- Sidebar ---------- */
.sidebar{border-left:1px solid #e5e5e5;padding-left:1.5rem;width:100%}
.sidebar__heading{margin:0 0 1.25rem;font-size:1.35rem}
.filter-group{margin-bottom:1.25rem;font-size:.92rem;display:flex;flex-direction:column;gap:.4rem}
.filter-group label{font-weight:600}
.filter-group input,
.filter-group select{width:100%;padding:.55rem .75rem;border:1px solid #ccc;border-radius:.375rem;font-size:.95rem;outline:none;transition:border-color .2s}
.filter-group input:focus,
.filter-group select:focus{border-color:#888;}
.tags{list-style:none;margin:0;padding:0;display:flex;flex-wrap:wrap;gap:.4rem}
.tags button{border:1px solid #ccc;background:#fafafa;padding:.4rem .8rem;border-radius:999px;cursor:pointer;font-size:.85rem}
.tags button.active,
.tags button:hover{background:#111;color:#fff}
</style>

<script>
(() => {
  const grid=document.querySelector('.posts-grid');
  if(!grid) return;
  const cards=[...grid.children];

  /* ---------- Month dropdown ---------- */
  const monthSel=document.getElementById('month-select');
  if(monthSel){
    const months=[...new Set(cards.map(c=>c.dataset.month))].sort().reverse();
    months.forEach(m=>{
      const opt=document.createElement('option');
      opt.value=m;
      opt.textContent=new Date(m+'-01').toLocaleString(undefined,{month:'long',year:'numeric'});
      monthSel.appendChild(opt);
    });
  }

  /* ---------- Filter state ---------- */
  const state={tag:'all',author:'all',month:'all',search:''};
  const apply=()=>{
    cards.forEach(c=>{
      let show=true;
      if(state.tag!=='all')   show&&=c.dataset.tags.split(',').includes(state.tag);
      if(state.author!=='all')show&&=c.dataset.author===state.author;
      if(state.month!=='all') show&&=c.dataset.month===state.month;
      if(state.search){
        const hay=(c.dataset.title+' '+c.dataset.excerpt).toLowerCase();
        show&&=hay.includes(state.search);
      }
      c.style.display=show?'':'none';
    });
  };

  /* ---------- Sorting ---------- */
  const sorter=document.getElementById('sort-select');
  const sort=(dir)=>{
    cards.sort((a,b)=>{
      const A=+a.dataset.published,B=+b.dataset.published;
      return dir==='asc'?A-B:B-A;
    }).forEach(c=>grid.appendChild(c));
  };
  sort(grid.dataset.sort||'desc');
  sorter?.addEventListener('change',e=>sort(e.target.value));

  /* ---------- Tag filter ---------- */
  const tagWrap=document.getElementById('tag-filter');
  tagWrap?.addEventListener('click',e=>{
    if(e.target.tagName!=='BUTTON')return;
    state.tag=e.target.dataset.tag;
    tagWrap.querySelectorAll('button').forEach(b=>b.classList.toggle('active',b===e.target));
    apply();
  });

  /* ---------- Author filter ---------- */
  document.getElementById('author-select')?.addEventListener('change',e=>{
    state.author=e.target.value;apply();
  });

  /* ---------- Month filter ---------- */
  monthSel?.addEventListener('change',e=>{
    state.month=e.target.value;apply();
  });

  /* ---------- Search filter ---------- */
  document.getElementById('post-search')?.addEventListener('input',e=>{
    state.search=e.target.value.trim().toLowerCase();apply();
  });
})();
</script>

{% schema %}
{
  "name": "Blog Grid with Sidebar",
  "tag": "section",
  "settings": [
    { "type": "blog", "id": "blog", "label": "Blog" },

    { "type": "range", "id": "posts_limit", "label": "Number of posts shown", "min": 3, "max": 24, "step": 3, "default": 9 },
    { "type": "range", "id": "columns_desktop", "label": "Posts per row (desktop)", "min": 1, "max": 6, "step": 1, "default": 3 },

    { "type": "select", "id": "sort_order", "label": "Default sort order", "options": [
        { "value": "desc", "label": "Newest first" },
        { "value": "asc",  "label": "Oldest first" }
      ], "default": "desc" },

    { "type": "text", "id": "read_more_label", "label": "Read‑more link label", "default": "Read more" },

    { "type": "checkbox", "id": "show_sidebar", "label": "Show sidebar", "default": true },
    { "type": "range", "id": "sidebar_width", "label": "Sidebar width (%)", "min": 1, "max": 40, "step": 1, "default": 20 },

    { "type": "range", "id": "padding_vertical", "label": "Vertical padding (px)", "min": 0, "max": 100, "step": 4, "default": 40 },
    { "type": "range", "id": "padding_horizontal", "label": "Horizontal padding (px)", "min": 0, "max": 100, "step": 4, "default": 40 },
    { "type": "range", "id": "gap_size", "label": "Grid gap (px)", "min": 0, "max": 64, "step": 4, "default": 32 },

    { "type": "checkbox", "id": "enable_search", "label": "Enable search filter", "default": true },
    { "type": "checkbox", "id": "enable_author_filter", "label": "Enable author filter", "default": false },
    { "type": "checkbox", "id": "enable_month_filter", "label": "Enable month filter", "default": false }
  ],
  "presets": [
    { "name": "Blog grid w/ sidebar" }
  ]
}
{% endschema %}
