{{ 'customer.aio.min.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .luxury-customer-auth-wrap {
    min-height: 80vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--luxury-bg, #FBF9F5);
    padding: clamp(3rem, 6vw, 6rem) 1.5rem;
  }

  .luxury-customer-card {
    width: 100%;
    max-width: 500px;
    background: #FFFFFF;
    border: 1px solid var(--luxury-border-light, #EFEAE3);
    border-radius: 2px;
    box-shadow: 0 16px 45px rgba(0, 0, 0, 0.05);
    padding: clamp(2.5rem, 5vw, 3.8rem);
    text-align: center;
  }

  .luxury-customer-card h1 {
    font-family: var(--luxury-font-heading, 'Cormorant Garamond', serif);
    font-size: clamp(2rem, 3.5vw, 2.6rem);
    font-weight: 400;
    color: #1E1E1E;
    margin: 0 0 0.8rem;
    line-height: 1.15;
  }

  .luxury-customer-card p {
    font-family: var(--luxury-font-body, 'Jost', sans-serif);
    font-size: 0.92rem;
    color: #6E6862;
    margin-bottom: 2.2rem;
    line-height: 1.6;
  }

  .luxury-auth-field {
    position: relative;
    margin-bottom: 1.3rem;
    text-align: left;
  }

  .luxury-auth-input {
    width: 100%;
    padding: 1.05rem 1.2rem;
    border: 1.5px solid #D9D2C7;
    border-radius: 2px;
    font-family: var(--luxury-font-body, 'Jost', sans-serif);
    font-size: 0.95rem;
    color: #1E1E1E;
    background: transparent;
    outline: none;
    transition: border-color 0.25s ease;
  }

  .luxury-auth-input:focus {
    border-color: #1E1E1E;
  }

  .luxury-password-toggle-wrap {
    position: relative;
  }

  .luxury-password-toggle-btn {
    position: absolute;
    top: 50%;
    right: 14px;
    transform: translateY(-50%);
    background: none;
    border: none;
    cursor: pointer;
    color: #7A746E;
    padding: 4px;
  }

  .luxury-auth-btn {
    width: 100%;
    background: #1E1E1E;
    color: #FFFFFF !important;
    border: 1px solid #1E1E1E;
    font-family: var(--luxury-font-body, 'Jost', sans-serif);
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    padding: 1.1rem;
    border-radius: 2px;
    cursor: pointer;
    margin-top: 0.8rem;
    transition: background 0.3s, transform 0.2s;
  }

  .luxury-auth-btn:hover {
    background: #9E583A;
    border-color: #9E583A;
    transform: translateY(-2px);
  }
{%- endstyle -%}

<div class="luxury-customer-auth-wrap">
  <div class="luxury-customer-card">
    <span class="editorial-eyebrow">Patron Invitation</span>
    <h1>Create Account</h1>
    <p>Join our circle to access bespoke loom commissions, order archiving, and private previews.</p>

    {%- form 'create_customer', novalidate: 'novalidate' -%}
      {%- if form.errors -%}
        <div style="color: #C44D44; font-size: 0.88rem; margin-bottom: 1.2rem; text-align: left;">
          {{ form.errors | default_errors }}
        </div>
      {%- endif -%}

      <div class="luxury-auth-field">
        <input
          type="text"
          name="customer[first_name]"
          id="RegisterForm-FirstName"
          class="luxury-auth-input"
          {% if form.first_name %}value="{{ form.first_name }}"{% endif %}
          autocomplete="given-name"
          placeholder="First name"
          required
        >
      </div>

      <div class="luxury-auth-field">
        <input
          type="text"
          name="customer[last_name]"
          id="RegisterForm-LastName"
          class="luxury-auth-input"
          {% if form.last_name %}value="{{ form.last_name }}"{% endif %}
          autocomplete="family-name"
          placeholder="Last name"
          required
        >
      </div>

      <div class="luxury-auth-field">
        <input
          type="email"
          name="customer[email]"
          id="RegisterForm-email"
          class="luxury-auth-input"
          {% if form.email %}value="{{ form.email }}"{% endif %}
          spellcheck="false"
          autocapitalize="off"
          autocomplete="email"
          placeholder="Email address"
          required
        >
      </div>

      <div class="luxury-auth-field luxury-password-toggle-wrap">
        <input
          type="password"
          name="customer[password]"
          id="RegisterForm-password"
          class="luxury-auth-input"
          autocomplete="new-password"
          placeholder="Password"
          required
        >
        <button
          type="button"
          class="luxury-password-toggle-btn"
          onclick="var p = document.getElementById('RegisterForm-password'); p.type = p.type === 'password' ? 'text' : 'password';"
          aria-label="Toggle password visibility"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
        </button>
      </div>

      <button type="submit" class="luxury-auth-btn button-shine">
        Create Sanctuary Account &rarr;
      </button>

      <div style="margin-top: 1.8rem; padding-top: 1.4rem; border-top: 1px solid #EFEAE3; font-size: 0.88rem;">
        <span style="color: #6E6862;">Already a patron?</span>
        <a href="{{ routes.account_login_url }}" style="color: #9E583A; font-weight: 600; text-decoration: underline; margin-left: 0.3rem;">
          Sign In
        </a>
      </div>
    {%- endform -%}
  </div>
</div>

{% schema %}
{
  "name": "Customer Register",
  "settings": []
}
{% endschema %}
