{%- style -%}
  #LuxuryBrandStory-{{ section.id }} {
    padding-top: {{ section.settings.padding_top | default: 100 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 100 }}px;
    background-color: {{ section.settings.background_color | default: '#FFFFFF' }};
    overflow: hidden;
  }

  .luxury-brand-story__wrapper {
    display: flex;
    flex-direction: column;
    gap: clamp(3rem, 6vw, 6rem);
    align-items: center;
  }

  @media screen and (min-width: 990px) {
    .luxury-brand-story__wrapper {
      flex-direction: {% if section.settings.layout == 'image_second' %}row-reverse{% else %}row{% endif %};
    }

    .luxury-brand-story__col {
      flex: 1;
      width: 50%;
    }
  }

  /* Image Column with Decorative Offset Frame */
  .luxury-brand-story__image-container {
    position: relative;
    width: 100%;
    max-width: 560px;
    margin: 0 auto;
  }

  .luxury-brand-story__offset-frame {
    position: absolute;
    inset: {% if section.settings.layout == 'image_second' %}-24px -24px 24px 24px{% else %}-24px 24px 24px -24px{% endif %};
    border: 1px solid {{ section.settings.frame_color | default: '#E8E2D8' }};
    z-index: 1;
    pointer-events: none;
    transition: transform 0.6s var(--luxury-ease);
  }

  .luxury-brand-story__image-container:hover .luxury-brand-story__offset-frame {
    transform: translate({% if section.settings.layout == 'image_second' %}8px, -8px{% else %}-8px, -8px{% endif %});
  }

  .luxury-brand-story__image-box {
    position: relative;
    z-index: 2;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background-color: #F4EFEA;
    box-shadow: var(--luxury-shadow-lg, 0 16px 40px rgba(30, 30, 30, 0.08));
  }

  .luxury-brand-story__image-box img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.9s cubic-bezier(0.25, 1, 0.35, 1);
  }

  .luxury-brand-story__image-box:hover img {
    transform: scale(1.06);
  }

  /* Text Column */
  .luxury-brand-story__content {
    max-width: 540px;
    padding: clamp(0.5rem, 2vw, 2rem) 0;
  }

  .luxury-brand-story__eyebrow {
    font-family: var(--luxury-font-body, 'Jost', sans-serif);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--luxury-accent, #9E583A);
    margin-bottom: 1rem;
    display: block;
  }

  .luxury-brand-story__heading {
    font-family: var(--luxury-font-heading, 'Cormorant Garamond', serif);
    font-size: clamp(2.4rem, 4.2vw, 3.8rem);
    font-weight: 400;
    line-height: 1.12;
    color: var(--luxury-text, #1E1E1E);
    margin: 0 0 1.8rem;
    letter-spacing: -0.01em;
  }

  .luxury-brand-story__heading em {
    font-style: italic;
    font-weight: 300;
  }

  .luxury-brand-story__paragraph {
    font-family: var(--luxury-font-body, 'Jost', sans-serif);
    font-size: 1.05rem;
    line-height: 1.8;
    color: var(--luxury-text-muted, #6E6862);
    margin: 0 0 1.5rem;
  }

  .luxury-brand-story__cta-wrap {
    margin-top: 2rem;
  }

  .luxury-brand-story__link {
    font-family: var(--luxury-font-body);
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--luxury-text, #1E1E1E);
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    transition: color 0.3s ease;
  }

  .luxury-brand-story__link:hover {
    color: var(--luxury-accent, #9E583A);
  }

  .luxury-brand-story__link-arrow {
    display: inline-block;
    transition: transform 0.3s ease;
  }

  .luxury-brand-story__link:hover .luxury-brand-story__link-arrow {
    transform: translateX(6px);
  }
{%- endstyle -%}

<div class="luxury-brand-story-section" id="LuxuryBrandStory-{{ section.id }}">
  <div class="luxury-container">
    <div class="luxury-brand-story__wrapper">
      <!-- Media Column -->
      <div
        class="luxury-brand-story__col"
        data-aos="{% if section.settings.layout == 'image_second' %}fade-left{% else %}fade-right{% endif %}"
        data-aos-duration="1000"
      >
        <div class="luxury-brand-story__image-container">
          <div class="luxury-brand-story__offset-frame"></div>
          <div class="luxury-brand-story__image-box hover-zoom-container">
            {%- if section.settings.image != blank -%}
              {{ section.settings.image | image_url: width: 1400 | image_tag:
                loading: 'lazy',
                widths: '500, 800, 1100, 1400',
                alt: section.settings.heading | escape
              }}
            {%- else -%}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </div>
        </div>
      </div>

      <!-- Content Column -->
      <div
        class="luxury-brand-story__col"
        data-aos="{% if section.settings.layout == 'image_second' %}fade-right{% else %}fade-left{% endif %}"
        data-aos-duration="1000"
      >
        <div class="luxury-brand-story__content">
          {%- if section.settings.eyebrow != blank -%}
            <span class="luxury-brand-story__eyebrow">{{ section.settings.eyebrow | escape }}</span>
          {%- endif -%}

          {%- if section.settings.heading != blank -%}
            <h2 class="luxury-brand-story__heading">{{ section.settings.heading }}</h2>
          {%- endif -%}

          {%- if section.settings.paragraph_1 != blank -%}
            <p class="luxury-brand-story__paragraph">{{ section.settings.paragraph_1 }}</p>
          {%- endif -%}

          {%- if section.settings.paragraph_2 != blank -%}
            <p class="luxury-brand-story__paragraph">{{ section.settings.paragraph_2 }}</p>
          {%- endif -%}

          {%- if section.settings.link_label != blank -%}
            <div class="luxury-brand-story__cta-wrap">
              <a href="{{ section.settings.link_url | default: '#' }}" class="luxury-brand-story__link underline-slide">
                <span>{{ section.settings.link_label | escape }}</span>
                <span class="luxury-brand-story__link-arrow" aria-hidden="true">&rarr;</span>
              </a>
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Brand Story (Jaipur)",
  "tag": "section",
  "class": "section-luxury-brand-story",
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "Desktop Image Alignment",
      "options": [
        { "value": "image_first", "label": "Image on Left, Text on Right" },
        { "value": "image_second", "label": "Text on Left, Image on Right" }
      ],
      "default": "image_first"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Story Image (4:5 Portrait recommended)"
    },
    {
      "type": "color",
      "id": "frame_color",
      "label": "Offset Frame Color",
      "default": "#E8E2D8"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section Background",
      "default": "#FFFFFF"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "Our Philosophy & Craft"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Every Knot Holds <em>a Soulful Story</em>"
    },
    {
      "type": "textarea",
      "id": "paragraph_1",
      "label": "First Paragraph",
      "default": "Rooted in the timeless artisan hamlets of rural India, our carpets are more than decorative foundations. They are living archives of cultural memory, hand-spun wool, and pure devotion."
    },
    {
      "type": "textarea",
      "id": "paragraph_2",
      "label": "Second Paragraph",
      "default": "By connecting master weavers directly with discerning homes across the world, we ensure fair livelihood, dignity, and generational preservation of hand-knotting craftsmanship."
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link CTA Label",
      "default": "Discover Our Heritage Journey"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Link CTA URL"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 40,
      "max": 160,
      "step": 10,
      "unit": "px",
      "label": "Padding Top",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 40,
      "max": 160,
      "step": 10,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 100
    }
  ],
  "presets": [
    {
      "name": "Brand Story (Jaipur)"
    }
  ]
}
{% endschema %}