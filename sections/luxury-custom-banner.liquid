{%- style -%}
  #LuxuryCustomBanner-{{ section.id }} {
    position: relative;
    padding: clamp(4rem, 9vw, 9rem) 1.5rem;
    overflow: hidden;
    background-color: #1C1B1A;
    background-image: url('{{ section.settings.bg_image | image_url: width: 2200 }}');
    background-attachment: {% if section.settings.enable_parallax %}fixed{% else %}scroll{% endif %};
    background-position: center center;
    background-size: cover;
    display: flex;
    align-items: center;
    justify-content: {{ section.settings.box_alignment | default: 'center' }};
  }

  .luxury-custom-banner__overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, {{ section.settings.overlay_opacity | divided_by: 100.0 | default: 0.45 }});
    z-index: 1;
  }

  .luxury-custom-banner__card {
    position: relative;
    z-index: 2;
    max-width: 680px;
    width: 100%;
    background: {{ section.settings.card_bg | default: '#FBF9F5' }};
    color: var(--luxury-text, #1E1E1E);
    padding: clamp(2.5rem, 5vw, 4.5rem) clamp(2rem, 5vw, 4rem);
    border-radius: var(--luxury-radius-sm, 2px);
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.25);
    text-align: {{ section.settings.text_alignment | default: 'center' }};
  }

  .luxury-custom-banner__eyebrow {
    font-family: var(--luxury-font-body, 'Jost', sans-serif);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--luxury-accent, #9E583A);
    margin-bottom: 1rem;
    display: block;
  }

  .luxury-custom-banner__heading {
    font-family: var(--luxury-font-heading, 'Cormorant Garamond', serif);
    font-size: clamp(2.2rem, 4.2vw, 3.4rem);
    font-weight: 400;
    line-height: 1.15;
    margin: 0 0 1.2rem;
    color: var(--luxury-text, #1E1E1E);
  }

  .luxury-custom-banner__heading em {
    font-style: italic;
    font-weight: 300;
  }

  .luxury-custom-banner__desc {
    font-family: var(--luxury-font-body, 'Jost', sans-serif);
    font-size: 1.02rem;
    line-height: 1.7;
    color: var(--luxury-text-muted, #6E6862);
    margin: 0 0 2.2rem;
  }

  .luxury-custom-banner__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: var(--luxury-text, #1E1E1E);
    color: #FFFFFF !important;
    border: 1px solid var(--luxury-text, #1E1E1E);
    padding: 1.05rem 2.6rem;
    font-family: var(--luxury-font-body);
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    transition: all 0.4s var(--luxury-ease);
  }

  .luxury-custom-banner__btn:hover {
    background-color: var(--luxury-accent, #9E583A);
    border-color: var(--luxury-accent, #9E583A);
    color: #FFFFFF !important;
    transform: translateY(-2px);
    box-shadow: 0 6px 18px rgba(158, 88, 58, 0.3);
  }
{%- endstyle -%}

<div class="luxury-custom-banner-section" id="LuxuryCustomBanner-{{ section.id }}">
  <div class="luxury-custom-banner__overlay"></div>

  <div class="luxury-container" style="display: flex; justify-content: {{ section.settings.box_alignment | default: 'center' }}; width: 100%;">
    <div
      class="luxury-custom-banner__card"
      data-aos="fade-up"
      data-aos-duration="900"
    >
      {%- if section.settings.eyebrow != blank -%}
        <span class="luxury-custom-banner__eyebrow">{{ section.settings.eyebrow | escape }}</span>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="luxury-custom-banner__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}

      {%- if section.settings.description != blank -%}
        <p class="luxury-custom-banner__desc">{{ section.settings.description }}</p>
      {%- endif -%}

      {%- if section.settings.button_label != blank -%}
        <a
          href="{{ section.settings.button_link | default: '#' }}"
          class="luxury-custom-banner__btn button-shine"
        >
          {{ section.settings.button_label | escape }}
        </a>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Custom Rug Banner (Jaipur)",
  "tag": "section",
  "class": "section-luxury-custom-banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Parallax Background Lifestyle Image"
    },
    {
      "type": "checkbox",
      "id": "enable_parallax",
      "label": "Enable Fixed Parallax Effect",
      "default": true
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 10,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "Dark Image Overlay",
      "default": 45
    },
    {
      "type": "select",
      "id": "box_alignment",
      "label": "Card Position",
      "options": [
        { "value": "flex-start", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "flex-end", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "center"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card Background Color",
      "default": "#FBF9F5"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "Bespoke Artisanal Program"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Your Vision, <em>Custom Woven</em>"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Commission an exclusive one-of-a-kind rug tailored to your architectural dimensions, yarn composition, and personalized palette. Hand-knotted specifically for your interior."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "CTA Button Label",
      "default": "Consult Our Design Atelier"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "CTA Button Link"
    }
  ],
  "presets": [
    {
      "name": "Custom Rug Banner (Jaipur)"
    }
  ]
}
{% endschema %}