<div class="luxury-contact-banner">
  <div class="luxury-container">
    {% render 'breadcrumbs' %}
    <span class="editorial-eyebrow" data-aos="fade-up">{{ section.settings.eyebrow | default: 'Concierge & Stylists' }}</span>
    <h1 class="editorial-heading luxury-contact-banner__title" data-aos="fade-up" data-aos-delay="100">
      {{ section.settings.heading | default: 'Begin Your Bespoke Conversation' }}
    </h1>
    {%- if section.settings.subheading != blank -%}
      <p class="editorial-subtext luxury-contact-banner__sub" data-aos="fade-up" data-aos-delay="200">
        {{ section.settings.subheading }}
      </p>
    {%- endif -%}
  </div>
</div>

<style>
  .luxury-contact-banner {
    background-color: var(--luxury-bg-alt, #F4EFE6);
    padding: 3.5rem 0 3rem;
    border-bottom: 1px solid var(--luxury-border-light, #EFEAE3);
    text-align: center;
  }
  .luxury-contact-banner .luxury-breadcrumbs {
    padding: 0 0 1.25rem;
  }
  .luxury-contact-banner .luxury-breadcrumbs__list {
    justify-content: center;
  }
  .luxury-contact-banner__title {
    font-size: clamp(2.2rem, 4.2vw, 3.8rem);
    color: var(--luxury-text, #1E1E1E);
    margin: 0.4rem 0 1rem;
    line-height: 1.15;
  }
  .luxury-contact-banner__sub {
    margin: 0 auto;
    font-size: 1.05rem;
    line-height: 1.7;
    max-width: 680px;
    color: var(--luxury-text-muted, #6E6862);
  }
</style>

{% schema %}
{
  "name": "Contact — Banner",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Concierge & Stylists"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Begin Your Bespoke Conversation"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Whether you desire custom loom dimensions, styling consultations, or artisan provenance inquiries, our curatorial team is at your service."
    }
  ]
}
{% endschema %}
