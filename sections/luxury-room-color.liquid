{%- style -%}
  #LuxuryRoomColor-{{ section.id }} {
    padding-top: {{ section.settings.padding_top | default: 90 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 90 }}px;
    background-color: {{ section.settings.background_color | default: '#FBF9F5' }};
  }

  .luxury-room-color__header {
    text-align: center;
    max-width: 700px;
    margin: 0 auto clamp(2.5rem, 5vw, 4rem);
  }

  .luxury-room-color__eyebrow {
    font-family: var(--luxury-font-body, 'Jost', sans-serif);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--luxury-accent, #9E583A);
    margin-bottom: 0.8rem;
    display: block;
  }

  .luxury-room-color__heading {
    font-family: var(--luxury-font-heading, 'Cormorant Garamond', serif);
    font-size: clamp(2.2rem, 4vw, 3.6rem);
    font-weight: 400;
    letter-spacing: -0.01em;
    color: var(--luxury-text, #1E1E1E);
    margin: 0 0 1rem;
  }

  .luxury-room-color__subtext {
    font-family: var(--luxury-font-body, 'Jost', sans-serif);
    font-size: 1rem;
    color: var(--luxury-text-muted, #6E6862);
    line-height: 1.6;
    margin: 0 auto;
  }

  /* Masonry Room Tiles Grid */
  .luxury-room-tiles {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
    margin-bottom: clamp(3.5rem, 7vw, 6rem);
  }

  @media screen and (min-width: 990px) {
    .luxury-room-tiles {
      grid-template-columns: repeat(12, 1fr);
      gap: 2rem;
    }

    .luxury-room-tile--large {
      grid-column: span 7;
      min-height: 440px;
    }

    .luxury-room-tile--medium {
      grid-column: span 5;
      min-height: 440px;
    }

    .luxury-room-tile--small {
      grid-column: span 4;
      min-height: 380px;
    }
  }

  .luxury-room-tile {
    position: relative;
    border-radius: var(--luxury-radius-sm, 2px);
    overflow: hidden;
    text-decoration: none;
    color: #FFFFFF;
    display: flex;
    align-items: flex-end;
    padding: clamp(1.5rem, 3vw, 2.5rem);
    min-height: 280px;
  }

  .luxury-room-tile__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.85s cubic-bezier(0.25, 1, 0.35, 1);
  }

  .luxury-room-tile:hover .luxury-room-tile__bg {
    transform: scale(1.08);
  }

  .luxury-room-tile__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(0, 0, 0, 0.1) 0%,
      rgba(0, 0, 0, 0.65) 100%
    );
    transition: background 0.4s ease;
  }

  .luxury-room-tile:hover .luxury-room-tile__overlay {
    background: linear-gradient(
      180deg,
      rgba(0, 0, 0, 0.15) 0%,
      rgba(0, 0, 0, 0.75) 100%
    );
  }

  .luxury-room-tile__content {
    position: relative;
    z-index: 2;
    width: 100%;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
  }

  .luxury-room-tile__title {
    font-family: var(--luxury-font-heading, 'Cormorant Garamond', serif);
    font-size: clamp(1.5rem, 2.4vw, 2.2rem);
    font-weight: 500;
    margin: 0;
    line-height: 1.15;
    color: #FFFFFF;
  }

  .luxury-room-tile__cta {
    font-family: var(--luxury-font-body);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #FFFFFF;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    opacity: 0.9;
    transform: translateX(0);
    transition: transform 0.3s ease, opacity 0.3s ease;
  }

  .luxury-room-tile:hover .luxury-room-tile__cta {
    transform: translateX(5px);
    opacity: 1;
  }

  /* Color Swatches Grid */
  .luxury-color-swatches-section {
    padding-top: 2rem;
    border-top: 1px solid var(--luxury-border-light, #F0ECE4);
    text-align: center;
  }

  .luxury-color-swatches__title {
    font-family: var(--luxury-font-heading);
    font-size: clamp(1.8rem, 2.5vw, 2.5rem);
    margin: 0 0 0.5rem;
    color: var(--luxury-text);
  }

  .luxury-color-swatches__subtext {
    font-family: var(--luxury-font-body);
    font-size: 0.95rem;
    color: var(--luxury-text-muted);
    margin: 0 auto 2.5rem;
    max-width: 500px;
  }

  .luxury-color-swatches-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 2rem clamp(1.2rem, 3.5vw, 2.8rem);
  }

  .luxury-color-swatch-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-decoration: none;
    color: inherit;
    gap: 0.75rem;
    group: swatch;
  }

  .luxury-color-swatch-circle {
    width: clamp(54px, 7vw, 76px);
    height: clamp(54px, 7vw, 76px);
    border-radius: 50%;
    position: relative;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.08);
    transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275), box-shadow 0.4s ease;
    border: 3px solid #FFFFFF;
    outline: 1px solid var(--luxury-border, #E8E2D8);
  }

  .luxury-color-swatch-item:hover .luxury-color-swatch-circle {
    transform: scale(1.18);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.16);
    outline-color: var(--luxury-accent, #9E583A);
  }

  .luxury-color-swatch-label {
    font-family: var(--luxury-font-body);
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    color: var(--luxury-text-muted);
    transition: color 0.3s ease, transform 0.3s ease;
  }

  .luxury-color-swatch-item:hover .luxury-color-swatch-label {
    color: var(--luxury-text);
    transform: translateY(2px);
  }
{%- endstyle -%}

<div class="luxury-room-color-section" id="LuxuryRoomColor-{{ section.id }}">
  <div class="luxury-container">
    {%- if section.settings.heading != blank or section.settings.eyebrow != blank -%}
      <div class="luxury-room-color__header" data-aos="fade-up">
        {%- if section.settings.eyebrow != blank -%}
          <span class="luxury-room-color__eyebrow">{{ section.settings.eyebrow | escape }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="luxury-room-color__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.subtext != blank -%}
          <p class="luxury-room-color__subtext">{{ section.settings.subtext }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <!-- Room Masonry Tiles -->
    <div class="luxury-room-tiles">
      {%- for block in section.blocks -%}
        {%- if block.type == 'room_tile' -%}
          {%- assign mod_index = forloop.index | modulo: 3 -%}
          {%- assign tile_class = 'luxury-room-tile--small' -%}
          {%- if mod_index == 1 -%}
            {%- assign tile_class = 'luxury-room-tile--large' -%}
          {%- elsif mod_index == 2 -%}
            {%- assign tile_class = 'luxury-room-tile--medium' -%}
          {%- endif -%}

          <a
            href="{{ block.settings.link | default: '#' }}"
            class="luxury-room-tile {{ tile_class }}"
            data-aos="zoom-in"
            data-aos-delay="{{ forloop.index0 | times: 100 }}"
            {{ block.shopify_attributes }}
          >
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 1200 | image_tag:
                loading: 'lazy',
                widths: '500, 800, 1200',
                class: 'luxury-room-tile__bg',
                alt: block.settings.title | escape
              }}
            {%- else -%}
              {%- assign placeholder_index = forloop.index | modulo: 6 | plus: 1 -%}
              {{ 'lifestyle-' | append: placeholder_index | placeholder_svg_tag: 'placeholder-svg luxury-room-tile__bg' }}
            {%- endif -%}

            <div class="luxury-room-tile__overlay"></div>

            <div class="luxury-room-tile__content">
              <h3 class="luxury-room-tile__title">{{ block.settings.title | escape }}</h3>
              <span class="luxury-room-tile__cta">
                <span>View Rugs</span>
                <span aria-hidden="true">&rarr;</span>
              </span>
            </div>
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <!-- Color Swatches Row -->
    {%- if section.settings.show_color_swatches -%}
      <div class="luxury-color-swatches-section" data-aos="fade-up">
        {%- if section.settings.swatches_heading != blank -%}
          <h3 class="luxury-color-swatches__title">{{ section.settings.swatches_heading }}</h3>
        {%- endif -%}
        {%- if section.settings.swatches_subtext != blank -%}
          <p class="luxury-color-swatches__subtext">{{ section.settings.swatches_subtext }}</p>
        {%- endif -%}

        <div class="luxury-color-swatches-grid">
          {%- for block in section.blocks -%}
            {%- if block.type == 'color_swatch' -%}
              <a
                href="{{ block.settings.link | default: '#' }}"
                class="luxury-color-swatch-item"
                data-aos="zoom-in"
                data-aos-delay="{{ forloop.index0 | times: 80 }}"
                {{ block.shopify_attributes }}
              >
                <div
                  class="luxury-color-swatch-circle"
                  style="background-color: {{ block.settings.color_hex | default: '#C2A26F' }};{% if block.settings.swatch_image != blank %} background-image: url('{{ block.settings.swatch_image | image_url: width: 120 }}'); background-size: cover;{% endif %}"
                ></div>
                <span class="luxury-color-swatch-label">{{ block.settings.color_name | escape }}</span>
              </a>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
