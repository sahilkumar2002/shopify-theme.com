          { img: "https://cdn.shopify.com/s/files/1/0648/2188/7176/files/Queen_Bed.avif?v=1774499839", title: "Queen Bed", desc: "An 8'x10' rug covers a queen bed and nightstands, with 3' of rug on either side of the bed, while a 6'x9' rug gives an 18 border on each side.", link: "#" },
