        cards: [
          { img: "https://cdn.shopify.com/s/files/1/0648/2188/7176/files/Single_Door.avif?v=1774502799", title: "Single Door", desc: "Our standard doormats are 2’x3’x0.5’, making them ideal for apartments, single front doors, and entryways between 3’ to 5’ wide. ", link: "#" },
          { img: "https://cdn.shopify.com/s/files/1/0648/2188/7176/files/Double_Door.avif?v=1774502799", title: "Double Door", desc: "At 2.5'x4.5’x0.5’, our estate doormats are a perfect size for double doors, as well as patios and porches wider than 6’.", link: "#" },
          { img: "https://cdn.shopify.com/s/files/1/0648/2188/7176/files/Layering.avif?v=1774502799", title: "Layering", desc: "Layer our standard-sized doormat on top of a 3’x5’ outdoor rug for extra coverage and cozy style.", link: "#" }
        ]
      },

      {
        title: "Outdoor Rugs",
