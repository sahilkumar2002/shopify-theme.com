          { img: "https://cdn.shopify.com/s/files/1/0648/2188/7176/files/7.avif?v=1774271657", title: "10'x14' Rugs", desc: "A 10’x14’ rug fits in a large room that is at least 11.5’x15.5’— allowing 18” to 36” of visible floor space between the perimeter of the rug and the wall. Pro Tip: Make sure all major furniture pieces are touching the rug.", link: "https://indianrugstore.com/collections/all-products?filter.v.option.size=10%27x14%27&filter.v.price.gte=&filter.v.price.lte=&sort_by=best-selling" } ,        

          { img: "https://cdn.shopify.com/s/files/1/0648/2188/7176/files/1.avif?v=1774271657", title: "9'x12' Rugs", desc: "A 9'x12' rug fits perfectly in a 12'x18' or larger living room, or in an open floor plan space. This rug should be large enough to accommodate most of your furniture, accessories, and decor elements, giving your space a more unified look.", link: "https://indianrugstore.com/collections/9x12" } ,        

          { img: "https://cdn.shopify.com/s/files/1/0648/2188/7176/files/3.avif?v=1774271657", title: "8'x10' Rugs", desc: "An 8'x10' rug fits nicely in an 11'x13' or slightly larger room, or in an open floor plan space. In a defined living area, the best layout leaves a 12” to 18 layout leaves a 12” to 18 border of flooring around your rug.  ", link: "https://indianrugstore.com/collections/8x10" },
          { img: "https://cdn.shopify.com/s/files/1/0648/2188/7176/files/4.avif?v=1774271657", title: "6'x9' Rugs", desc: "A 6'x9' rug works best in an 11'x13' or smaller living room. This leaves about 2' of flooring bordering the rug on each side.", link: "https://indianrugstore.com/collections/6x9" },
          { img: "https://cdn.shopify.com/s/files/1/0648/2188/7176/files/5.avif?v=1774271657", title: "5'x8' Rugs", desc: "In a small living room, a 5'x7' rug will fit underneath a coffee table, or in front of a fireplace with two comfy chairs sitting almost completely on the rug.", link: "https://indianrugstore.com/collections/5x8" },
