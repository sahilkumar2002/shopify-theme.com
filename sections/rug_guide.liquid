          { img: "https://cdn.shopify.com/s/files/1/0648/2188/7176/files/Large_Kitchen.avif?v=1774500562", title: "Large Kitchen", desc: "A larger kitchen can most likely handle a 4'x6' or 5'x7' rug. If you have a kitchen island, position a 3'x5', 4'x6', 5'x7', or runner rug under the island’s casters or flanking the sides.", link: "#" },
          { img: "https://cdn.shopify.com/s/files/1/0648/2188/7176/files/Galley_Kitchen.avif?v=1774500561", title: "Galley Kitchen", desc: "For a long, galley-style kitchen, a 2.5’x7’, 2.5’x10’, or 2.5'x12' runner rug along the sink side of the kitchen works best. If the galley is more narrow, position the runner in the center of the kitchen.", link: "#" },
          { img: "https://cdn.shopify.com/s/files/1/0648/2188/7176/files/Island_Kitchen.avif?v=1774500562", title: "Island Kitchen", desc: "Depending on your layout, a smaller 3'x5' or 4'x6' rug in front of the sink, may work best.", link: "#" },
          { img: "https://cdn.shopify.com/s/files/1/0648/2188/7176/files/C_or_L_Shaped_Kitchen.avif?v=1774500561", title: "C or L Shaped Kitchen", desc: "A small kitchen can easily feel cluttered. Depending on your layout, opt for a 2'x3' or 3'x5' rug in front of the sink.", link: "#" }

        ]
      },

      {
        title: "Dining Room Rugs",
        desc: "A good rule of thumb is to select a rug that's four feet longer and wider than your dining table. For ideal comfort and flow, your rug should be large enough for all dining chairs to sit entirely on the rug, even when pulled out.",
        btn: "SHOP Dining Room Rugs",
        img: "https://cdn.shopify.com/s/files/1/0648/2188/7176/files/DiningRoom.avif?v=1774441450",
        cards: [
          { img: "https://cdn.shopify.com/s/files/1/0648/2188/7176/files/Large_Table_8.avif?v=1774501145", title: "Large Table (8+)", desc: "A table for eight or more fits best on a 9'x12' or 10'x14' rug, offering enough room for all chairs to be on the rug when seated.", link: "#" },
          { img: "https://cdn.shopify.com/s/files/1/0648/2188/7176/files/Medium_Table_6.avif?v=1774501145", title: "Medium Table (6)", desc: "A table for six fits best on an 8'x10' or 6'x9' rug. This leaves room on all sides for the dining chairs to be moved easily while staying on the rug.", link: "#" },
          { img: "https://cdn.shopify.com/s/files/1/0648/2188/7176/files/Small_Table_4.avif?v=1774501144", title: "Small Table (4)", desc: "A table for four fits best on an 8' round rug. You can also float the table and chairs in the center of a 6'x9' rug.", link: "#" }
        ]
      },

      {
        title: "Bathroom Rugs",
        desc: "Don’t overlook your bathroom style. While these small spaces are ruled by their fixtures, choosing the correct rug size can bring cohesion and help avoid slippage. ",
        btn: "SHOP Bathroom Rugs",
        img: "https://cdn.shopify.com/s/files/1/0648/2188/7176/files/Bathroom.avif?v=1774441449",
        cards: [
          { img: "https://cdn.shopify.com/s/files/1/0648/2188/7176/files/Single_Vanity.avif?v=1774502215", title: "Single Vanity", desc: "Our bath mats (or 2’x3’ rugs) can be easily placed in powder rooms and bathrooms, at the base of toilets or beneath single and pedestal sinks. ", link: "#" },
          { img: "https://cdn.shopify.com/s/files/1/0648/2188/7176/files/Double_Vanity.avif?v=1774502216", title: "Double Vanity", desc: "For double sinks, opt for side-by-side 22x32” bath mats. Depending on your layout, a small 2’x3’ rug or runner can be used for seamless comfort.", link: "#" },
