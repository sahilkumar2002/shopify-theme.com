<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Dynamic Slider + Section</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      background: #ffffff;
      margin: 0px;

    }

    #rugFaqSection_v1 {
      background: #f3f3f3;
      padding: 60px 20px;
    }

    .rugFaqContainer_v1 {
      max-width: 800px;
      margin: 0 auto;
      background: #ffffff;
      padding: 40px;
    }

    .rugFaqTitle_v1 {
      font-size: 22px;
      margin-bottom: 25px;
    }

    .rugFaqItem_v1 {
      border-bottom: 1px solid #dcdcdc;
    }

    .rugFaqQuestion_v1 {
      width: 100%;
      background: none;
      border: none;
      padding: 18px 0;
      text-align: left;
      font-size: 15px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      cursor: pointer;
    }

    .rugFaqIcon_v1 {
      font-size: 18px;
      transition: transform 0.3s ease;
    }

    .rugFaqAnswer_v1 {
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.3s ease;
    }

    .rugFaqAnswer_v1 p {
      margin: 0 0 15px;
      font-size: 14px;
      color: #555;
    }

    .rugFaqItem_v1.active_v1 .rugFaqAnswer_v1 {
      max-height: 200px;
    }

    .rugFaqItem_v1.active_v1 .rugFaqIcon_v1 {
      transform: rotate(45deg);
    }

    #rugCompareSection_v1 {
      max-width: 1100px;
      margin: auto;
      font-family: Arial, sans-serif;
    }

    /* Top Layout */
    .rugCompare_topWrap_v1 {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 40px;
      margin-bottom: 30px;
    }

    .rugCompare_headingBox_v1 {
      flex: 1;
    }

    #rugCompare_heading_v1 {
      font-weight: 500;
      line-height: 1.4;
    }

    /* Products */
    .rugCompare_productsWrap_v1 {
      flex: 2;
      display: flex;
      justify-content: center;
      gap: 40px;
    }

    .rugCompare_productCard_v1 {
      text-align: center;
    }

    .rugCompare_productCard_v1 img {
      width: 200px;
      border-radius: 6px;
    }

    .rugCompare_productCard_v1 h3 {
      margin: 10px 0 5px;
    }

    .rugCompare_productCard_v1 p {
      font-size: 13px;
      color: #666;
    }

    /* Table */
    .rugCompare_table_v1 {
      width: 100%;
    }

    .rugCompare_row_v1 {
      display: grid;
      grid-template-columns: 1.2fr 1fr 1fr;
      align-items: center;
      padding: 20px;
      background: #f3f1ee;
      margin-bottom: 10px;
    }

    .rugCompare_label_v1 {
      text-align: left;
      font-size: 11px;
      letter-spacing: 1px;
      color: #777;
    }

    .rugCompare_cell_v1 {
      text-align: center;
      font-size: 14px;
    }

    .rugCompare_cell_v1 small {
      font-size: 12px;
      color: #777;
    }

    .rugCompare_icons_v1 div {
      margin: 5px 0;
    }

    /* Buttons */
    .rugCompare_btnWrap_v1 {
      text-align: center;
      margin-top: 25px;
    }

    .rugCompare_btn_v1 {
      padding: 12px 22px;
      margin: 10px;
      background: #8b4b2c;
      color: #fff;
      border: none;
      font-size: 13px;
      letter-spacing: 1px;
      cursor: pointer;
    }

    .rugCompare_btn_v1:hover {
      background: #6f3a21;
    }

    /* Mobile */
    @media (max-width: 768px) {
      .rugCompare_topWrap_v1 {
        flex-direction: column;
        text-align: center;
      }

      .rugCompare_headingBox_v1 {
        text-align: center;
      }

      .rugCompare_productsWrap_v1 {
        flex-direction: column;
      }

      .rugCompare_row_v1 {
        grid-template-columns: 1fr;
        text-align: center;
      }

      .rugCompare_label_v1 {
        margin-bottom: 10px;
      }
    }

    /* ===== SLIDER ===== */
    .slider-container {
      position: relative;
      overflow: hidden;
      padding: 40px;
      margin-right: 100px;
      margin-left: 100px;

    }

    .slider {
      display: flex;
      gap: 20px;
      overflow-x: auto;
      scroll-behavior: smooth;
      padding-bottom: 10px;
    }

    .slider::-webkit-scrollbar {
      display: none;
    }

    .card {
      min-width: 180px;
      background: #e9e6e2;
      border-radius: 10px;
      text-align: center;
      padding: 20px;
      position: relative;
      cursor: pointer;
      transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .card:hover {
      transform: translateY(-5px);
      box-shadow: 0 8px 20px rgba(0, 0, 0, 0.1);
    }



    .card img {
      width: 100%;
      height: 100px;
      object-fit: contain;
    }

    .card-title {
      margin-top: 10px;
      font-size: 14px;
      color: #333;
    }

    .underline {
      height: 4px;
      background: transparent;
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      transition: background 0.3s;
    }

    .card:hover .underline,
    .card.active .underline {
      background: #a0522d !important;
    }

    .nav-btn {
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      background: white;
      border: none;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
      cursor: pointer;
      width: 40px;
      height: 40px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 20;

    }

    .nav-left {
      left: 10px;
    }

    .nav-right {
      right: 10px;
    }

    /* ===== SECTION ===== */
    .section {
      display: flex;
      min-height: 60vh;
    }

    .left {
      width: 50%;
      padding: 80px;
      background: #eae6df;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }

    .left h1 {
      font-size: 48px;
      margin-bottom: 20px;
      color: #1f1f1f;
      font-family: Georgia, serif;
    }

    .left p {
      font-size: 16px;
      line-height: 1.6;
      color: #333;
      max-width: 500px;
      margin-bottom: 30px;
    }

    .btn {
      display: inline-block;
      padding: 15px 30px;
      background: #8b4a2f;
      color: #fff;
      text-decoration: none;
      font-weight: bold;
      letter-spacing: 1px;
      width: fit-content;
    }

    .right {
      width: 50%;
    }

    .right img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    @media (max-width: 900px) {
      .section {
        flex-direction: column;
      }

      .left,
      .right {
        width: 100%;
      }

      .left {
        padding: 40px;
      }

      .left h1 {
        font-size: 32px;
      }
    }
  </style>
</head>

<body>
<h1 style="font-family: Arial, sans-serif; font-size: 36px; text-align: center; color: #333;">Rug Size Guide</h1>
    <p style="font-family: Arial, sans-serif; font-size: 18px; text-align: center; color: #666;">Scroll to select your room:</p>
  <!-- SLIDER -->
  <div class="slider-container">
    <button class="nav-btn nav-left" onclick="scrollLeftBtn()">&#8592;</button>
    <div class="slider" id="slider"></div>
    <button class="nav-btn nav-right" onclick="scrollRightBtn()">&#8594;</button>
  </div>

  <!-- SECTION -->
  <section class="section">
    <div class="left">
      <h1 id="title"></h1>
      <p id="desc"></p>
      <a href="https://indianrugstore.com/collections/all-products" class="btn" id="btnText"></a>
    </div>
    <div class="right">
      <img id="mainImage" src="" alt="Room">
    </div>
  </section>

  <script>

