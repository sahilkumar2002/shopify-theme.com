        btn: "SHOP Outdoor Rugs",
        img: "https://cdn.shopify.com/s/files/1/0648/2188/7176/files/Outdoor.avif?v=1774441451",
        cards: [
          { img: "https://cdn.shopify.com/s/files/1/0648/2188/7176/files/Small_Outdoor_Spaces.avif?v=1774503257", title: "Small Outdoor Spaces", desc: "For smaller spaces, a 3'x5' rug will fit nicely underneath a small patio table and two chairs. You can also opt for a 2'x3' doormat by the entryway for a more streamlined look.", link: "#" },
          { img: "https://cdn.shopify.com/s/files/1/0648/2188/7176/files/Medium_Outdoor_Spaces.avif?v=1774503258", title: "Medium Outdoor Spaces", desc: "For more spacious patios and decks with outdoor seating or dining sets, opt for a larger area rug in 5'x7', 6'x9', 8'x10', or 9'x12'. Choose a size that’s large enough to frame the furniture you want to highlight.", link: "#" },
          { img: "https://cdn.shopify.com/s/files/1/0648/2188/7176/files/Large_Outdoor_Spaces.avif?v=1774503257", title: "Large Outdoor Spaces", desc: "For more spacious patios and decks with outdoor seating or dining sets, opt for a larger area rug in 5'x7', 6'x9', 8'x10', or 9'x12'. Choose a size that’s large enough to frame the furniture you want to highlight.", link: "#" }
        ]
      }
    ];
    window.onload = function () {
      renderCards();

      // ✅ default first tab FULL load
      selectCard(0);
    };

    /* ================= SLIDER ================= */
    function renderCards() {
      slider.innerHTML = '';

      data.forEach((item, index) => {
        const card = document.createElement('div');
        card.className = 'card';

        // ✅ first tab active by default
        if (index === 0) card.classList.add('active');

        card.innerHTML = `
      <img src="${item.img}" />
      <div class="card-title">${item.title}</div>
      <div class="underline"></div>
    `;

        card.onclick = () => selectCard(index);
        slider.appendChild(card);
      });
    }

    /* ================= DYNAMIC RUG SECTION ================= */
    function renderSection(cards, btnText) {
      const container = document.getElementById('cardContainer');
      const btn = document.getElementById('sectionBtn');

      container.innerHTML = '';

      cards.forEach(item => {
        container.innerHTML += `
      <div>
        <img src="${item.img}" style="width:100%;" />
        <h3>${item.title}</h3>
        <p style="font-size:13px; color:#555;">${item.desc}</p>
        <a href="${item.link}" style="font-size:12px; letter-spacing:1px;">SHOP NOW</a>
      </div>
    `;
      });

      btn.innerText = btnText;
    }

    /* ================= MAIN SELECT FUNCTION ================= */
    function selectCard(index) {
      const cards = document.querySelectorAll('.card');

      cards.forEach(c => c.classList.remove('active'));
      cards[index].classList.add('active');

      const item = data[index];

      // Left section update
      document.getElementById('title').innerText = item.title;
      document.getElementById('desc').innerText = item.desc;
      document.getElementById('btnText').innerText = item.btn;
      document.getElementById('mainImage').src = item.img;

      // ✅ Dynamic rug section FULL update
      renderSection(item.cards, item.btn);
    }

    /* ================= SCROLL ================= */
    function scrollLeftBtn() {
      slider.scrollBy({ left: -200, behavior: 'smooth' });
    }

    function scrollRightBtn() {
      slider.scrollBy({ left: 200, behavior: 'smooth' });
    }

    /* ================= INIT ================= */
    renderCards();
    selectCard(0);

  </script>



  <section id="dynamicSection" style="padding:60px 40px;">
    <div id="cardContainer"
      style="display:grid; grid-template-columns:repeat(3,1fr); gap:40px; max-width:1100px; margin:auto;">
    </div>

    <div style="text-align:center; margin-top:40px;">
      <a href="https://indianrugstore.com/collections/all-products" id="sectionBtn"
        style="background:#8b4a2f; color:white; padding:15px 30px; text-decoration:none; font-weight:bold;">
      </a>
    </div>
  </section>


  <section id="rugCompareSection_v1">

    <!-- Top Section -->
    <div class="rugCompare_topWrap_v1">

      <div class="rugCompare_headingBox_v1">
        <h2 id="rugCompare_heading_v1">Compare Our All-in-One Rugs</h2>
      </div>

      <div class="rugCompare_productsWrap_v1">

        <div class="rugCompare_productCard_v1">
