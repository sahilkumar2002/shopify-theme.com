<div class="luxury-section-padding" style="background-color: var(--luxury-bg, #FBF9F5); min-height: 75vh;">
  <div class="luxury-container">
    <div style="text-align: center; margin-bottom: 3.5rem;">
      <span class="editorial-eyebrow">Curated Sanctuary</span>
      <h1 class="editorial-heading" style="font-size: clamp(2.4rem, 4.5vw, 4rem);">Your Treasured Pieces</h1>
      <p class="editorial-subtext" style="margin: 0 auto;">Personalized selection of handcrafted rugs and ancestral weaving heirlooms saved to your profile.</p>
    </div>

    <!-- Wishlist Grid Container -->
    <div id="LuxuryWishlistPageGrid" class="luxury-categories__grid" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
      <div style="grid-column: 1 / -1; text-align: center; padding: 4rem 0; color: #8C857B;">
        Loading your saved heirloom collection...
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    var container = document.getElementById('LuxuryWishlistPageGrid');
    if (!container) return;

    var storageKey = 'indianrugstore_wishlist_handles';
    var list = [];
    try {
      var raw = localStorage.getItem(storageKey);
      list = raw ? JSON.parse(raw) : [];
    } catch(e) {
      list = [];
    }

    if (!list || list.length === 0) {
      container.innerHTML = [
        '<div style="grid-column: 1 / -1; text-align: center; padding: 5rem 1.5rem;">',
        '  <svg style="width: 54px; height: 54px; stroke: #BDB6AD; fill: none; margin: 0 auto 1.5rem;" viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>',
        '  <h2 class="editorial-heading" style="font-size: 2rem;">No Saved Rugs Yet</h2>',
        '  <p class="editorial-subtext" style="margin: 0 auto 2.5rem;">Tap the heart icon on any handcrafted piece to curate your sanctuary list.</p>',
        '  <a href="/collections/all" class="luxury-btn luxury-btn--dark button-shine">Explore Collections</a>',
        '</div>'
      ].join('');
      return;
    }

    var promises = list.map(function(handle) {
      return fetch('/products/' + handle + '.js')
        .then(function(res) { return res.ok ? res.json() : null; })
        .catch(function() { return null; });
    });

    Promise.all(promises).then(function(products) {
      var valid = products.filter(Boolean);
      if (valid.length === 0) {
        container.innerHTML = '<div style="grid-column: 1 / -1; text-align: center; padding: 4rem 0;">No matching products found.</div>';
        return;
      }

      var html = '';
      valid.forEach(function(product) {
        var price = product.price ? '$' + (product.price / 100).toFixed(2) : '';
        var firstVariant = product.variants && product.variants[0] ? product.variants[0].id : '';

        html += [
          '<div class="luxury-category-card" style="background: #FFFFFF; padding: 1.2rem; border-radius: 2px; box-shadow: 0 4px 20px rgba(0,0,0,0.04); position: relative;">',
          '  <div class="luxury-category-card__media" style="aspect-ratio: 4 / 5;">',
          '    <img src="' + (product.featured_image || product.images[0]) + '" alt="' + product.title + '">',
          '    <button type="button" class="wishlist-toggle-btn is-saved" data-product-handle="' + product.handle + '" style="position: absolute; top: 12px; right: 12px; z-index: 4;">',
          '      <svg width="18" height="18" viewBox="0 0 24 24" fill="#C44D44" stroke="#C44D44"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>',
          '    </button>',
          '  </div>',
          '  <div style="padding-top: 1.2rem; text-align: left;">',
          '    <h3 class="luxury-category-card__title" style="font-size: 1.35rem;"><a href="' + product.url + '" style="color: inherit; text-decoration: none;">' + product.title + '</a></h3>',
          '    <div style="font-size: 1rem; font-weight: 500; color: #1E1E1E; margin: 0.4rem 0 1rem;">' + price + '</div>',
          '    <button type="button" class="luxury-btn luxury-btn--dark button-shine" style="width: 100%; padding: 0.85rem; font-size: 0.76rem;" onclick="window.addLuxuryCartItem(' + firstVariant + ', 1)">',
          '      + Add to Sanctuary Bag',
          '    </button>',
          '  </div>',
          '</div>'
        ].join('');
      });

      container.innerHTML = html;
    });
  });
</script>

{% schema %}
{
  "name": "Wishlist Page",
  "settings": []
}
{% endschema %}
