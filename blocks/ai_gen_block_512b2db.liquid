{% doc %}
  @prompt
    generate a section that have 5 images on desktop 3 on tablet and 1 on mobile
    and it scrolls inn automatic loop and i can customize its settings
    and make it fully customizable 
    that i can upload images, edit heading, section top bottom left right padding, margin, section width, colors, navigation etc., customizable image height and width, set only five images on desktop 
    and image width and height can be customizable min 0px , Generate a fully responsive Shopify section with an auto-scrolling infinite-loop image carousel.
    
    Requirements:
    
    * Display:
    
      * 5 images per row on desktop
      * 3 images per row on tablet
      * 1 image per row on mobile
    
    * Image Behavior:
    
      * All images must use `object-fit: contain`
      * Images should never crop
      * Maintain original image proportions
      * Customizable image width and height (minimum value: 0px)
    
    * Carousel Features:
    
      * Automatic infinite scrolling loop
      * Smooth continuous animation
      * Optional navigation arrows
      * Optional pagination dots
      * Pause on hover option
      * Adjustable autoplay speed
      * Fully responsive layout
    
    * Customization Settings (via Shopify schema):
    
      * Upload and manage multiple images
      * Editable section heading and subheading
      * Heading alignment
      * Section width control (full width / page width / custom width)
      * Adjustable image dimensions for desktop, tablet, and mobile
      * Section padding controls:
    
        * Top
        * Bottom
        * Left
        * Right
      * Section margin controls:
    
        * Top
        * Bottom
        * Left
        * Right
      * Background color customization
      * Text color customization
      * Navigation arrow color and size customization
      * Dot color customization
      * Gap/spacing between images
      * Border radius control for images
      * Optional image shadow
      * Optional hover zoom effect
    
    * Performance & Code Requirements:
    
      * Use clean HTML, CSS, Liquid, and JavaScript
      * Fully customizable through Shopify theme editor
      * Mobile optimized
      * Smooth scrolling without flickering
      * Properly structured schema settings
      * Include responsive breakpoints
      * Ensure exactly 5 visible images on desktop layout
      * Support unlimited image blocks
      * Use lazy loading for images
    
    * Deliver:
    
      * Complete Shopify section code
      * Full schema settings
      * Responsive CSS
      * JavaScript for infinite auto-scroll functionality
      * Well-structured and optimized code
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-infinite-carousel-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding-top: {{ block.settings.padding_top }}px;
    padding-bottom: {{ block.settings.padding_bottom }}px;
    padding-left: {{ block.settings.padding_left }}px;
    padding-right: {{ block.settings.padding_right }}px;
    margin-top: {{ block.settings.margin_top }}px;
    margin-bottom: {{ block.settings.margin_bottom }}px;
    margin-left: {{ block.settings.margin_left }}px;
    margin-right: {{ block.settings.margin_right }}px;
    background-color: {{ block.settings.background_color }};
    overflow: hidden;
  }

  .ai-infinite-carousel-inner-{{ ai_gen_id }} {
    {% if block.settings.section_width_type == 'full' %}
      max-width: 100%;
    {% elsif block.settings.section_width_type == 'page' %}
      max-width: 1300px;
    {% else %}
      max-width: {{ block.settings.custom_width }}px;
    {% endif %}
    margin: 0 auto;
  }

  .ai-infinite-carousel-header-{{ ai_gen_id }} {
    text-align: {{ block.settings.heading_alignment }};
    margin-bottom: {{ block.settings.heading_spacing }}px;
  }

  .ai-infinite-carousel-heading-{{ ai_gen_id }} {
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
    margin: 0 0 {{ block.settings.subheading_spacing }}px 0;
    line-height: 1.2;
  }

  .ai-infinite-carousel-subheading-{{ ai_gen_id }} {
    color: {{ block.settings.subheading_color }};
    font-size: {{ block.settings.subheading_size }}px;
    margin: 0;
    line-height: 1.4;
  }

  .ai-infinite-carousel-wrapper-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
  }

  .ai-infinite-carousel-track-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.image_gap }}px;
    width: fit-content;
  }

  .ai-infinite-carousel-slide-{{ ai_gen_id }} {
    flex-shrink: 0;
    border-radius: {{ block.settings.image_border_radius }}px;
    overflow: hidden;
    {% if block.settings.enable_image_shadow %}
      box-shadow: {{ block.settings.shadow_horizontal }}px {{ block.settings.shadow_vertical }}px {{ block.settings.shadow_blur }}px rgba(0, 0, 0, {{ block.settings.shadow_opacity }});
    {% endif %}
    transition: transform 0.3s ease;
  }

  {% if block.settings.enable_hover_zoom %}
    .ai-infinite-carousel-slide-{{ ai_gen_id }}:hover {
      transform: scale(1.05);
      z-index: 2;
    }
  {% endif %}

  .ai-infinite-carousel-slide-{{ ai_gen_id }} img {
    width: {{ block.settings.image_width_desktop }}px;
    height: {{ block.settings.image_height_desktop }}px;
    object-fit: contain;
    display: block;
  }

  .ai-infinite-carousel-placeholder-{{ ai_gen_id }} {
    width: {{ block.settings.image_width_desktop }}px;
    height: {{ block.settings.image_height_desktop }}px;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-infinite-carousel-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 200px;
    max-height: 200px;
  }

  .ai-infinite-carousel-navigation-{{ ai_gen_id }} {
    display: flex;
    justify-content: {{ block.settings.navigation_position }};
    align-items: center;
    gap: 16px;
    margin-top: {{ block.settings.navigation_spacing }}px;
  }

  .ai-infinite-carousel-nav-button-{{ ai_gen_id }} {
    background-color: {{ block.settings.arrow_bg_color }};
    color: {{ block.settings.arrow_color }};
    border: {{ block.settings.arrow_border_width }}px solid {{ block.settings.arrow_border_color }};
    border-radius: {{ block.settings.arrow_border_radius }}px;
    width: {{ block.settings.arrow_size }}px;
    height: {{ block.settings.arrow_size }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .ai-infinite-carousel-nav-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.arrow_hover_bg_color }};
    color: {{ block.settings.arrow_hover_color }};
  }

  .ai-infinite-carousel-nav-button-{{ ai_gen_id }} svg {
    width: calc({{ block.settings.arrow_size }}px * 0.5);
    height: calc({{ block.settings.arrow_size }}px * 0.5);
  }

  .ai-infinite-carousel-dots-{{ ai_gen_id }} {
    display: flex;
    gap: 8px;
  }

  .ai-infinite-carousel-dot-{{ ai_gen_id }} {
    width: {{ block.settings.dot_size }}px;
    height: {{ block.settings.dot_size }}px;
    border-radius: 50%;
    background-color: {{ block.settings.dot_color }};
    border: none;
    cursor: pointer;
    transition: background-color 0.3s ease;
  }

  .ai-infinite-carousel-dot-{{ ai_gen_id }}.active {
    background-color: {{ block.settings.dot_active_color }};
  }

  @media screen and (max-width: 989px) {
    .ai-infinite-carousel-slide-{{ ai_gen_id }} img,
    .ai-infinite-carousel-placeholder-{{ ai_gen_id }} {
      width: {{ block.settings.image_width_tablet }}px;
      height: {{ block.settings.image_height_tablet }}px;
    }

    .ai-infinite-carousel-heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.85);
    }

    .ai-infinite-carousel-subheading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.subheading_size }}px * 0.85);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-infinite-carousel-slide-{{ ai_gen_id }} img,
    .ai-infinite-carousel-placeholder-{{ ai_gen_id }} {
      width: {{ block.settings.image_width_mobile }}px;
      height: {{ block.settings.image_height_mobile }}px;
    }

    .ai-infinite-carousel-heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.7);
    }

    .ai-infinite-carousel-subheading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.subheading_size }}px * 0.7);
    }

    .ai-infinite-carousel-track-{{ ai_gen_id }} {
      gap: calc({{ block.settings.image_gap }}px * 0.7);
    }
  }
{% endstyle %}

<infinite-carousel-{{ ai_gen_id }} class="ai-infinite-carousel-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-infinite-carousel-inner-{{ ai_gen_id }}">
    {% if block.settings.heading != blank or block.settings.subheading != blank %}
      <div class="ai-infinite-carousel-header-{{ ai_gen_id }}">
        {% if block.settings.heading != blank %}
          <h2 class="ai-infinite-carousel-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
        {% endif %}
        {% if block.settings.subheading != blank %}
          <p class="ai-infinite-carousel-subheading-{{ ai_gen_id }}">{{ block.settings.subheading }}</p>
        {% endif %}
      </div>
    {% endif %}

    <div class="ai-infinite-carousel-wrapper-{{ ai_gen_id }}">
      <div class="ai-infinite-carousel-track-{{ ai_gen_id }}" data-carousel-track>
        {% for i in (1..20) %}
          {% liquid
            assign image_key = 'image_' | append: i
            assign image = block.settings[image_key]
          %}

          {% if image %}
            <div class="ai-infinite-carousel-slide-{{ ai_gen_id }}">
              <img
                src="{{ image | image_url: width: 1200 }}"
                alt="{{ image.alt | escape }}"
                loading="lazy"
                width="{{ image.width }}"
                height="{{ image.height }}"
              >
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>

    {% if block.settings.show_navigation %}
      <div class="ai-infinite-carousel-navigation-{{ ai_gen_id }}">
        <button
          class="ai-infinite-carousel-nav-button-{{ ai_gen_id }}"
          data-carousel-prev
          aria-label="Previous slide"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
        </button>

        {% if block.settings.show_dots %}
          <div class="ai-infinite-carousel-dots-{{ ai_gen_id }}" data-carousel-dots></div>
        {% endif %}

        <button
          class="ai-infinite-carousel-nav-button-{{ ai_gen_id }}"
          data-carousel-next
          aria-label="Next slide"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </button>
      </div>
    {% endif %}
  </div>
</infinite-carousel-{{ ai_gen_id }}>

<script>
  (function() {
    class InfiniteCarousel{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentPosition = 0;
        this.autoplayInterval = null;
        this.animationFrame = null;
        this.isPaused = false;
      }

      connectedCallback() {
        this.track = this.querySelector('[data-carousel-track]');
        this.slides = Array.from(this.querySelectorAll('.ai-infinite-carousel-slide-{{ ai_gen_id }}'));
        this.prevButton = this.querySelector('[data-carousel-prev]');
        this.nextButton = this.querySelector('[data-carousel-next]');
        this.dotsContainer = this.querySelector('[data-carousel-dots]');

        this.autoplayEnabled = {{ block.settings.enable_autoplay }};
        this.autoplaySpeed = {{ block.settings.autoplay_speed }};
        this.pauseOnHover = {{ block.settings.pause_on_hover }};

        if (this.slides.length === 0) return;

        this.cloneSlides();
        this.setupEventListeners();
        this.createDots();

        if (this.autoplayEnabled) {
          this.startInfiniteScroll();
        }

        if (this.pauseOnHover) {
          this.addEventListener('mouseenter', () => {
            this.isPaused = true;
          });

          this.addEventListener('mouseleave', () => {
            this.isPaused = false;
          });
        }
      }

      cloneSlides() {
        const slidesPerView = this.getSlidesPerView();
        const cloneCount = Math.max(slidesPerView * 2, this.slides.length);

        for (let i = 0; i < cloneCount; i++) {
          const clone = this.slides[i % this.slides.length].cloneNode(true);
          this.track.appendChild(clone);
        }

        for (let i = 0; i < cloneCount; i++) {
          const clone = this.slides[i % this.slides.length].cloneNode(true);
          this.track.insertBefore(clone, this.track.firstChild);
        }

        const slideWidth = this.slides[0].offsetWidth;
        const gap = this.getGap();
        this.currentPosition = -(cloneCount * (slideWidth + gap));
        this.track.style.transform = 'translateX(' + this.currentPosition + 'px)';
      }

      getSlidesPerView() {
        const width = window.innerWidth;
        if (width >= 990) return 5;
        if (width >= 750) return 3;
        return 1;
      }

      getGap() {
        const width = window.innerWidth;
        const baseGap = {{ block.settings.image_gap }};
        if (width <= 749) return baseGap * 0.7;
        return baseGap;
      }

      setupEventListeners() {
        if (this.prevButton) {
          this.prevButton.addEventListener('click', () => {
            this.isPaused = true;
            this.moveSlide(-1);
            setTimeout(() => {
              this.isPaused = false;
            }, 1000);
          });
        }

        if (this.nextButton) {
          this.nextButton.addEventListener('click', () => {
            this.isPaused = true;
            this.moveSlide(1);
            setTimeout(() => {
              this.isPaused = false;
            }, 1000);
          });
        }
      }

      createDots() {
        if (!this.dotsContainer) return;

        const totalDots = Math.min(this.slides.length, 10);

        for (let i = 0; i < totalDots; i++) {
          const dot = document.createElement('button');
          dot.className = 'ai-infinite-carousel-dot-{{ ai_gen_id }}';
          dot.setAttribute('aria-label', 'Go to slide ' + (i + 1));
          dot.addEventListener('click', () => {
            this.isPaused = true;
            this.goToSlide(i);
            setTimeout(() => {
              this.isPaused = false;
            }, 1000);
          });
          this.dotsContainer.appendChild(dot);
        }

        this.updateDots();
      }

      updateDots() {
        if (!this.dotsContainer) return;

        const dots = this.dotsContainer.querySelectorAll('.ai-infinite-carousel-dot-{{ ai_gen_id }}');
        const slideWidth = this.slides[0].offsetWidth;
        const gap = this.getGap();
        const currentIndex = Math.abs(Math.round(this.currentPosition / (slideWidth + gap))) % this.slides.length;

        dots.forEach((dot, index) => {
          if (index === currentIndex) {
            dot.classList.add('active');
          } else {
            dot.classList.remove('active');
          }
        });
      }

      startInfiniteScroll() {
        const animate = () => {
          if (!this.isPaused) {
            const slideWidth = this.slides[0].offsetWidth;
            const gap = this.getGap();
            const speed = this.autoplaySpeed;

            this.currentPosition -= speed;

            const totalSlides = this.track.children.length;
            const originalSlidesCount = this.slides.length;
            const resetPoint = -(originalSlidesCount * (slideWidth + gap) * 2);

            if (this.currentPosition <= resetPoint) {
              this.currentPosition = -(originalSlidesCount * (slideWidth + gap));
            }

            this.track.style.transform = 'translateX(' + this.currentPosition + 'px)';
            this.updateDots();
          }

          this.animationFrame = requestAnimationFrame(animate);
        };

        this.animationFrame = requestAnimationFrame(animate);
      }

      moveSlide(direction) {
        const slideWidth = this.slides[0].offsetWidth;
        const gap = this.getGap();
        const slidesPerView = this.getSlidesPerView();

        this.currentPosition -= direction * (slideWidth + gap) * slidesPerView;

        this.track.style.transition = 'transform 0.5s ease';
        this.track.style.transform = 'translateX(' + this.currentPosition + 'px)';

        setTimeout(() => {
          this.track.style.transition = '';
          this.checkReset();
          this.updateDots();
        }, 500);
      }

      goToSlide(index) {
        const slideWidth = this.slides[0].offsetWidth;
        const gap = this.getGap();
        const cloneCount = Math.max(this.getSlidesPerView() * 2, this.slides.length);

        this.currentPosition = -((cloneCount + index) * (slideWidth + gap));

        this.track.style.transition = 'transform 0.5s ease';
        this.track.style.transform = 'translateX(' + this.currentPosition + 'px)';

        setTimeout(() => {
          this.track.style.transition = '';
          this.updateDots();
        }, 500);
      }

      checkReset() {
        const slideWidth = this.slides[0].offsetWidth;
        const gap = this.getGap();
        const originalSlidesCount = this.slides.length;
        const cloneCount = Math.max(this.getSlidesPerView() * 2, this.slides.length);

        const resetPointRight = -(originalSlidesCount * (slideWidth + gap) * 2);
        const resetPointLeft = 0;

        if (this.currentPosition <= resetPointRight) {
          this.currentPosition = -(cloneCount * (slideWidth + gap));
          this.track.style.transform = 'translateX(' + this.currentPosition + 'px)';
        } else if (this.currentPosition >= resetPointLeft) {
          this.currentPosition = -(cloneCount * (slideWidth + gap));
          this.track.style.transform = 'translateX(' + this.currentPosition + 'px)';
        }
      }

      disconnectedCallback() {
        if (this.animationFrame) {
          cancelAnimationFrame(this.animationFrame);
        }
        if (this.autoplayInterval) {
          clearInterval(this.autoplayInterval);
        }
      }
    }

    customElements.define('infinite-carousel-{{ ai_gen_id }}', InfiniteCarousel{{ ai_gen_id }});
  })();
</script>

