{% doc %}
  @prompt
    "I need a 2x2 grid layout customizable section for a web page. Please provide Grid that meets the following requirements:
    
    Structure: The section should contain 4 cards arranged in a 2x2 grid.
    on mobile also
    width and max-width of the main section will be customizable
    
    Card Layout: Each card must use flex-direction: row to place an image on the left and text content on the right.
    
    Content: Please incorporate placeholders for the following four items, including an <img> tag and a file input (for image uploads):
    
    Eco-friendly
    
    Hand-crafted
    
    Natural fibers
    
    Fair Trade
    
    Functionality: Each card should include a file input element (<input type="file">) so that I can easily upload or replace the images dynamically.
    
    Responsiveness:
    
    Desktop: Display as a 2x2 grid.
    
    Mobile: Display as a 2x2 grid
    
    Styling: Please include clean, modern CSS to ensure the layout is responsive and the cards are well-spaced."
    
    
    
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-feature-grid-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.section_width }}%;
    max-width: {{ block.settings.section_max_width }}px;
    margin: 0 auto;
    padding: {{ block.settings.section_padding }}px;
  }

  .ai-feature-grid__container-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: {{ block.settings.grid_gap }}px;
  }

  .ai-feature-grid__card-{{ ai_gen_id }} {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: {{ block.settings.card_gap }}px;
    padding: {{ block.settings.card_padding }}px;
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    border: {{ block.settings.card_border_width }}px solid {{ block.settings.card_border_color }};
  }

  .ai-feature-grid__image-wrapper-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: {{ block.settings.image_size }}px;
    height: {{ block.settings.image_size }}px;
    position: relative;
  }

  .ai-feature-grid__image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-feature-grid__placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-feature-grid__placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-feature-grid__content-{{ ai_gen_id }} {
    flex: 1;
    min-width: 0;
  }

  .ai-feature-grid__title-{{ ai_gen_id }} {
    margin: 0;
    font-size: {{ block.settings.title_font_size }}px;
    font-weight: {{ block.settings.title_font_weight }};
    color: {{ block.settings.title_color }};
    line-height: 1.3;
  }

  @media screen and (max-width: 749px) {
    .ai-feature-grid__container-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
      gap: {{ block.settings.mobile_grid_gap }}px;
    }

    .ai-feature-grid__card-{{ ai_gen_id }} {
      padding: {{ block.settings.mobile_card_padding }}px;
      gap: {{ block.settings.mobile_card_gap }}px;
    }

    .ai-feature-grid__image-wrapper-{{ ai_gen_id }} {
      width: {{ block.settings.mobile_image_size }}px;
      height: {{ block.settings.mobile_image_size }}px;
    }

    .ai-feature-grid__title-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_title_font_size }}px;
    }
  }
{% endstyle %}

<feature-grid-{{ ai_gen_id }} class="ai-feature-grid-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-feature-grid__container-{{ ai_gen_id }}">
    {% for i in (1..4) %}
      {% liquid
        assign image_key = 'card_' | append: i | append: '_image'
        assign title_key = 'card_' | append: i | append: '_title'
        assign card_image = block.settings[image_key]
        assign card_title = block.settings[title_key]
      %}
      
      <div class="ai-feature-grid__card-{{ ai_gen_id }}">
        <div class="ai-feature-grid__image-wrapper-{{ ai_gen_id }}">
          {% if card_image %}
            <img
              src="{{ card_image | image_url: width: 200 }}"
              alt="{{ card_title | escape }}"
              class="ai-feature-grid__image-{{ ai_gen_id }}"
              loading="lazy"
              width="200"
              height="200"
            >
          {% else %}
            <div class="ai-feature-grid__placeholder-{{ ai_gen_id }}">
              {{ 'image' | placeholder_svg_tag }}
            </div>
          {% endif %}
        </div>
        <div class="ai-feature-grid__content-{{ ai_gen_id }}">
          {% if card_title != blank %}
            <h3 class="ai-feature-grid__title-{{ ai_gen_id }}">{{ card_title }}</h3>
          {% endif %}
        </div>
      </div>
    {% endfor %}
  </div>
</feature-grid-{{ ai_gen_id }}>

<script>
  (function() {
    class FeatureGrid{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.init();
      }

      init() {
        const cards = this.querySelectorAll('.ai-feature-grid__card-{{ ai_gen_id }}');
        cards.forEach((card, index) => {
          card.setAttribute('data-card-index', index + 1);
        });
      }
    }

    customElements.define('feature-grid-{{ ai_gen_id }}', FeatureGrid{{ ai_gen_id }});
  })();
</script>

