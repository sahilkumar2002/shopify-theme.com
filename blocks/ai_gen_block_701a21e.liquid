{% doc %}
  @prompt
    Create a fully customizable Shopify Online Store 2.0 "Projects Grid" section inspired by the attached reference.
    
    Section layout:
    - Customizable heading
    - Customizable description/paragraph
    - Responsive grid: 3 columns desktop, 2 tablet, 1 mobile
    - Clean, premium and minimal design
    
    For EACH grid item/block, allow me to customize:
    - Image
    - Title/text
    - Shopify Page URL / page picker -it picks the pages selection option from shopify
    - Optional open link in new tab
    - Image aspect ratio
    - Image border radius
    - Image hover effect
    
    I should be able to click "Add Project" and create unlimited grid items. Every item must have completely independent image, text and URL settings.
    
    Section customization:
    - Background color
    - Heading color and size
    - Paragraph color and size
    - Grid columns
    - Grid gap
    - Section width
    - Top/bottom/left/right padding
    - Mobile spacing
    - Text alignment
    
    The image and title of each project should be clickable and open its selected Shopify page.
    
    Use Shopify Liquid + CSS, fully responsive, accessible, and scoped to this section. Do not hardcode any content, images, URLs or colors.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}
.ai-projects-{{ ai_gen_id }}{display:block;width:100%;box-sizing:border-box;background:{{ block.settings.background_color }};padding:{{ block.settings.padding_top }}px {{ block.settings.padding_right }}px {{ block.settings.padding_bottom }}px {{ block.settings.padding_left }}px}
.ai-projects-{{ ai_gen_id }} *{box-sizing:border-box}
.ai-projects-{{ ai_gen_id }}__inner{width:{{ block.settings.desktop_width_percent }}%;max-width:100%;margin:0 auto}
.ai-projects-{{ ai_gen_id }}__intro{text-align:{{ block.settings.text_alignment }};margin-bottom:{{ block.settings.grid_gap }}px}
.ai-projects-{{ ai_gen_id }}__heading{color:{{ block.settings.heading_color }};font-size:{{ block.settings.heading_size }}px;line-height:1.15;margin:0 0 12px}
.ai-projects-{{ ai_gen_id }}__description{color:{{ block.settings.paragraph_color }};font-size:{{ block.settings.paragraph_size }}px;line-height:1.6}
.ai-projects-{{ ai_gen_id }}__description>*{margin:0}
.ai-projects-{{ ai_gen_id }}__grid{display:grid;grid-template-columns:repeat({{ block.settings.columns_desktop }},minmax(0,1fr));gap:{{ block.settings.grid_gap }}px}
.ai-projects-{{ ai_gen_id }}__card{min-width:0;text-align:{{ block.settings.text_alignment }}}
.ai-projects-{{ ai_gen_id }}__media{display:block;overflow:hidden;aspect-ratio:var(--project-ratio);border-radius:var(--project-radius);background:#f0ebe3}
.ai-projects-{{ ai_gen_id }}__media img,.ai-projects-{{ ai_gen_id }}__placeholder svg{display:block;width:100%;height:100%;object-fit:cover}
.ai-projects-{{ ai_gen_id }}__media img{transition:transform .3s ease,filter .3s ease}
{% if block.settings.hover_effect == 'zoom' %}.ai-projects-{{ ai_gen_id }}__card:hover .ai-projects-{{ ai_gen_id }}__media img{transform:scale(1.04)}{% elsif block.settings.hover_effect == 'darken' %}.ai-projects-{{ ai_gen_id }}__card:hover .ai-projects-{{ ai_gen_id }}__media img{filter:brightness(.88)}{% endif %}
.ai-projects-{{ ai_gen_id }}__title{color:{{ block.settings.heading_color }};font-size:18px;line-height:1.35;margin:14px 0 0}
.ai-projects-{{ ai_gen_id }}__link{color:inherit;text-decoration:none}
.ai-projects-{{ ai_gen_id }}__link:hover{text-decoration:underline;text-underline-offset:3px}
.ai-projects-{{ ai_gen_id }}__link:focus-visible{outline:2px solid currentColor;outline-offset:4px}
.ai-projects-{{ ai_gen_id }}__placeholder{position:relative;display:flex;width:100%;height:100%;align-items:center;justify-content:center}
.ai-projects-{{ ai_gen_id }}__placeholder svg{background:#f0ebe3;color:#514a40}
.ai-projects-{{ ai_gen_id }}__empty{position:absolute;bottom:12px;left:8px;right:8px;text-align:center;color:#39352f;font-size:13px}
@media(min-width:750px) and (max-width:989px){.ai-projects-{{ ai_gen_id }}__grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:749px){.ai-projects-{{ ai_gen_id }}{padding:{{ block.settings.mobile_spacing }}px}.ai-projects-{{ ai_gen_id }}__inner{width:100%}.ai-projects-{{ ai_gen_id }}__grid{grid-template-columns:1fr;gap:{{ block.settings.grid_gap | at_least: 8 }}px}.ai-projects-{{ ai_gen_id }}__heading{font-size:{{ block.settings.heading_size | at_most: 36 }}px}}
@media(prefers-reduced-motion:reduce){.ai-projects-{{ ai_gen_id }}__media img{transition:none}}
{% endstyle %}
<div class="ai-projects-{{ ai_gen_id }}" {{ block.shopify_attributes }}><div class="ai-projects-{{ ai_gen_id }}__inner">
{% if block.settings.heading != blank or block.settings.description != blank %}<div class="ai-projects-{{ ai_gen_id }}__intro">{% if block.settings.heading != blank %}<h2 class="ai-projects-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>{% endif %}{% if block.settings.description != blank %}<div class="ai-projects-{{ ai_gen_id }}__description">{{ block.settings.description }}</div>{% endif %}</div>{% endif %}
<div class="ai-projects-{{ ai_gen_id }}__grid">
{% for i in (1..6) %}
{% liquid
assign image_key = 'project_' | append: i | append: '_image'
assign title_key = 'project_' | append: i | append: '_title'
assign page_key = 'project_' | append: i | append: '_page'
assign tab_key = 'project_' | append: i | append: '_new_tab'
assign ratio_key = 'project_' | append: i | append: '_ratio'
assign radius_key = 'project_' | append: i | append: '_radius'
assign project_image = block.settings[image_key]
assign project_title = block.settings[title_key]
assign project_page = block.settings[page_key]
assign project_tab = block.settings[tab_key]
assign project_ratio = block.settings[ratio_key]
assign project_radius = block.settings[radius_key]
if project_title == blank and project_page != blank
assign project_title = project_page.title
endif
%}
{% if project_image != blank or project_title != blank or project_page != blank %}<article class="ai-projects-{{ ai_gen_id }}__card">
{% if project_page != blank %}<a class="ai-projects-{{ ai_gen_id }}__link" href="{{ project_page.url }}" {% if project_tab %}target="_blank" rel="noopener noreferrer"{% endif %} aria-label="{{ project_title | default: 'View project' | escape }}">{% endif %}
<div class="ai-projects-{{ ai_gen_id }}__media" style="--project-ratio:{{ project_ratio }};--project-radius:{{ project_radius }}px">{% if project_image != blank %}<img src="{{ project_image | image_url: width: 1400 }}" alt="{{ project_image.alt | default: project_title | escape }}" loading="lazy" width="{{ project_image.width }}" height="{{ project_image.height }}">{% else %}<div class="ai-projects-{{ ai_gen_id }}__placeholder">{{ 'image' | placeholder_svg_tag }}<span class="ai-projects-{{ ai_gen_id }}__empty">Add an image for this project</span></div>{% endif %}</div>
{% if project_page != blank %}</a>{% endif %}
{% if project_title != blank %}<h3 class="ai-projects-{{ ai_gen_id }}__title">{% if project_page != blank %}<a class="ai-projects-{{ ai_gen_id }}__link" href="{{ project_page.url }}" {% if project_tab %}target="_blank" rel="noopener noreferrer"{% endif %}>{{ project_title | escape }}</a>{% else %}{{ project_title | escape }}{% endif %}</h3>{% endif %}</article>{% endif %}
{% endfor %}
</div></div></div>
