{% doc %}
  @prompt
    make a section of sale ends soon of 48hrs , a one liner row that contains only sale ends soon then timer also make the col0ors spacing and text customizable and responsive, exact section but only change timer 48 hrs 59 min 59sec after timer ends it automatically loops and back to 48hrs
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-sale-countdown-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.padding_top }}px {{ block.settings.padding_horizontal }}px {{ block.settings.padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-sale-countdown-container-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: {{ block.settings.alignment }};
    gap: {{ block.settings.gap }}px;
    flex-wrap: wrap;
  }

  .ai-sale-countdown-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_size }}px;
    color: {{ block.settings.text_color }};
    font-weight: {{ block.settings.text_weight }};
    white-space: nowrap;
  }

  .ai-sale-countdown-timer-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: {{ block.settings.timer_gap }}px;
  }

  .ai-sale-countdown-unit-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: {{ block.settings.unit_gap }}px;
  }

  .ai-sale-countdown-value-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: {{ block.settings.number_width }}px;
    padding: {{ block.settings.number_padding }}px;
    background-color: {{ block.settings.number_bg_color }};
    color: {{ block.settings.number_color }};
    font-size: {{ block.settings.number_size }}px;
    font-weight: {{ block.settings.number_weight }};
    border-radius: {{ block.settings.number_border_radius }}px;
    line-height: 1;
  }

  .ai-sale-countdown-label-{{ ai_gen_id }} {
    font-size: {{ block.settings.label_size }}px;
    color: {{ block.settings.label_color }};
    font-weight: {{ block.settings.label_weight }};
  }

  .ai-sale-countdown-separator-{{ ai_gen_id }} {
    font-size: {{ block.settings.number_size }}px;
    color: {{ block.settings.separator_color }};
    font-weight: {{ block.settings.number_weight }};
    line-height: 1;
  }

  @media screen and (max-width: 749px) {
    .ai-sale-countdown-{{ ai_gen_id }} {
      width: 100%;
      padding: {{ block.settings.mobile_padding_top }}px {{ block.settings.mobile_padding_horizontal }}px {{ block.settings.mobile_padding_bottom }}px;
    }

    .ai-sale-countdown-container-{{ ai_gen_id }} {
      gap: {{ block.settings.mobile_gap }}px;
      justify-content: {{ block.settings.mobile_alignment }};
    }

    .ai-sale-countdown-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_text_size }}px;
    }

    .ai-sale-countdown-timer-{{ ai_gen_id }} {
      gap: {{ block.settings.mobile_timer_gap }}px;
    }

    .ai-sale-countdown-unit-{{ ai_gen_id }} {
      gap: {{ block.settings.mobile_unit_gap }}px;
    }

    .ai-sale-countdown-value-{{ ai_gen_id }} {
      min-width: {{ block.settings.mobile_number_width }}px;
      padding: {{ block.settings.mobile_number_padding }}px;
      font-size: {{ block.settings.mobile_number_size }}px;
    }

    .ai-sale-countdown-label-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_label_size }}px;
    }

    .ai-sale-countdown-separator-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_number_size }}px;
    }
  }
{% endstyle %}

<sale-countdown-{{ ai_gen_id }}
  class="ai-sale-countdown-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-sale-countdown-container-{{ ai_gen_id }}">
    {% if block.settings.text != blank %}
      <div class="ai-sale-countdown-text-{{ ai_gen_id }}">{{ block.settings.text }}</div>
    {% endif %}

    <div class="ai-sale-countdown-timer-{{ ai_gen_id }}" data-timer>
      <div class="ai-sale-countdown-unit-{{ ai_gen_id }}">
        <div class="ai-sale-countdown-value-{{ ai_gen_id }}" data-hours>48</div>
        {% if block.settings.show_labels %}
          <div class="ai-sale-countdown-label-{{ ai_gen_id }}">{{ block.settings.hours_label }}</div>
        {% endif %}
      </div>

      {% if block.settings.show_separator %}
        <div class="ai-sale-countdown-separator-{{ ai_gen_id }}">:</div>
      {% endif %}

      <div class="ai-sale-countdown-unit-{{ ai_gen_id }}">
        <div class="ai-sale-countdown-value-{{ ai_gen_id }}" data-minutes>59</div>
        {% if block.settings.show_labels %}
          <div class="ai-sale-countdown-label-{{ ai_gen_id }}">{{ block.settings.minutes_label }}</div>
        {% endif %}
      </div>

      {% if block.settings.show_separator %}
        <div class="ai-sale-countdown-separator-{{ ai_gen_id }}">:</div>
      {% endif %}

      <div class="ai-sale-countdown-unit-{{ ai_gen_id }}">
        <div class="ai-sale-countdown-value-{{ ai_gen_id }}" data-seconds>59</div>
        {% if block.settings.show_labels %}
          <div class="ai-sale-countdown-label-{{ ai_gen_id }}">{{ block.settings.seconds_label }}</div>
        {% endif %}
      </div>
    </div>
  </div>
</sale-countdown-{{ ai_gen_id }}>

<script>
  (function() {
    class SaleCountdown{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.timerInterval = null;
        // 48 hours, 59 minutes, 59 seconds in seconds = 176,399 seconds
        this.loopDurationSeconds = (48 * 3600) + (59 * 60) + 59; 
      }

      connectedCallback() {
        this.hoursEl = this.querySelector('[data-hours]');
        this.minutesEl = this.querySelector('[data-minutes]');
        this.secondsEl = this.querySelector('[data-seconds]');

        this.updateTimer();
        this.timerInterval = setInterval(() => this.updateTimer(), 1000);
      }

      disconnectedCallback() {
        if (this.timerInterval) {
          clearInterval(this.timerInterval);
        }
      }

      updateTimer() {
        // Get absolute current global time in seconds
        const nowSeconds = Math.floor(Date.now() / 1000);

        // This mathematical modulo operation calculates exactly how far we 
        // currently are inside an endless loop of 176,399-second windows.
        const currentProgress = nowSeconds % this.loopDurationSeconds;
        
        // Subtract progress from total loop window to find remaining seconds
        const remainingSeconds = this.loopDurationSeconds - currentProgress;

        // Break remaining seconds into human-readable time format
        const hours = Math.floor(remainingSeconds / 3600);
        const minutes = Math.floor((remainingSeconds % 3600) / 60);
        const seconds = remainingSeconds % 60;

        // Render seamlessly to the DOM
        if (this.hoursEl) this.hoursEl.textContent = String(hours).padStart(2, '0');
        if (this.minutesEl) this.minutesEl.textContent = String(minutes).padStart(2, '0');
        if (this.secondsEl) this.secondsEl.textContent = String(seconds).padStart(2, '0');
      }
    }

    if (!customElements.get('sale-countdown-{{ ai_gen_id }}')) {
      customElements.define('sale-countdown-{{ ai_gen_id }}', SaleCountdown{{ ai_gen_id }});
    }
  })();
</script>

