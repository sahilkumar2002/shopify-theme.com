 parseInt(countEl.innerText.trim()) || 0;\n\n            let percent = total ? ((count \/ total) * 100).toFixed(0) : 0;\n\n            countEl.innerText = percent + \"%\";\n        });\n    }\n\n    \/\/ Wait for Judge.me to load fully\n    setTimeout(convertToPercentage, 1500);\n\n});\n<\/script>","color_scheme":"","padding_top":40,"padding_bottom":52}}},"order":["main","image_banner_qixEqF","custom_liquid_PqJhi7","1773834582745ad50c","custom_liquid_7Y9HtP"]}