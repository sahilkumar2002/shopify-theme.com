/1;\n  object-fit:cover;\n  border-radius:50%;\n  display:block;\n}\n\n.rug-card h5{\n  margin-top:12px;\n  font-size:18px;\n}\n\n.identify-grid{\n  display:grid;\n  grid-template-columns:repeat(3,1fr);\n  gap:20px;\n  margin-top:20px;\ntext-align:center;\n}\n\n\n\n.identify-card img{\n  display:block;\n  margin-bottom:10px;\n  width:100%;\n}\n\n.identify-grid-benefits{\n  display:grid;\n  grid-template-columns:repeat(3,1fr);\n  gap:30px;\n  margin-top:25px;\n  text-align:center;\n}\n\n.identify-card-n img{\n  width:77px;\n   height:77px;\n  display:block;\n  margin:0 auto 10px;\n}\n\n.identify-card h5{\n  font-size:17px;\n  font-weight:400;\n  margin-bottom:8px;\n}\n\n.identify-card-n h5{\n  font-size:17px;\n  font-weight:400;\n  margin-bottom:8px;\n}\n\n.identify-card p{\n  line-height:1.7;\n}\n\n.rug-buttons{\n  display:flex;\n  gap:15px;\n  align-items:center;\n  justify-content:center;\n  margin-top:30px;\n}\n\n.rug-btn{\n  background:#000;\n  color:#fff;\n  text-decoration:none;\n  padding:6px 12px;\n  display:inline-block;\n}\n\n.rug-btn.secondary{\n  background:#fff;\n  color:#000;\n  border:1px solid #000;\n}\n\n.kpsi-content{\n  display:grid;\n  grid-template-columns:1fr 1fr;\n  margin-top:40px;\n  background:#f5f5f5;\n}\n\n.kpsi-text{\n  padding:40px;\n}\n\n.kpsi-text h2{\n       margin-top: 0px;\n  font-size:20px;\n  margin-bottom:15px;\n    font-weight: 600;\n}\n\n.kpsi-text p{\n  line-height:1.8;\n  margin-bottom:25px;\n}\n\n.kpsi-btn{\n  display:inline-block;\n  background:#000;\n  color:#fff;\n  text-decoration:none;\n   padding:6px 12px;\n}\n\n.kpsi-image img{\n  width:100%;\n  height:100%;\n  object-fit:cover;\n  display:block;\n}\n\nhtml{\n  scroll-behavior:smooth;\n}\n\n\/* MOBILE *\/\n\n@media(max-width:990px){\n\n  .know-rug-section{\n    padding:0 15px;\n  }\n\n  .know-rug-wrapper{\n    flex-direction:column;\n    clamp(0rem, -2.5rem + 8.3333vw, 3.75rem)\n  }\n\n  .know-rug-sidebar,\n  .know-rug-content{\n    width:100%;\n  }\n\n  .know-rug-sidebar{\n    position:relative;\n    top:auto;\n  }\n\n  .know-rug-heading h1{\n    font-size:28px;\n    margin: 0px 0px 15px 0px;\n  }\n\n  .content-block h2{\n    font-size:22px;\n  }\n\n  .rug-card img{\n    max-width:220px;\n    margin:auto;\n  }\n\n  .identify-card{\n    width:100%;\n    text-align:center;\n  }\n\n  .kpsi-text{\n    padding:25px;\n  }\n\n  .kpsi-text h2{\n    font-size:26px;\n  }\n\n  .rug-buttons{\n    gap:10px;\n  }\n\n  .rug-btn{\n    text-align:center;\n  }\n\n}\n\n@media(max-width:480px){\n\n .kpsi-content{\n    display:flex;\n    flex-direction:column-reverse;\n  }\n<\/style>\n\n<section class=\"know-rug-section\">\n\n  <div class=\"know-rug-wrapper\">\n\n    <!-- LEFT SIDEBAR -->\n    <aside class=\"know-rug-sidebar\">\n\n      <div class=\"sidebar-group\">\n        <h3>Weaving Techniques<\/h3>\n\n        <ul>\n          <li><a href=\"hand-knotted\">Hand-Knotted<\/a><\/li>\n          <li><a href=\"hand-tufted\">Hand-Tufted<\/a><\/li>\n          <li><a href=\"hand-loom\">Hand-Loom<\/a><\/li>\n          <li><a href=\"flat-weave\">Flat-Weave<\/a><\/li>\n        <\/ul>\n      <\/div>\n\n      <div class=\"sidebar-group\">\n        <h3>Fibers & Material<\/h3>\n\n        <ul>\n          <li><a href=\"wool\">Wool<\/a><\/li>\n          <li><a href=\"silk\">Silk<\/a><\/li>\n          <li><a href=\"Viscose\">Bamboo Silk\/Viscose<\/a><\/li>\n        <\/ul>\n      <\/div>\n\n    <\/aside>\n\n    <!-- RIGHT CONTENT -->\n    <div class=\"know-rug-content\">\n\n      <div class=\"know-rug-heading\">\n        <h1 id=\"hand-knotted\">Hand-Knotted<\/h1>\n      <\/div>\n<div class=\"content-block\">\n        <h2>The Weaving Process<\/h2>\n\n        <p>\n          Hand-knotting found its way into Indian heritage from Persia, giving it its name, Persian Hand-knotting. It’s uniqueness in art is through its style of printing; knot by knot and line by line, paying attention to each intricate detail. It’s a process taking a minimum of 2 months, ranging up to almost a year depending on the quality and size of carpet being woven.\n        <\/p>\n      <\/div>\n\n      <div class=\"hero-image\">\n        <img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0648\/2188\/7176\/files\/GENERATE_A_BANNER_OF_THIS_202606171651_1.jpg?v=1781695397\">\n      <\/div>\n\n      <p>\n        Differentiating each knot was originally done by memory, where weavers would sing out the colors of the line of knots called Boli weaving. This later evolved to the use of design maps, which helped accommodate a rapidly changing design palate. Artisans place the design map at the base of the loom and use each pixel in a chart as a reference to a knot. Artisans with Jaipur Rugs are also a part of a unique sustainable initiative called Manchaha, where they get to design their own rugs at the loom.\n        <\/p>\n\n     \n      <div class=\"content-block\">\n        <h2>The Rug<\/h2>\n\n        <div class=\"rug-grid\">\n\n          <div class=\"rug-card\">\n            <img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0648\/2188\/7176\/files\/GENERATE_A_BANNER_OF_THIS_202606171610.jpg?v=1781692827\">\n   \n          <\/div>\n\n          <div class=\"rug-card\">\n            <img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0648\/2188\/7176\/files\/GENERATE_A_BANNER_OF_THIS_202606171610.jpg?v=1781692827\">\n          <\/div>\n\n          <div class=\"rug-card\">\n            <img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0648\/2188\/7176\/files\/GENERATE_A_BANNER_OF_THIS_202606171610.jpg?v=1781692827\">\n          <\/div>\n\n        <\/div>\n\n      <\/div>\n\n      <div class=\"content-block\">\n\n        <h2>How To Identify?<\/h2>\n\n        <p>\n          Individual, often uneven knots are visible on the back of these rugs, mirroring the pattern visible on the front. A more intricate design will have a higher density of knots at the back, the quality is measured in KPSI (Knots per square inch).\n        <\/p>\n\n        <div class=\"identify-grid\">\n\n          <div class=\"identify-card\">\n            <img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0648\/2188\/7176\/files\/GENERATE_A_BANNER_OF_THIS_202606171610.jpg?v=1781692827\">\n            <h5>Pile Height<\/h5>\n            <p>Low to Medium. Comfortable to walk on.<\/p>\n          <\/div>\n\n          <div class=\"identify-card\">\n            <img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0648\/2188\/7176\/files\/GENERATE_A_BANNER_OF_THIS_202606171610.jpg?v=1781692827\">\n            <h5>Durability & Intricacy<\/h5>\n            <p>Product life of 30+ years. High design intricacy.<\/p>\n          <\/div>\n\n          <div class=\"identify-card\">\n            <img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0648\/2188\/7176\/files\/GENERATE_A_BANNER_OF_THIS_202606171610.jpg?v=1781692827\">\n            <h5>Weaving Technique<\/h5>\n            <p>Yarn is knotted on warp thread. Extremely intricate, durable and valuable.<\/p>\n          <\/div>\n\n        <\/div>\n\n      <\/div>\n\n      <div class=\"content-block\">\n\n        <div class=\"identify-grid-benefits\">\n\n          <div class=\"identify-card-n\">\n            <img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0648\/2188\/7176\/files\/ideal-space-icon.png?v=1781786070\">\n            <h5>Ideal space<\/h5>\n            <p>Any high traffic areas for example, the living room.<\/p>\n          <\/div>\n\n          <div class=\"identify-card-n\">\n            <img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0648\/2188\/7176\/files\/ideal-space-icon.png?v=1781786070\">\n            <h5>Pros<\/h5>\n            <p>Great durability, minimal shedding and a prestige to own, world-over.<\/p>\n          <\/div>\n\n          <div class=\"identify-card-n\">\n            <img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0648\/2188\/7176\/files\/ideal-space-icon.png?v=1781786070\">\n            <h5>Cons<\/h5>\n            <p>Only downside is that it’s a little heavy on the pocket.<\/p>\n          <\/div>\n\n        <\/div>\n\n        <div class=\"rug-buttons\">\n          <a href=\"#\" class=\"rug-btn\">Shop Now<\/a>\n          <a href=\"#\" class=\"rug-btn secondary\">Rug Care<\/a>\n        <\/div>\n\n      <\/div>\n\n      <div class=\"kpsi-content\">\n\n        <div class=\"kpsi-text\">\n\n          <h2>Knots per square inch (KPSI)<\/h2>\n\n          <p>\n            KPSI is a factor in determining the quality of hand-knotted rugs. Each knot is in comparison to a pixel; the more pixels in a given area, the clearer the image.\n          <\/p>\n\n          <a href=\"#\" class=\"kpsi-btn\">\n            Learn More\n          <\/a>\n\n        <\/div>\n\n        <div class=\"kpsi-image\">\n          <img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0648\/2188\/7176\/files\/GENERATE_A_BANNER_OF_THIS_202606171610.jpg?v=1781692827\">\n        <\/div>\n\n      <\/div>\n\n    <\/div>\n\n  <\/div>\n\n<\/section>","color_scheme":"","padding_top":40,"padding_bottom":52}}},"order":["main","image_banner_yM9aXM","custom_liquid_ehC3aN"]}