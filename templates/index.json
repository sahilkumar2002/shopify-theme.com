settings":{"title":"Rugs by Size","heading_size":"h1","image_ratio":"adapt","columns_desktop":5,"color_scheme":"","show_view_all":false,"columns_mobile":"1","swipe_on_mobile":false,"padding_top":36,"padding_bottom":36}},"featured_collection_XFJ7f9":{"type":"featured-collection","custom_css":["h2 {text-align: center;}"],"settings":{"title":"Best Seller","heading_size":"h1","description":"","show_description":true,"description_style":"body","collection":"best-seller","products_to_show":12,"columns_desktop":4,"full_width":false,"show_view_all":false,"view_all_style":"solid","enable_desktop_slider":false,"color_scheme":"","image_ratio":"adapt","image_shape":"default","show_secondary_image":true,"show_vendor":false,"show_rating":false,"enable_quick_add":false,"columns_mobile":"2","swipe_on_mobile":false,"padding_top":36,"padding_bottom":36}},"rich_text_Gch6VH":{"type":"rich-text","blocks":{"heading_RQt3xh":{"type":"heading","settings":{"heading":"About handmade rugs from Indian Rug Store","heading_size":"h2"}},"text_78qcmW":{"type":"text","settings":{"text":"<p>Since its establishment in 1990, Indian Rug Store has been transforming the rug shopping experience. As pioneers in online rug retailing, we've dedicated ourselves to providing exquisitely designed rugs at prices that suit every budget. With over 25 years of expertise, major publications endorse Indian Rug Store as the go-to destination for quality rugs.<\/p><h3><\/h3><p>Our commitment to enhancing your home curating journey remains unwavering, evidenced by:<\/p><ul><li>A diverse and expansive collection of beautifully crafted rugs<\/li><li>Unbeatable pricing<\/li><li>Swift, complimentary carbon offset shipping<\/li><li>Cutting-edge tools enabling you to visualize rugs in your home<\/li><li>Informative, carefully curated content on our blog and social media platforms<\/li><li>And much more!<\/li><\/ul><p>No matter your aesthetic preferences or requirements, Indian Rug Store guarantees a rug that resonates with you. Rest assured, all our rugs are crafted in-house, reflecting our dedication to superior quality and expertise. From relaxed, natural fiber rugs to vintage-inspired designs and family-friendly, machine-washable options, our vast selection ensures there's something for everyone. With our hassle-free 30-day return policy and prompt, free shipping, bringing home the perfect rug has never been easier.<\/p><p>For 25 years, customers have relied on us as their trusted rug authority, and we're excited to continue serving them (and you!) for years to come. When you're seeking to anchor your space in elegance, look no further than Indian Rug Store. <a href=\"\/pages\/about-us\" target=\"_blank\" title=\"About Us\"><strong>Read More<\/strong><\/a><\/p>"}}},"block_order":["heading_RQt3xh","text_78qcmW"],"custom_css":["h2 {margin-bottom: 10px;}"],"settings":{"desktop_content_position":"center","content_alignment":"center","heading_alignment":"center","color_scheme":"","full_width":false,"padding_top":40,"padding_bottom":0}},"1714553737682019b0":{"type":"apps","blocks":{"forms_inline_VN8hLC":{"type":"shopify:\/\/apps\/forms\/blocks\/inline\/8744a304-fcb1-4347-b211-bb6b4759a76a","settings":{"form_id":"98300","text_color":"#ffffff","button_background_color":"#565454","button_label_color":"#ffffff","links_color":"#1878b9","errors_color":"#e02229","text_alignment":"center","form_alignment":"center","padding_top":30,"padding_bottom":30,"padding_right":0,"padding_left":0}}},"block_order":["forms_inline_VN8hLC"],"custom_css":["{background: #121212; margin-bottom: 0px; margin-top: 20px;}"],"settings":{"include_margins":true}}},"order":["1779795642394db4e2","image_banner","custom_liquid_CLQMzf","slideshow_WBEQh7","image_with_text_WMkTgg","rich_text_xNXaWg","collection_list_M7L4Yg","collection_list_8fJXPa","featured_collection_XFJ7f9","rich_text_Gch6VH","1714553737682019b0"]}