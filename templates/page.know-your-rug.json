lock;\n  aspect-ratio:4\/3;\n  object-fit:cover;\n}\n\n.weaving-card h4{\n  margin-top:15px;\n  font-size:16px;\n}\n\n\/* MATERIAL SECTION *\/\n.material-section{\n  margin-top:40px;\n}\n\n.material-section h2{\n  text-align:center;\n  font-size:32px;\n}\n\n.material-grid{\n  display:grid;\n  grid-template-columns:repeat(5,1fr);\n  gap:10px;\n}\n\n.material-item{\n  text-decoration:none;\n  color:#000;\n  text-align:center;\n}\n\n.material-item img{\n  width:90px;\n  height:90px;\n  object-fit:contain;\n  margin:auto;\n  display:block;\n}\n\n.material-item p{\n  margin-top:15px;\n  font-size:16px;\n}\n\n\/* SMOOTH SCROLL *\/\nhtml{\n  scroll-behavior:smooth;\n}\n\n\/* MOBILE *\/\n@media(max-width:990px){\n\n  .know-rug-wrapper{\n    flex-direction:column;\n  }\n\n  .know-rug-sidebar,\n  .know-rug-content{\n    width:100%;\n  }\n\n  .know-rug-sidebar{\n    position:relative;\n    top:auto;\n  }\n\n  .weaving-grid{\n    grid-template-columns:1fr;\n  }\n\n  .material-grid{\n    grid-template-columns:repeat(2,1fr);\n  }\n\n  .know-rug-heading h1{\n    font-size:36px;\n  }\n\n  .material-section h2{\n    font-size:32px;\n margin-bottom:25px;\n  }\n}\n<\/style>\n\n<section class=\"know-rug-section\">\n\n  <div class=\"know-rug-wrapper\">\n\n   <!-- LEFT STICKY SIDEBAR -->\n    <aside class=\"know-rug-sidebar\">\n\n      <div class=\"sidebar-group\">\n        <h3>Weaving Techniques<\/h3>\n\n        <ul>\n          <li><a href=\"hand-knotted\">Hand-Knotted<\/a><\/li>\n          <li><a href=\"hand-tufted\">Hand-Tufted<\/a><\/li>\n          <li><a href=\"hand-loom\">Hand-Loom<\/a><\/li>\n          <li><a href=\"flat-weave\">Flat-Weave<\/a><\/li>\n        <\/ul>\n      <\/div>\n\n      <div class=\"sidebar-group\">\n        <h3>Fibers & Material<\/h3>\n\n        <ul>\n          <li><a href=\"wool\">Wool<\/a><\/li>\n          <li><a href=\"silk\">Silk<\/a><\/li>\n          <li><a href=\"Viscose\">Bamboo Silk\/Viscose<\/a><\/li>\n        <\/ul>\n      <\/div>\n\n    <\/aside>\n\n    <!-- RIGHT CONTENT -->\n    <div class=\"know-rug-content\">\n\n      <div class=\"know-rug-heading\">\n        <h1>Know Your Rug<\/h1>\n      <\/div>\n\n      <div class=\"know-rug-text\">\n        <p>\n          A rug is more than just a floor covering—it's a statement piece that brings warmth, style, and personality to your home. Choosing the right rug starts with understanding the craftsmanship, materials, and techniques that go into creating it. A well-made rug should not only enhance your décor but also offer lasting durability and comfort. <\/p>\n<p>At Indian Rug Store, we take pride in preserving the timeless art of handmade rug weaving. Our collection features beautifully crafted rugs made by skilled artisans across India, blending traditional techniques with contemporary designs. Each rug is thoughtfully handcrafted, carrying its own unique character and story. Explore our range of weaving styles, materials, and craftsmanship to discover the perfect rug that complements your space and reflects your personal style.\n        <\/p>\n      <\/div>\n\n      <!-- 2X2 WEAVING GRID -->\n      <div class=\"weaving-grid\">\n\n        <div class=\"weaving-card\" id=\"hand-knotted\">\n          <img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0648\/2188\/7176\/files\/GENERATE_A_BANNER_OF_THIS_202606171601.jpg?v=1781692408\">\n          <h4>Hand-Knotted<\/h4>\n        <\/div>\n\n        <div class=\"weaving-card\" id=\"hand-tufted\">\n          <img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0648\/2188\/7176\/files\/GENERATE_A_BANNER_OF_THIS_202606171602.jpg?v=1781692434\">\n          <h4>Hand-Tufted<\/h4>\n        <\/div>\n\n        <div class=\"weaving-card\" id=\"hand-loom\">\n          <img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0648\/2188\/7176\/files\/GENERATE_A_BANNER_OF_THIS_202606171606.jpg?v=1781692657\">\n          <h4>Hand-Loom<\/h4>\n        <\/div>\n\n        <div class=\"weaving-card\" id=\"flat-weave\">\n          <img src=\"https:\/\/c